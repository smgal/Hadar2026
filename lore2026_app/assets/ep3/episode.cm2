####### 제3부 「비전 속으로」 — 편 전체의 일 (episode) ########
# 근거: 기획서 05 §5.5(반역 루트)·§5.9(예언) · 12 §12.4 · 13 §13.7·§13.9·§13.10 · 14 §1-1·§11(에필로그)·§12·§14 ·
#       15 부록 A #27·#32·#42·#43 · 16 부록 B(새 게임 초기값·B.4)
# 맵과 무관하게 불린다: FLAG_OPENING(편을 고른 직후, 캐릭터 생성 전) · FLAG_START(캐릭터를 만든 직후) ·
# FLAG_PROPHECY(초능력 「예언」) · FLAG_TIMER(예약한 시각).
#
# ─────────────────────────────────────────────────────────────────────────────
#  예약 번호 (Timer::Id) — 맵 스크립트는 Timer::Set(번호, 분) 으로 부른다
# ─────────────────────────────────────────────────────────────────────────────
#  반역 루트의 연쇄 (05 §5.5)
#    1  에인션트 이블의 급보 → 하데스 게이트 (25,10) · 크로매틱 크리스탈
#         Light.cm2 가 「로드안을 배신한다」를 고른 직후 Timer::Set(1, 10)
#    2  도시 건설 — 빈 터가 빈 도시가 된다
#         UnderGrd.cm2 가 (46,48) 에서 크로매틱 크리스탈을 쓴 직후 Timer::Set(2, 20)
#         (그때 변수 DOME_STAGE 를 1 로 두고 빛의 지붕 (25,50) 으로 옮겨 둔다)
#    3  주민 이주 — 2번이 스스로 Timer::Set(3, 30). REFUGE_BUILT 가 켜진다
#    4  옛 동료들과의 재회
#         Dome.cm2 가 도시 가장자리로 나설 때(로어 대륙 (80,80) 으로 보내기 직전) Timer::Set(4, 90)
#    5  로드안군의 포위 · 13연전 — 4번이 스스로 Timer::Set(5, 30)
#         전부 이기면 Lore.cm2 의 즉위식(LORE_CORONATION) → 엔딩 B, 한 번이라도 지면 795년 로어 대륙 (58,79)
#  엔딩 — 엔딩을 일으킨 스크립트가 Timer::Set(번호, 0) 을 하고 halt 한다
#   11  엔딩 A 「네크로만서의 탄생」   Dome.cm2 (에필로그 장면의 끝. Lore.cm2 의 단계 11 로드안 →
#                                      LoadScript("E3_UnderGrd", 31, 21) → UnderGrd.cm2 → Dome.cm2 가 잇는다)
#   12  엔딩 B 「새로운 로드안」       Lore.cm2 (즉위식)
#   13  엔딩 C 「떠나는 자」           Dark.cm2 (795년 로드안과의 2연전 승리)
#
#  크리스탈 볼은 예약하지 않는다. 원작은 「지금 시각」으로 예약해 다음 한 걸음 뒤에 판정했지만(부록 A #27)
#  의도된 사양은 그 자리에서 곧바로이므로, 필드 맵의 FLAG_ITEM 이 직접 처리한다 (Ground1~Ground4).
#
#  이 파일이 다른 맵과 함께 쓰는, 부록 B 에 없는 이름
#    DOME_STAGE        변수. 빛의 지붕의 건설 단계: 1 빈 터 · 2 빈 도시 · 3 주민 이주 (Dome.cm2 의 FLAG_MAP 이 읽는다)
#    LORE_CORONATION   플래그. 13연전에서 이겼다 → Lore.cm2 의 FLAG_MAP 이 즉위식을 연다
# ─────────────────────────────────────────────────────────────────────────────
#
# 조건에 인자 없는 함수 하나만 쓰면 엔진이 부르지 않고 늘 참으로 본다 — 그런 자리는 And(...) 로 감싼다.

include("common/const.cm2")
variable(zone)
variable(stage)
variable(lost)
variable(mode)

####### 오프닝 — 타임워커 알비레오의 편지 (편을 고른 직후, 캐릭터 생성 전) ########
# 주인공이 아직 없다 — {주인공} 을 쓰지 않는다. 원작은 제목 화면에서 위로 흘려 보낸다 (13 §13.7)

if (Equal(ScriptMode(), FLAG_OPENING))
	# 알비레오의 편지가 아래에서 위로 흐른다 — 키를 누르면 끝으로 건너뛴다 (13 §13.7)
	Letter::Clear()
	Letter::Add("오래전부터 만날 운명이었던 당신에게.")
	Letter::Add("나는 시공의 여행자인 타임워커 알비레오라고 하오. 내가 로어 세계가 있는 공간으로 접어들었을 때 마침 이 세계는 로드안의 통치에 있었소. 그때 내가 그대들에게 닥쳐올 불확실한 미래를 나의 다섯 가지 예언으로 계시해 주었던 것을 기억할 거요. 그리고 그 예언이 너무나도 큰 희생을 강요했던 것도 기억하고 있을 거라 믿소. 나는 세상을 구하기 위해 자신을 희생해야만 했던 그를 이해하오. 또한 숙명의 적이었던 네크로만서와 불멸의 다크메이지 실리안 카미너스 역시 나는 용서할 수 있었소. 하지만 그들을 용서하는 데에는 대단한 용기를 감수해야만 했다오. 그들의 진심을 이해하기 위해 나는 서둘러 로어 세계의 과거로 도약을 시작했고 거기서 내가 보았던 것은 네크로만서와 다크메이지의 계획된 탄생이었소. 내가 그 계기로 진정한 이 세계의 진실을 알게 되었을 때, 나 스스로가 이 세계에 대한 경멸로 마음을 닫아 버렸소. 그래서 나를 이해할 수 있을 것 같은 당신에게 이렇게 도움을 청하는 거요. 당신이 네크로만서와 다크메이지를 완전히 소멸시키는 그날, 이 세계는 다시 원래의 운명의 궤도로 접어들게 되고 나는 그때야 비로소 다른 공간으로의 여행을 다시 시작하게 될 거요.")
	Letter::Add("— 타임워커 알비레오로부터")
	Letter::Show(15, LETTER_SCROLL)

####### 새 게임 (캐릭터를 만든 직후) ########
# 부록 B 「새 게임 초기값」: 673년 11월 27일 16:00, 메너스 금광 (27,29), 대원 1번만, 식량·금화·화살·물품 0,
# 모든 플래그 꺼짐 · 모든 변수 0 (엔진이 새 판을 그렇게 연다), 횃불 4.
# 프롤로그 전용 배치(광부 4명 제거 · 감독을 (27,32) 에)와 게임 시작 문구는 Menace.cm2 의 FLAG_MAP 이 맡는다.

if (Equal(ScriptMode(), FLAG_START))
	Time::Set(673, 11, 27, 16, 0)
	Variable::Set("MAIN_STAGE", 0)
	Variable::Set("ALLEGIANCE", 0)
	Variable::Set("GAEA_QUEST", 0)
	Variable::Set("SPIRITS_SEALED", 0)
	Party::SetTorch(4)
	LoadScript("E3_Menace", 27, 29)

####### 예언 — 「당신은 ○○ 것이다」 (05 §5.9, 위에서부터 먼저 맞는 것) ########

if (Equal(ScriptMode(), FLAG_PROPHECY))
	stage.assign(Variable::Get("MAIN_STAGE"))
	# zone: 지금 있는 맵. 1 가이아 테라성 · 2 가이아 테라(필드) · 3 배리언트 피플즈성 · 4 오크 마을 ·
	#       5 아프로디테 테라(필드) · 6 베스퍼성 · 7 트롤 마을 · 8 이쉬도 테라(필드) · 9 우라누스 테라(필드) · 10 하데스 테라
	zone.assign(0)
	if (Map::Is("E3_Gaea"))
		zone.assign(1)
	if (Map::Is("E3_Ground2"))
		zone.assign(2)
	if (Map::Is("E3_Valiant"))
		zone.assign(3)
	if (Map::Is("E3_OrcTown"))
		zone.assign(4)
	if (Map::Is("E3_Ground3"))
		zone.assign(5)
	if (Map::Is("E3_Vesper"))
		zone.assign(6)
	if (Map::Is("E3_TrolTown"))
		zone.assign(7)
	if (Map::Is("E3_Ground4"))
		zone.assign(8)
	if (Map::Is("E3_Ground5"))
		zone.assign(9)
	if (Map::Is("E3_UnderGrd"))
		zone.assign(10)

	# ---- 반역 루트 ----
	if (Equal(Variable::Get("ALLEGIANCE"), 2))
		if (Greater(Time::Year(), 699))
			Talk("당신은 로어성에서 로드안과 최후의 결전을 벌일 것이다")
			halt
		if (Flag::IsSet("COMPANIONS_REUNITED"))
			Talk("당신은 로어성의 궁사들과 결전을 벌일 것이다")
			halt
		# 원작에서 이 기록을 켜는 곳이 없어 나오지 않는 문장이다 (부록 A.2)
		if (Flag::IsSet("COMPANIONS_MET"))
			Talk("당신은 헤어졌던 동료를 만날 것이다")
			halt
		if (Flag::IsSet("REFUGE_BUILT"))
			Talk("당신은 에인션트 이블의 도움을 받은 뒤 다시 로어 대륙으로 나갈 것이다")
			halt
		if (Equal(zone, 10))
			Talk("당신은 투시를 통해서 어떤 장소를 발견할 것이다")
			halt
		Talk("당신은 하데스 게이트를 통해서 하데스 테라로 갈 것이다")
		halt

	# ---- 충성 루트 ----
	if (Equal(stage, 9))
		Talk("당신은 다시 로드안을 만날 것이다")
		halt
	if (Equal(stage, 10))
		if (Equal(Variable::Get("SPIRITS_SEALED"), 0))
			Talk("당신은 가이아 테라에 있는 오크의 원혼을 봉인할 것이다")
			halt
		if (Equal(Variable::Get("SPIRITS_SEALED"), 1))
			Talk("당신은 아프로디테 테라에 있는 트롤의 원혼을 봉인할 것이다")
			halt
		if (Equal(Variable::Get("SPIRITS_SEALED"), 2))
			Talk("당신은 이쉬도 테라에 있는 코볼트의 원혼을 봉인할 것이다")
			halt
		if (Equal(Variable::Get("SPIRITS_SEALED"), 3))
			Talk("당신은 로어 대륙에 있는 드라코니안의 원혼을 봉인할 것이다")
			halt
	if (Equal(stage, 11))
		Talk("당신은 로드안에게 돌아갈 것이다")
		halt

	# ---- 단계 0: 살인 누명 전(673년) / 수감 중 (원작은 수감 중에도 앞 문장이 나왔다 — 부록 A #32) ----
	if (Equal(stage, 0))
		if (Equal(Time::Year(), 673))
			Talk("당신은 메너스 광산을 나갈 것이다")
		else
			Talk("당신은 로드안에게 불려갈 것이다")
		halt

	# ---- 단계 2 ----
	if (Equal(stage, 2))
		Talk("당신은 로드안과 계속 이야기할 것이다")
		halt

	# ---- 단계 3: 가이아 성주의 의뢰 단계별 ----
	if (Equal(stage, 3))
		if (Equal(Variable::Get("GAEA_QUEST"), 0))
			if (Equal(zone, 1))
				Talk("당신은 가이아 테라성의 성주에게 부탁을 받을 것이다")
			else
				Talk("당신은 가이아 테라로 갈 것이다")
			halt
		if (Equal(Variable::Get("GAEA_QUEST"), 1))
			Talk("당신은 오크 마을을 점령할 것이다")
			halt
		if (Equal(Variable::Get("GAEA_QUEST"), 2))
			Talk("당신은 가이아 테라성의 성주를 다시 만날 것이다")
			halt
		if (Equal(Variable::Get("GAEA_QUEST"), 3))
			if (Flag::IsSet("TROLL_KING_DEAD"))
				Talk("당신은 로드안에게 돌아갈 것이다")
				halt
			if (Flag::IsSet("VESPER_CAPTAIN_DEAD"))
				Talk("당신은 베스퍼성 북동쪽의 트롤 마을을 점령할 것이다")
				halt
			if (Or(Equal(zone, 5), Equal(zone, 6), Equal(zone, 7)))
				Talk("당신은 대륙의 중앙에 있는 베스퍼성을 점령할 것이다")
				halt
			Talk("당신은 아프로디테 테라로 갈 것이다")
			halt

	# ---- 단계 4~6 ----
	if (And(GreaterEqual(stage, 4), LessEqual(stage, 6)))
		if (Flag::IsSet("DRACONIAN_DESTROYED"))
			Talk("당신은 대륙의 서쪽에 있는 임페리엄 마이너성에서 에인션트 이블을 만날 것이다")
			halt
		if (Equal(zone, 9))
			Talk("당신은 드라코니안성을 점령할 것이다")
			halt
		if (Flag::IsSet("KOBOLD_SEALED"))
			if (Equal(zone, 2))
				Talk("당신은 배리언트 피플즈의 성주를 만나 우라누스 테라로 갈 것이다")
			else
				Talk("당신은 가이아 테라로 돌아갈 것이다")
			halt
		if (Equal(zone, 8))
			Talk("당신은 대륙 북동쪽에 있는 코볼트 마을을 점령할 것이다")
			halt
		if (Equal(zone, 1))
			Talk("당신은 가이아 테라성 북쪽에 있는 게이트를 통해 이쉬도 테라로 갈 것이다")
			halt
		if (Or(Equal(zone, 2), Equal(zone, 3), Equal(zone, 4)))
			Talk("당신은 가이아 테라성의 성주를 다시 만날 것이다")
			halt
		if (Equal(stage, 5))
			Talk("당신은 로드안과 계속 이야기할 것이다")
			halt
		if (Equal(stage, 4))
			Talk("당신은 로드안에게 돌아갈 것이다")
			halt
		Talk("당신은 가이아 테라로 다시 갈 것이다")
		halt

	# ---- 단계 7 · 8 ----
	if (Equal(stage, 7))
		Talk("당신은 다시 로드안을 만날 것이다")
		halt
	if (Equal(stage, 8))
		Talk("당신은 배리언트 피플즈의 반란을 진압하러 갈 것이다")
		halt

	# 해당하는 문장이 없다
	Talk("당신은 어떤 힘에 의해 예언을 방해받고 있다")

####### 예약한 사건 ########

if (Equal(ScriptMode(), FLAG_TIMER))

	# ════ 1 — 에인션트 이블의 급보 (배신 10분 뒤). 어느 맵에 있든 하데스 게이트 (25,10) 로 옮겨진다 ════
	if (Equal(Timer::Id(), 1))
		Talk("갑자기 허공 속에서 에인션트 이블의 음성이 들려왔다.")
		Say("에인션트 이블", "{주인공}, 정말 급한 일이 생겼습니다.")
		Say("에인션트 이블", "방금 당신이 로드안에 대해 반란을 결심한 것을 로드안이 알아챘습니다. 아마 그는 천리안과 독심으로 당신을 계속 관찰했던 것 같습니다. 지금 로어성에서는 당신과 배리언트 피플즈의 사람들을 제거할 용사들을 모으기 시작했습니다. 그리고 적어도 며칠 후면 이곳으로 진격한다고 합니다. 당신의 능력이라면 충분히 자신을 방어할 수 있겠지만 모든 배리언트 피플즈의 사람들을 보호해 주기란 역부족일 것입니다. 그래서 한시바삐 이곳 사람들을 안전한 곳으로 이동시켜 주었으면 합니다. 당신은 그들이 살기 좋을 만하고 절대로 로드안의 투시 능력이 미치지 않을 곳을 찾아 주십시오. 그리고 그 위치를 알려 주시면 나머지는 제가 담당하겠습니다.")
		PressAnyKey()
		# 하데스 게이트로 순간 이동 — 크로매틱 크리스탈을 받는다. 도착한 뒤에 듣는 말은 Arrival::Say 로 쌓아 둔다
		# (HdsGate.cm2 의 FLAG_MAP 에도 같은 말이 「반역 루트인데 크리스탈이 없을 때」 조건으로 있다 — 여기서
		#  크리스탈을 먼저 주므로 그쪽은 돌지 않는다)
		Item::Give("crystal.chromatic", 1)
		Arrival::Say("에인션트 이블", "지금 당신이 서 있는 곳은 '하데스 게이트'라는 곳입니다. 이곳은 로어 세계의 6번째 테라인 하데스 테라로 이동하는 문이 있는 곳이기도 합니다. 하데스 테라는 로어 대륙의 지하에 있으며 로드안과 나의 투시 능력이 전혀 통하지 못하는 곳입니다. 당신은 이곳을 통해 하데스 테라로 간 후 배리언트 피플즈의 주민들이 안전하게 살 수 있는 곳을 찾아내면 되는 것입니다. 아마 당신의 투시 능력이 큰 도움을 줄 것입니다. 제가 당신에게 @B크로매틱 크리스탈@@을 드리겠습니다. 당신이 가장 좋은 장소를 찾았을 때 이 크리스탈을 사용하십시오. 그러면 저의 투시력과 그 크리스탈이 서로 교감하여 나의 투시력이 그곳으로 작용할 것입니다.")
		Arrival::Say("에인션트 이블", "당신의 성공을 빌겠습니다.")
		LoadScript("E3_HdsGate", 25, 10)

	# ════ 2 — 도시 건설 (크로매틱 크리스탈을 쓰고 20분 뒤). 빈 터 → 빈 도시, (25,50) ════
	if (Equal(Timer::Id(), 2))
		Variable::Set("DOME_STAGE", 2)
		# 다시 30분 뒤 주민 이주
		Timer::Set(3, 30)
		# 세워진 도시에 서서 듣는다
		Arrival::Say("에인션트 이블", "휴... 저의 염력을 총동원하여 어느 정도 사람이 살 수 있는 도시를 건설해 보았습니다. 이제는 배리언트 피플즈의 사람들을 여기로 공간 이동시켜 보겠습니다. 이번에도 조금 기다려야 할 것입니다.")
		LoadScript("E3_Dome", 25, 50)

	# ════ 3 — 주민 이주 (다시 30분 뒤). 서 있던 자리 그대로 주민들이 나타난다 ════
	if (Equal(Timer::Id(), 3))
		Flag::Set("REFUGE_BUILT")
		Variable::Set("DOME_STAGE", 3)
		# 주민들이 나타난 도시에 서서 듣는다
		Arrival::Say("에인션트 이블", "이곳으로 오기 원하는 모든 배리언트 피플즈의 사람들을 이곳으로 불렀습니다. 여기의 사람들과 이야기를 나눈 후 성 밖으로 나올 때 당신을 지상 세계로 이동시켜 주겠습니다. 좋은 이야기 많이 나누시기 바랍니다.")
		LoadScript("E3_Dome", Party::PosX(), Party::PosY())

	# ════ 4 — 옛 동료들과의 재회 (빛의 지붕을 나서고 90분 뒤) ════
	if (Equal(Timer::Id(), 4))
		Talk("당신이 길을 가던 중 당신의 동료였던 그 사람들을 만나게 되었다.")
		Say("옛 동료", "드디어 만났군, {주인공}.")
		Say("옛 동료", "로드안을 배신하겠다는 자네의 생각이 옳았다네. 우리가 자네와 헤어진 후 로드안에게 갔을 때 로드안은 우리에게 멸망당한 네 종족의 원혼을 봉인하는 일을 시켰다네. 우리는 쾌히 승낙하며 그 일을 해 주었지. 하지만 우리의 도움이 더 이상 필요 없게 되자 로드안은 그 자신을 위해 우리의 동료였던 카노푸스를 악의 전사 네크로만서로 개조하여 다른 차원으로 보내 버렸다네. 우리는 그 사실을 알아채자 로어성을 탈출하여 자네를 찾아 여기까지 왔다네. 자네와 다시 합류하여 로드안과 싸우고 싶네.")
		Select::Init()
		Select::Add("")
		Select::Add("쾌히 승낙하겠네")
		Select::Add("하지만 이미 늦었네")
		Select::Run()
		if (Equal(Select::Result(), 1))
			# 배신 때 숨겨 둔 2~5번 동료가 돌아온다 (능력치·장비는 그때 그대로 — 부록 B.4)
			Party::RestoreCompanions()
			DisplayStatus()
			Flag::Set("COMPANIONS_REUNITED")
		# 어느 쪽이든 30분 뒤 로드안군의 포위
		Timer::Set(5, 30)

	# ════ 5 — 로드안군의 포위 · 13연전 (재회 30분 뒤) ════
	# 12 §12.4: ①~⑤ 로어성 병사 8 / ⑥~⑨ 병사 6·로어 마법사·로어 기사 / ⑩~⑪ 로어 기사 4·로어 마법사 4 /
	#           ⑫ 로어 마법사 4·로어 기사 3·경비대장(적 선공) / ⑬ 경호기사 6·경호대장·로드안(674년).
	# 전투 사이에 회복할 틈이 없다. 한 번이라도 지면 795년으로 간다 (게임 오버가 아니다 — BATTLE_LOSE_OK).
	# 도망: 성공해도 문장 한 줄 뒤에 같은 전투를 다시 치른다 — BATTLE_REPEAT (입힌 피해는 남는다).
	if (Equal(Timer::Id(), 5))
		Talk("당신이 길을 가던 중 갑자기 강한 기운이 둘러싸고 있음을 알아챘다. 기척을 없애고 투시로 주위를 보았을 때 사방을 포위하고 있는 로어성의 병사들을 볼 수 있었다. 로드안이 천리안으로 우리들을 찾아내어 이곳으로 대군을 보낸 것임에 틀림없었다. 우리들은 곧 벌어질 전투를 위해 태세를 갖추었다. 당신이 투시로 주위를 경계하던 중 놀랍게도 대군을 직접 지휘하는 로드안을 보았다. 그가 직접 나섰다면 그만큼 나의 승산도 줄어든다는 걸 알고 있었다. 이제 결론은 단 한 가지였다. 바로 로드안이 있는 쪽으로 뚫고 들어가 그와 상대하는 것이었다. 그리고 내가 그를 꺾어 버린다면 대부분의 병사들은 사기를 잃고 도망가 버릴 것이기 때문이다. 일행은 서로에게 신호를 보내며 나의 생각에 동의를 표했다. 이제는 지체할 시간이 없었다. 우리들은 곧바로 로드안이 있는 쪽을 향해 뚫고 들어가기 시작했다.")
		PressAnyKey()
		lost.assign(0)
		mode.assign(Add(Add(BATTLE_NO_PRELUDE, BATTLE_LOSE_OK), BATTLE_REPEAT))

		# ① 로어성 병사 8
		if (Equal(lost, 0))
			Battle::Init()
			Battle::SetRepeatText("일행은 너무 많은 적들에게 포위되어서 도망갈 수가 없었다.")
			Battle::RegisterEnemy(67, 8)
			Battle::Start(mode)
			if (NotEqual(Battle::Result(), BATTLERESULT_WIN))
				lost.assign(1)

		# ② 로어성 병사 8
		if (Equal(lost, 0))
			Battle::Init()
			Battle::SetRepeatText("일행은 너무 많은 적들에게 포위되어서 도망갈 수가 없었다.")
			Battle::RegisterEnemy(67, 8)
			Battle::Start(mode)
			if (NotEqual(Battle::Result(), BATTLERESULT_WIN))
				lost.assign(1)

		# ③ 로어성 병사 8
		if (Equal(lost, 0))
			Battle::Init()
			Battle::SetRepeatText("일행은 너무 많은 적들에게 포위되어서 도망갈 수가 없었다.")
			Battle::RegisterEnemy(67, 8)
			Battle::Start(mode)
			if (NotEqual(Battle::Result(), BATTLERESULT_WIN))
				lost.assign(1)

		# ④ 로어성 병사 8
		if (Equal(lost, 0))
			Battle::Init()
			Battle::SetRepeatText("일행은 너무 많은 적들에게 포위되어서 도망갈 수가 없었다.")
			Battle::RegisterEnemy(67, 8)
			Battle::Start(mode)
			if (NotEqual(Battle::Result(), BATTLERESULT_WIN))
				lost.assign(1)

		# ⑤ 로어성 병사 8
		if (Equal(lost, 0))
			Battle::Init()
			Battle::SetRepeatText("일행은 너무 많은 적들에게 포위되어서 도망갈 수가 없었다.")
			Battle::RegisterEnemy(67, 8)
			Battle::Start(mode)
			if (NotEqual(Battle::Result(), BATTLERESULT_WIN))
				lost.assign(1)

		# ⑥ 로어성 병사 6 · 로어 마법사 1 · 로어 기사 1
		if (Equal(lost, 0))
			Battle::Init()
			Battle::SetRepeatText("일행은 너무 많은 적들에게 포위되어서 도망갈 수가 없었다.")
			Battle::RegisterEnemy(67, 6)
			Battle::RegisterEnemy(68, 1)
			Battle::RegisterEnemy(69, 1)
			Battle::Start(mode)
			if (NotEqual(Battle::Result(), BATTLERESULT_WIN))
				lost.assign(1)

		# ⑦ 로어성 병사 6 · 로어 마법사 1 · 로어 기사 1
		if (Equal(lost, 0))
			Battle::Init()
			Battle::SetRepeatText("일행은 너무 많은 적들에게 포위되어서 도망갈 수가 없었다.")
			Battle::RegisterEnemy(67, 6)
			Battle::RegisterEnemy(68, 1)
			Battle::RegisterEnemy(69, 1)
			Battle::Start(mode)
			if (NotEqual(Battle::Result(), BATTLERESULT_WIN))
				lost.assign(1)

		# ⑧ 로어성 병사 6 · 로어 마법사 1 · 로어 기사 1
		if (Equal(lost, 0))
			Battle::Init()
			Battle::SetRepeatText("일행은 너무 많은 적들에게 포위되어서 도망갈 수가 없었다.")
			Battle::RegisterEnemy(67, 6)
			Battle::RegisterEnemy(68, 1)
			Battle::RegisterEnemy(69, 1)
			Battle::Start(mode)
			if (NotEqual(Battle::Result(), BATTLERESULT_WIN))
				lost.assign(1)

		# ⑨ 로어성 병사 6 · 로어 마법사 1 · 로어 기사 1
		if (Equal(lost, 0))
			Battle::Init()
			Battle::SetRepeatText("일행은 너무 많은 적들에게 포위되어서 도망갈 수가 없었다.")
			Battle::RegisterEnemy(67, 6)
			Battle::RegisterEnemy(68, 1)
			Battle::RegisterEnemy(69, 1)
			Battle::Start(mode)
			if (NotEqual(Battle::Result(), BATTLERESULT_WIN))
				lost.assign(1)

		# ⑩ 로어 기사 4 · 로어 마법사 4
		if (Equal(lost, 0))
			Battle::Init()
			Battle::SetRepeatText("일행은 너무 많은 적들에게 포위되어서 도망갈 수가 없었다.")
			Battle::RegisterEnemy(69, 4)
			Battle::RegisterEnemy(68, 4)
			Battle::Start(mode)
			if (NotEqual(Battle::Result(), BATTLERESULT_WIN))
				lost.assign(1)

		# ⑪ 로어 기사 4 · 로어 마법사 4
		if (Equal(lost, 0))
			Battle::Init()
			Battle::SetRepeatText("일행은 너무 많은 적들에게 포위되어서 도망갈 수가 없었다.")
			Battle::RegisterEnemy(69, 4)
			Battle::RegisterEnemy(68, 4)
			Battle::Start(mode)
			if (NotEqual(Battle::Result(), BATTLERESULT_WIN))
				lost.assign(1)

		# ⑫ 로어 마법사 4 · 로어 기사 3 · 경비대장 — 적 선공
		if (Equal(lost, 0))
			Battle::Init()
			Battle::SetRepeatText("일행은 너무 많은 적들에게 포위되어서 도망갈 수가 없었다.")
			Battle::RegisterEnemy(68, 4)
			Battle::RegisterEnemy(69, 3)
			Battle::RegisterEnemy(70, 1)
			Battle::Start(Add(mode, BATTLE_ENEMY_FIRST))
			if (NotEqual(Battle::Result(), BATTLERESULT_WIN))
				lost.assign(1)

		# ⑬ 경호기사 6 · 경호대장 · 로드안(674년, 73번)
		if (Equal(lost, 0))
			Battle::Init()
			Battle::SetRepeatText("일행은 너무 많은 적들에게 포위되어서 도망갈 수가 없었다.")
			Battle::RegisterEnemy(71, 6)
			Battle::RegisterEnemy(72, 1)
			Battle::RegisterEnemy(73, 1)
			Battle::Start(mode)
			if (NotEqual(Battle::Result(), BATTLERESULT_WIN))
				lost.assign(1)

		if (Equal(lost, 0))
			# ---- 승리 — 로드안 격파. 즉위식은 로어성 알현실에서 (Lore.cm2 의 FLAG_MAP) → 엔딩 B ----
			Talk("당신은 힘겹게 로드안을 물리쳤다. 그리고 예상대로 로어성의 병사들은 자신의 군주가 패하자 뿔뿔이 흩어져 버렸다. 벌판에는 당신이 죽인 수많은 시체가 널려 있었다.")
			PressAnyKey()
			Screen::FadeOut()
			# 「얼마 후 로어성에는 성대한 의식이 행해졌다.」는 로어성에 들어선 뒤 Lore.cm2 의 즉위식이 낸다 (MYSTTIME.PAS:345~347)
			Flag::Set("LORE_CORONATION")
			LoadScript("E3_Lore", 51, 36)
		else
			# ---- 패배 — 차원의 틈. 795년 1월 19일 09:00, 로어 대륙 (58,79) ----
			Talk("이제는 로드안에게 패하는구나 하며 모든 것을 단념하려는 순간 빛나는 광채가 당신을 둘러싸기 시작했다. 그리고는 빨려 들어가듯 당신을 감싸던 광채는 차원의 틈 속으로 당신을 몰아넣었다.")
			PressAnyKey()
			Screen::Flash()
			Screen::FadeOut()
			Time::Set(795, 1, 19, 9, 0)
			# 이름 있는 대원 전원이 HP 1 로 살아나고 중독·의식불명·죽음이 풀린다
			if (Player::IsAvailable(1))
				Player::ChangeAttribute(1, "poison", 0)
				Player::ChangeAttribute(1, "unconscious", 0)
				Player::ChangeAttribute(1, "dead", 0)
				Player::ChangeAttribute(1, "hp", 1)
			if (Player::IsAvailable(2))
				Player::ChangeAttribute(2, "poison", 0)
				Player::ChangeAttribute(2, "unconscious", 0)
				Player::ChangeAttribute(2, "dead", 0)
				Player::ChangeAttribute(2, "hp", 1)
			if (Player::IsAvailable(3))
				Player::ChangeAttribute(3, "poison", 0)
				Player::ChangeAttribute(3, "unconscious", 0)
				Player::ChangeAttribute(3, "dead", 0)
				Player::ChangeAttribute(3, "hp", 1)
			if (Player::IsAvailable(4))
				Player::ChangeAttribute(4, "poison", 0)
				Player::ChangeAttribute(4, "unconscious", 0)
				Player::ChangeAttribute(4, "dead", 0)
				Player::ChangeAttribute(4, "hp", 1)
			if (Player::IsAvailable(5))
				Player::ChangeAttribute(5, "poison", 0)
				Player::ChangeAttribute(5, "unconscious", 0)
				Player::ChangeAttribute(5, "dead", 0)
				Player::ChangeAttribute(5, "hp", 1)
			if (Player::IsAvailable(6))
				Player::ChangeAttribute(6, "poison", 0)
				Player::ChangeAttribute(6, "unconscious", 0)
				Player::ChangeAttribute(6, "dead", 0)
				Player::ChangeAttribute(6, "hp", 1)
			# 알비레오의 목소리는 도착한 뒤에 — Ground1.cm2 의 FLAG_MAP (GROUND1_795_ARRIVED)
			LoadScript("E3_Ground1", 58, 79)

	# ════ 11 — 엔딩 A 「네크로만서의 탄생」 (충성 루트) ════
	# 에필로그 — 에너지 공이 하데스 테라를 가로질러 빛의 지붕의 카미너스에게 들어간 뒤(Lore.cm2 → UnderGrd.cm2 →
	# Dome.cm2 가 장면을 잇는다), 빛의 지붕에서 두 악마의 대화. 별도 편지 없이 화면이 서서히 꺼지고 종료 화면으로 넘어간다
	if (Equal(Timer::Id(), 11))
		Say("메피스토펠레스", "아스모데우스여, 방금 에너지 공이 이 방으로 들어가는 것을 보았는데 어떻게 된 것인가?")
		Say("아스모데우스", "예, 메피스토펠레스님. 그것은 원혼이 봉인된 에너지 공인데 로드안이 지하 세계로 버린 것입니다. 그런데 그것이 카미너스 씨의 몸속으로 들어갔습니다.")
		Say("메피스토펠레스", "그래? 그렇다면 분명 카미너스 씨의 자손 중에서 원혼을 봉인한 채 태어나는 아이가 틀림없이 있을 것이다. 그 아이가 태어났을 때, 우리의 힘으로 봉인된 원혼을 풀어 버린다면 우리는 그 힘을 이용해 세계를 지배할 수 있을 것이다. 후후후, 로드안은 정말 멍청한 짓을 했군.")
		Say("메피스토펠레스", "우리에게 도리어 이런 기회를 줘 버리다니..")
		PressAnyKey()
		Screen::FadeOut()
		Game::Ending("A")

	# ════ 12 — 엔딩 B 「새로운 로드안」 (반역 루트, 674년 승리) ════
	# 즉위식 뒤 화면이 꺼지고 알비레오의 편지가 나온다 (원작: 검은 바탕에 붉은 글씨가 위로 흐른다)
	if (Equal(Timer::Id(), 12))
		Screen::FadeOut()
		# 검은 바탕에 붉은 글씨(12)로 아래에서 위로 흐른다 (13 §13.10)
		Letter::Clear()
		Letter::Add("새로운 로드안이 된 당신에게.")
		Letter::Add("역시 당신은 나의 기대를 저버리지 않았소. 나 알비레오는 그저 로어 세계의 역사에 대해 방관자적인 입장일 뿐이었지만 비뚤어져 가는 로어 세계의 미래를 그냥 보고만 있을 수는 없어서 당신을 선택하게 되었고 당신을 이런 모험에 말려들게 했던 것이오. 이제 위선자는 사라졌고 로드안의 칭호도 당신에게 돌아갔소. 하지만 당신에게는 아직 2가지의 과제가 더 남아 있소. 첫째는 네크로만서가 된 카노푸스가 이 땅에 내려올 때 벌어지게 되고 둘째는 멸망당한 네 종족의 원혼이 부활할 때 발생하게 될 거요. 이 일들은 약 100년 후에 발생할 것이오. 하지만 당신이라면 충분히 이겨 낼 수 있을 거라 믿소.")
		Letter::Add("나는 이제 이 세계를 떠날 때가 되었소. 아직도 내가 가 보아야 할 차원이 수없이 많이 있기 때문이오. 로어 세계가 있는 이곳도 그저 내가 스쳐 갔던 수많은 차원들 중의 하나로 기억될지도 모르겠지만 쉽게 잊어버리기에는 너무 아까운 기억이 많이 있소. 그중의 하나는 당신의 존재 때문일 거라오. 이제 나는 이곳 역사에 더 이상 신경을 쓰지 않으려고 하오. 앞으로 다시 올 계획도 아직은 없소. 그저 영원의 차원으로 나의 여행을 계속할 뿐이라오.")
		Letter::Add("— 타임워커 알비레오로부터.")
		Letter::Show(12, LETTER_SCROLL)
		Game::Ending("B")

	# ════ 13 — 엔딩 C 「떠나는 자」 (반역 루트, 795년 승리) ════
	# 화면이 꺼진 뒤 주인공의 독백이 나온다 (원작: 노란 글씨, 키를 누를 때까지 번개가 번쩍인다)
	if (Equal(Timer::Id(), 13))
		Screen::FadeOut()
		# 노란 글씨(14)로 한 번에 보이고, 키를 누를 때까지 드물게 번개가 번쩍인다 (13 §13.10)
		Letter::Clear()
		Letter::Add("나는 로드안에게 마지막 일격을 가하려 검을 쳐들었다. 하지만 쉽게 내리칠 수 있을 것 같았지만 마음속에서는 심한 동요가 일고 있었다. 로드안 그는 나에게 돌이킬 수 없는 실수를 저지르게 했지만 이제는 다 끝난 일이었다. 네크로만서나 다크 메이지도 이제는 다 지나간 기억 속으로 사라져 가고 있으니까 ... ...")
		Letter::Add("나는 검을 거두고는 뒤돌아섰다. 로드안은 너무나 인간을 사랑했기에 인간을 이롭게 하고자 한 죄밖에는 없다. 나 역시 보잘것없는 한 명의 인간으로서 과연 그를 심판할 자격이 있을까?")
		Letter::Add("나는 로어성을 뒤로한 채 혼자만의 여행을 떠나고 있다.")
		Letter::Add("여태껏 잊고 지냈던 자신만의 시간을 가지고 싶었기 때문이다. 내가 어릴 적에 하나의 꿈이 있었다. 그것은 저 하늘의 새처럼 자유롭게 먼 곳으로 여행을 떠나는 것이었다.")
		Letter::Add("내 이름이 저들에게 잊혀질 때쯤이면 나는 여태껏 누구도 간 적이 없는 세상의 끝에 도달해 있을 것이다. 그리고 거기서 나는 새로운 나 자신을 찾고 또 다른 삶을 살아가는 나를 발견할 것이다.")
		Letter::Show(14, LETTER_LIGHTNING)
		Game::Ending("C")

# 공통 종료 화면(<< The End >> · Into the MYSTIC vol. 3 서명 · You must be a genius !!!)은 글이 아니라 화면이다
# (13 §13.10) — Game::Ending 이 낸다고 보고 여기서는 쓰지 않았다.
#
# (해결된 NEED) 지금 있는 맵을 묻는 함수 — Map::Is 로 zone 을 정한다.
# (해결된 NEED) Timer::Set(n, 0) 은 건 스크립트가 끝나는 대로 울린다 — 엔딩 11·12·13 이 한 걸음 늦게 나오지 않는다.
# (해결된 NEED) BATTLE_REPEAT + Battle::SetRepeatText — 13연전은 도망에 성공해도 같은 적(입힌 피해 그대로)과 이어 싸운다.
# (해결된 NEED) 엔딩 글의 연출 — Letter::Show 의 편지 화면. 엔딩 B 편지(붉은 글씨 · 위로 흐름), 엔딩 C 독백(노란 글씨 ·
#       번개), 오프닝 편지(위로 흐름). 엔딩 글은 본 게임이 아니므로 색 규칙의 예외다 (2026-11-16 원작자 확인).
# (해결된 NEED) LoadScript 뒤에 이어서 말하기 — Arrival::Say 로 쌓아 두면 도착한 맵의 FLAG_MAP 이 끝난 뒤에 나온다.
#       급보(1번)의 「지금 당신이 서 있는 곳은 하데스 게이트…」, 도시 건설(2번)·이주(3번)의 말이 이제 도착한 뒤에 나온다.
# (해결) 주민 이주(3번) 때 서 있던 칸에 사람이 나타나면 원작은 x 를 늘려 빈 칸을 찾는다 — Dome.cm2 의 3단계 FLAG_MAP 이
#       사람이 나타나는 여덟 칸에서 오른쪽 칸으로 비켜 세운다(여덟 곳 모두 바로 오른쪽이 바닥이다).
