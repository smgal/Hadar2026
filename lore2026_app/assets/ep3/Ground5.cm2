####### 우라누스 테라 (Ground5 · 50×50 · 필드형) ########
# 근거: 기획서 제5장 M8 · 5.7, 제6장 6.21, 제12장 12.3, 제14장 9.1, 부록 B.3
#       공략집 3rd/src/maps/Ground5.md · Ground5.json
#
# - 도착: 배리언트 피플즈 성주의 마법 → (25,11). 도착 좌표는 보내는 쪽(Valiant)이 준다.
# - 돌아가는 출구는 없다. 임페리엄 마이너성에서 에인션트 이블의 공간 이동으로만 나간다.
# - 이 맵의 이벤트 칸은 (8,8) 하나, 입구 칸은 (39,36) 하나다.
#   드라코니안 멸망 뒤에는 (15,31)에 임페리엄 마이너성 입구가 생긴다.
# - 충성 루트의 원혼 봉인은 이 맵에서 일어나지 않는다
#   (드라콘의 원혼은 로어 대륙 (44,50) — 제5장 L2).

include("common/const.cm2")

########## 맵에 들어왔다 ##########
if (Equal(ScriptMode(), FLAG_MAP))
	# 우라누스 테라 전용 곡 (제13장 13.11)
	Music::Play("uranus_terra")
	# 마법 제한 없음 (제6장 「맵별 마법 제한」의 「그 외」)

	# 무작위 조우: 48 드라코니안 · 49 위병 드라콘 — 드라코니안 멸망 전까지 (제12장 12.3)
	Encounter::Clear()
	if (Flag::IsSet("DRACONIAN_DESTROYED"))
		Encounter::Enable(0)
		# 부록 B.3: 드라코니안 멸망 → (15,31)에 임페리엄 마이너성 입구.
		# 드라코니안 마을에서 나올 때도, 임페리엄에서 나올 때도 여기서 다시 놓인다.
		Map::ChangeTile(15, 31, 53)
	else
		Encounter::Add(48, 49)
		Encounter::Enable(1)

########## 입구 ##########
if (Equal(ScriptMode(), FLAG_ENTER))
	# 드라코니안 마을 입구 (39,36) → 마을의 시작 (6,114)
	if (On(39, 36))
		Ask("드라코니안 마을에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E3_DracTown", 6, 114)

	# 임페리엄 마이너성 입구 (15,31) — 드라코니안 멸망 뒤에만 있는 칸 → 성의 시작 (25,44)
	if (On(15, 31))
		Ask("임페리엄 마이너성에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E3_Imperium", 25, 44)

########## 이벤트 칸 ##########
if (Equal(ScriptMode(), FLAG_EVENT))
	# 잠든 은둔자 (8,8) — 북서쪽 호수 속 5칸짜리 섬의 숨은 칸. 밟을 때마다 말한다.
	# 드라콘 글을 알고 독심 상태이면 자동 통역기를 준다 → 드라콘 말 (제5장 5.7)
	if (On(8, 8))
		Talk("당신은 잠을 자고 있는 어떤 은둔자를 보았다. 그는 당신의 기척에 잠을 깨었는지 눈을 뜨고 당신을 바라보았다. 그리고는 말을 시작했다.")
		if (Flag::IsSet("DRACO_SPEECH"))
			# 드라콘 말을 배운 뒤
			Say("은둔자", "이제 당신은 드라코니안의 말을 들을 수 있을 것입니다.")
		else
			if (Flag::IsSet("DRACO_SCRIPT"))
				# 드라콘 글은 알고 말은 모를 때
				Say("은둔자", "나에게는 당신이 뭘 원하는지 훤히 보이는군요. 당신은 지금 드라코니안의 말을 배우려 하고 있죠?")
				if (Party::CheckIf(CHECKIF_MINDCONTROL))
					Say("은둔자", "그럼 가르쳐 드리죠. 이건 제가 발명한 자동 통역기인데 귓속에다 넣으면 드라코니안의 말을 들을 수 있을 것입니다.")
					Flag::Set("DRACO_SPEECH")
				else
					Say("은둔자", "하지만 귀찮아서 가르쳐 주고 싶지 않군요.")
			else
				# 드라콘 글을 모를 때
				Say("은둔자", "혹시 당신 지금 드라코니안의 글을 배우려 하지 않습니까? 그렇다면 이 대륙 전체를 뒤져서 금빛의 인어를 찾아보십시오.")

# (원작 확인) 임페리엄 마이너성 입구 (15,31) 은 53 — 드라코니안 마을을 나설 때 드라코니안이 멸망했으면
#   PutMap(15,31,53) (MYSTSPEC.PAS:1096).
