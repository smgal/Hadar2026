####### 빛의 지붕 (E3_Dome) — 50×100 · 마을형 ########
# 에인션트 이블이 염력으로 하데스 테라에 세운 지하 도시. 「빛(정의)을 지키는 사람들의 마을」.
# 근거: 기획서 제5장 5.5(X3~X5) · 제6장 6.27 · 제13장 13.9 · 제14장 11(에필로그) · 12 · 12.1
#       부록 A(#42 · #43) · 부록 B / 공략 3rd/src/maps/Dome.md
#
# 들어오는 길 — 하데스 테라 (46,48) 에서 크로매틱 크리스탈을 쓰면 (25,50)
# 나가는 길   — 가장자리 줄(x=5 · x=46 · y=6 · y=95) → 에인션트 이블의 작별 → 로어 대륙 (80,80).
#               주민 이주가 끝난 뒤에만 작동한다 (부록 A #43 의 의도). 돌아오는 입구는 없다.
#
# 도시는 세 단계로 선다 — DOME_STAGE (변수). 단계를 넘기는 것은 episode.cm2 의 예약이고,
# 이 맵의 FLAG_MAP 은 들어올 때마다 그 단계의 모습을 만든다.
#   1 공사 현장  UnderGrd.cm2 가 크리스탈을 쓴 직후 DOME_STAGE 를 1 로 두고 Timer::Set(2, 20).
#                맵 전체가 건물 없는 흙바닥(47, 열에 하나꼴로 45)
#   2 빈 도시    예약 2 가 에인션트 이블의 말을 내고 DOME_STAGE 를 2 로 둔 뒤 (25,50) 으로 다시 보낸다
#                (그리고 Timer::Set(3, 30)). 건물은 있고 사람 8명이 없다
#   3 주민 이주  예약 3 이 말을 내고 REFUGE_BUILT 를 켠 뒤 서 있던 자리로 다시 보낸다.
#                사람이 나타나고 출구가 열린다
#
# 예약 — 도시를 나설 때 Timer::Set(4, 90): 90분 뒤 옛 동료들과의 재회 (episode.cm2, 재회가 포위 5 를 건다)
#
# 이 맵이 쓰는 기록
#   ALLEGIANCE (변수, 부록 B)        1 = 충성 — 충성 루트로 오는 것은 결말 A 의 에필로그뿐이다
#   REFUGE_BUILT (플래그, 부록 B)     주민 이주가 끝났다
#   EBONY_CRYSTAL_GIVEN (플래그, 부록 B)  노인에게서 에보니 크리스탈을 받았다
#   DOME_STAGE (변수)                 위의 단계

include("common/const.cm2")

# ───────────────────────────── 맵에 들어온 직후 ─────────────────────────────
if (Equal(ScriptMode(), FLAG_MAP))
	Music::Play("town")			# 마을형 공통 곡
	# 무작위 조우 없음 · 마법 제한 없음
	Encounter::Clear()
	Encounter::Enable(0)

	# ── 결말 A 의 에필로그 (충성 루트) — 하데스 테라의 에필로그가 (26,6) 으로 넘겨준다 ──
	# 화면이 흘러가는 연출만 여기서 하고, 두 악마의 대화와 엔딩은 episode.cm2 의 예약 11 이 맡는다.
	# 도시는 원래 모습 그대로다(주민과 카미너스가 모두 보인다).
	if (Equal(Variable::Get("ALLEGIANCE"), 1))
		Music::Stop()
		# 하데스 테라에서 감춘 일행 그림을 그대로 감춘 채 화면만 옮긴다
		Party::Hide()
		# 악마 하나가 (28,21) 에 서 있다 — 사람 칸 53 (MYSTTAL2.PAS:677)
		Map::ChangeTile(28, 21, 53)
		Party::Warp(26, 6)
		Actor::ShowSprite("에너지 공", 20, 26, 6)
		DisplayMap()
		# 에너지 공이 0.5초에 한 칸씩 내려와 (26,14) 의 카미너스 몸속으로 들어간다
		Wait(500)
		Party::Warp(26, 7)
		Actor::ShowSprite("에너지 공", 20, 26, 7)
		Wait(500)
		Party::Warp(26, 8)
		Actor::ShowSprite("에너지 공", 20, 26, 8)
		Wait(500)
		Party::Warp(26, 9)
		Actor::ShowSprite("에너지 공", 20, 26, 9)
		Wait(500)
		Party::Warp(26, 10)
		Actor::ShowSprite("에너지 공", 20, 26, 10)
		Wait(500)
		Party::Warp(26, 11)
		Actor::ShowSprite("에너지 공", 20, 26, 11)
		Wait(500)
		Party::Warp(26, 12)
		Actor::ShowSprite("에너지 공", 20, 26, 12)
		Wait(500)
		Party::Warp(26, 13)
		Actor::ShowSprite("에너지 공", 20, 26, 13)
		Wait(500)
		Party::Warp(26, 14)
		Actor::Hide("에너지 공")			# 카미너스의 몸속으로 들어간다
		# 5초 멈춘 뒤 화면이 1초에 한 칸씩 (26,18) 까지 더 내려간다
		Wait(5000)
		Party::Warp(26, 15)
		Wait(1000)
		Party::Warp(26, 16)
		Wait(1000)
		Party::Warp(26, 17)
		Wait(1000)
		Party::Warp(26, 18)
		Wait(1000)
		# 3초 뒤 — 다른 악마(사람 칸 52)가 (29,23) 에서 (29,21) 까지 0.5초에 한 칸씩 걸어 나온다 (MYSTTAL2.PAS:690~694)
		Wait(3000)
		Actor::Show("악마", 52, 29, 23)
		Wait(500)
		Actor::Move("악마", 0, -1)
		Actor::Wait()
		Wait(340)
		Actor::Move("악마", 0, -1)
		Actor::Wait()
		Wait(340)
		# 메피스토펠레스와 아스모데우스의 대화 → 엔딩 A
		Timer::Set(11, 0)
		halt

	# ── 1단계: 공사 현장 ──
	# 건물도 사람도 나가는 칸도 없는 빈 터. 흙바닥 뿌리기는 파일 끝의 블록이 한다.
	# (20분 뒤의 예약 2 는 UnderGrd.cm2 가 크리스탈을 쓴 자리에서 걸어 두었다)
	if (Equal(Variable::Get("DOME_STAGE"), 1))
		Map::ChangeTileArea(1, 1, 50, 100, 47)

	# ── 2단계: 빈 도시 ──
	# 사람 8명의 칸을 둘레와 같은 바닥으로 비운다. 가장자리 출구는 주민이 올 때까지
	# 작동하지 않는다 (FLAG_EVENT 가 REFUGE_BUILT 를 본다).
	if (Equal(Variable::Get("DOME_STAGE"), 2))
		Map::ChangeTile(26, 14, 35)			# 카미너스
		Map::ChangeTile(13, 27, 44)			# 주민
		Map::ChangeTile(39, 29, 30)			# 주민
		Map::ChangeTile(22, 35, 47)			# 주민
		Map::ChangeTile(38, 41, 30)			# 노인
		Map::ChangeTile(19, 54, 44)			# 주민
		Map::ChangeTile(30, 63, 47)			# 주민
		Map::ChangeTile(19, 73, 47)			# 주민
		DisplayMap()

	# ── 3단계: 주민 이주 ──
	# REFUGE_BUILT 는 예약 3 이 이리로 보내기 전에 켰다. 에인션트 이블의 말은 예약 3 이 Arrival::Say 로 쌓아 두어
	# 이 블록이 끝난 뒤(주민들이 나타난 뒤)에 나온다.
	if (Equal(Variable::Get("DOME_STAGE"), 3))
		# 서 있던 자리에 사람이 나타났으면 오른쪽 빈칸으로 비켜 선다 (여덟 곳 모두 바로 오른쪽이 바닥이다)
		if (On(26, 14))
			Party::Warp(27, 14)
		if (On(13, 27))
			Party::Warp(14, 27)
		if (On(39, 29))
			Party::Warp(40, 29)
		if (On(22, 35))
			Party::Warp(23, 35)
		if (On(38, 41))
			Party::Warp(39, 41)
		if (On(19, 54))
			Party::Warp(20, 54)
		if (On(30, 63))
			Party::Warp(31, 63)
		if (On(19, 73))
			Party::Warp(20, 73)
		DisplayMap()
		Flag::Set("REFUGE_BUILT")			# 예약 3 이 이미 켰다 — 출구가 이 플래그에 달려 있어 한 번 더 못박는다

# ───────────────────────────────── 사람 ─────────────────────────────────
# 사람은 3단계(주민 이주) 뒤에만 있다. 건물 안은 꾸밈일 뿐 가게가 없다.
if (Equal(ScriptMode(), FLAG_TALK))
	# (26,14) 카미너스 — 북쪽 회관
	if (On(26, 14))
		Say("카미너스", "저는 카미너스라는 그때 그 사람입니다. 우리는 이 마을을 '@B빛의 지붕@@'이라고 명명했습니다. '빛'은 정의를 뜻하고 '지붕'은 그것을 지키는 것 또는 지키는 사람이란 뜻입니다. 즉, 정의를 지키는 사람들의 마을이란 뜻입니다.")

	# (13,27) 주민
	if (On(13, 27))
		Say("주민", "당신은 우리들의 생명의 은인입니다. 또한 새로운 로드안이 되실 충분한 가능성을 갖고 계신 분입니다.")

	# (22,35) 주민
	if (On(22, 35))
		Say("주민", "당신의 용기 있는 결단에 정말 감격했습니다.")

	# (39,29) 주민
	if (On(39, 29))
		Say("주민", "당신과 에인션트 이블이 정말 진정한 선의 수호자입니다.")

	# (19,54) 주민
	if (On(19, 54))
		Say("주민", "당신은 비록 과거에 로드안의 심복으로서 큰 실수를 저질렀지만 이제는 명실공히 이런 난세의 구세주입니다.")

	# (30,63) 주민
	if (On(30, 63))
		Say("주민", "우리들은 투표로 이곳의 지도자를 선출했습니다. 그는 바로 우리들을 일어서게 한 용감한 사람, 바로 카미너스 씨입니다.")

	# (19,73) 주민
	if (On(19, 73))
		Say("주민", "이곳 사람들은 모두 당신에게 고마워하고 있고 당신이 우리가 못다 한 일을 해 줄 거라 믿고 있습니다.")

	# (38,41) 노인 — 동쪽 두 번째 건물 안. 처음 말을 걸면 에보니 크리스탈, 그 뒤로는 둘째 문장
	if (On(38, 41))
		if (Flag::IsSet("EBONY_CRYSTAL_GIVEN"))
			Say("노인", "상당히 귀한 물건이니 조심해서 간직하시오.")
		else
			Flag::Set("EBONY_CRYSTAL_GIVEN")
			Say("노인", "당신의 용기에 대한 나의 작은 정성이오. 자 이걸 받으시오. 우리 조상 대대로 내려오던 @B에보니 크리스탈@@이란 거요.")
			Item::Give("crystal.ebony")

# ─────────────────────────── 이벤트 칸을 밟았다 ───────────────────────────
if (Equal(ScriptMode(), FLAG_EVENT))
	# 도시 가장자리 한 줄 (x=5 · x=46 · y=6 · y=95, 260칸) — 출구
	# 주민 이주 전에는 아무 일도 하지 않는다(평범한 바닥). 원작은 빈 도시 단계에도 나갈 수 있어
	# 이주와 에보니 크리스탈을 영영 놓쳤다 (부록 A #43).
	if (Or(OnArea(5, 6, 46, 6), OnArea(5, 95, 46, 95), OnArea(5, 6, 5, 95), OnArea(46, 6, 46, 95)))
		if (Flag::IsSet("REFUGE_BUILT"))
			Ask("여기서 나가기를 원합니까?")
			if (Equal(Select::Result(), 1))
				Say("에인션트 이블", "당신이 발견한 이 장소는 분명 배리언트 피플즈의 사람들을 로드안의 시각 범위에 벗어나게 하기에 충분한 곳일 겁니다. 당신은 정말 훌륭한 일을 해내셨습니다. 제가 곧 당신을 지상으로 이동시켜 드리겠습니다. 그리고 저는 몇 년 정도 휴식을 취하려 합니다. 저의 영적 에너지를 마을을 건설하고 사람들을 이동시키는 데 써 버려서 에너지 충전 기간이 필요합니다. 여태껏 당신의 도움들 정말 고마웠습니다. 계속 자신이 결심한 의지대로 꿋꿋하게 나아가십시오. 저는 이제 뒷일을 모두 당신에게 맡기겠습니다. 당신이라면 분명히 해낼 거라 믿습니다. 그럼, 안녕히...")
				PressAnyKey()
				# 정확히 90분 뒤 옛 동료들과 재회 (원작의 실제 대기는 61~90분 — 부록 A #42)
				Timer::Set(4, 90)
				LoadScript("E3_Ground1", 80, 80)
			else
				WarpPrevPos()

# ─────────────────────────── 이야기용 물건을 썼다 ───────────────────────────
if (Equal(ScriptMode(), FLAG_ITEM))
	# 크로매틱 크리스탈은 하데스 테라 (46,48) 에서만 반응한다 (제9장 9.8)
	if (Equal(Item::Used(), "crystal.chromatic"))
		Talk("크리스탈에는 아무런 반응이 없었다.")

# ─────────────────── 1단계 공사 현장의 흙바닥 뿌리기 (FLAG_MAP) ───────────────────
# 원작은 모든 칸을 10분의 1 확률로 45번, 나머지를 47번으로 덮는다. 위에서 전체를 47 로 덮었고 여기서 45 를 뿌린다.
if (And(Equal(ScriptMode(), FLAG_MAP), Equal(Variable::Get("DOME_STAGE"), 1)))
	Map::ScatterTile(1, 1, 50, 100, 45, 10)
	DisplayMap()

# (해결된 NEED) 일행 그림 감추기 · 화면만 옮기기 — Party::Hide 뒤의 Party::Warp 는 카메라만 옮긴다.
# (해결된 NEED) 에너지 공 그림 — 3부 스프라이트 20 이 (26,6) 에서 0.5초에 한 칸씩 내려와 (26,14) 에서 사라진다.
# (원작 확인) 에필로그의 악마 둘 — (28,21) 에 서 있는 쪽은 사람 칸 53, (29,23)→(29,21) 로 걸어 나오는 쪽은 52 (MYSTTAL2.PAS:677 · 690~694).
