####### 로어성 795년 (Dark) ########
# 근거: 기획서 05 §5.5 X8 · 06 §6.6 · 10 §10.7 · 12 §12.4 · 14 §13 · 15 부록 A #6, 공략 원고 Dark.md/json
# 시작 (51,94) · 마을형 · 기본 바닥 44 · 무작위 조우 없음 · 마법 제한 없음
# 121년 뒤의 로어성. 반역 루트에서 로드안 대군에게 진 뒤에만 온다 — 로어 대륙 (20,11) 이 700년 이후에 이 맵으로 보낸다.
# 동료 자리 · 사면 · 게시판은 없다. 로드안 (51,28) 에게 말을 걸면 2연전, 이기면 엔딩 C (episode.cm2 의 13번).

include("common/const.cm2")

####### 맵에 들어왔다 ########

if (Equal(ScriptMode(), FLAG_MAP))
	# 674년 로어성의 전용 곡이 아니라 마을형 공통 곡이다
	Music::Play("town")
	# 다른 맵에서 화면을 어둡게 한 채 넘어왔으면 걷는다. 막이 없으면 아무 일도 없다
	Screen::FadeIn(0)

####### 사람 ########

if (Equal(ScriptMode(), FLAG_TALK))

	# ---- 감옥 (북쪽 가운데) — 감방은 모두 비었다 ----

	# (50,11)·(53,11) 간수
	if (Or(On(50, 11), On(53, 11)))
		Say("간수", "여태껏 근 20년간 아무도 이곳에 갇히지 않았죠. 그래서 저는 너무 할 일이 없습니다.")

	# ---- 알현실 ----

	# (51,28) 로드안 — 최후의 결전. 두 전투 사이에 회복할 틈이 없다. 지면 게임 오버
	if (On(51, 28))
		Answer("로드안!! 당신은 나를 기억하겠소? 100년 전쯤에 나를 이용하여 무고한 네 종족을 멸망시키게 만들었던 것도 말이오.")
		Talk("당신의 말이 채 끝나기도 전에 로드안은 다급하게 외쳤다.")
		Say("로드안", "경호원, 경호원!!")
		Talk("순간 몇 명의 용사가 주위에서 나와 로드안을 감쌌다.")
		PressAnyKey()
		# 1전 (12 §12.4): 69 로어 기사 ×3 · 68 로어 마법사 ×3 · 70 경비대장 ×1 — 적 선공, 반복
		# (원작은 로어 마법사 3명 자리를 새로 채우지 않았다 — 부록 A #6. 의도된 편성대로 채운다)
		Battle::Init()
		Battle::RegisterEnemy(69, 3)
		Battle::RegisterEnemy(68, 3)
		Battle::RegisterEnemy(70, 1)
		Battle::Start(Add(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE), BATTLE_REPEAT))
		if (Equal(Battle::Result(), BATTLERESULT_WIN))
			# 2전: 71 경호기사 ×3 · 72 경호대장 ×1 · 74 로드안(795년) ×1 — 적 선공, 반복
			Battle::Init()
			Battle::RegisterEnemy(71, 3)
			Battle::RegisterEnemy(72, 1)
			Battle::RegisterEnemy(74, 1)
			Battle::Start(Add(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE), BATTLE_REPEAT))
			if (Equal(Battle::Result(), BATTLERESULT_WIN))
				Talk("당신은 드디어 숙적 로드안을 물리쳤다.")
				PressAnyKey()
				# 엔딩 C (episode.cm2)
				Timer::Set(13, 0)
				halt

	# (48|54, 31·33·35·37) 알현실 병사 8명
	if (OnArea(48, 31, 54, 37))
		Say("병사", "...")

	# (50,51)·(52,51) 성문 병사
	if (Or(On(50, 51), On(52, 51)))
		Say("병사", "안녕하시오.")

	# ---- 훈련장 (북서쪽) ----

	# (21,12)·(25,13) 훈련소·마법 학교
	if (Or(On(21, 12), On(25, 13)))
		Shop::Training()

	# (28,12) 경험치 훈련장 — 674년의 (12,13) 에서 자리를 옮겼다
	if (On(28, 12))
		Shop::ExpTraining()

	# ---- 병원 (북동쪽) ----

	# (86,12)·(87,14) 병원
	if (Or(On(86, 12), On(87, 14)))
		Shop::Hospital()

	# (82,16) 약초 가게 — 병원 건물 안. 674년 로어성에는 없던 가게
	if (On(82, 16))
		Shop::Herb()

	# ---- 주점 (서쪽) ----

	# (13,27)·(18,27) 종업원
	if (Or(On(13, 27), On(18, 27)))
		Say("종업원", "여기는 코리아 위스키가 제일 잘 팔립니다.")

	# (21,33) 종업원
	if (On(21, 33))
		Say("종업원", "요즈음은 너무 할 일이 없어서 따분합니다.")

	# (18,33) 손님
	if (On(18, 33))
		Say("손님", "당신 정말 이상한 차림이군요. 거의 100년 전에나 입던 옷인데...")

	# (13,32) 손님
	if (On(13, 32))
		Say("손님", "킥킥.. 정말 우스운 복장을 하고 있군요.")

	# (18,38) 손님
	if (On(18, 38))
		Say("손님", "요새는 너무 따분한 세상의 연속이에요.")

	# ---- 여관 (서쪽, 주점 아래) ----

	# (19,53) 여관 주인
	if (On(19, 53))
		Say("여관 주인", "이 세계의 창시자는 안영기님이시며 그는 위대한 프로그래머입니다.")

	# (13,55) 주민
	if (On(13, 55))
		Say("주민", "이십몇 년 전에 이곳은 네크로만서란 자에 의해 큰 혼란이 있었습니다.")

	# (24,50) 주민
	if (On(24, 50))
		Say("주민", "안녕하시오.")

	# ---- 무기상점 · 물품 가게 (남서쪽) ----

	# (9,64) 물품 가게 — 674년의 (16,64) 에서 자리를 옮겼다
	if (On(9, 64))
		Shop::Goods()

	# (8,71)·(14,69)·(14,73) 무기상점
	if (Or(On(8, 71), On(14, 69), On(14, 73)))
		Shop::Weapon()

	# ---- 식료품점 (남동쪽) ----

	# (87,73)·(94,68)·(91,65) 식료품점
	if (Or(On(87, 73), On(94, 68), On(91, 65)))
		Shop::Grocery()

	# ---- 동쪽 주거 건물 · 거리 ----

	# (83,25) 주민 — 알비레오의 예언서 이야기
	if (On(83, 25))
		Say("주민", "20년 전에 알비레오라는 사람이 이상한 예언서를 남겼죠. 거기서 다크 메이지라는 사람이 나타난다고 했었는데 실제로는 나타나지 않았어요.")

	# (77,46) 주민
	if (On(77, 46))
		Say("주민", "메너스는 폐광이 된 지 50년이 넘었죠.")

	# (83,59) 주민
	if (On(83, 59))
		Say("주민", "라스트디치는 주민 등록을 마친 자만이 들어갈 수 있죠.")

	# (68,61) 주민
	if (On(68, 61))
		Say("주민", "당신들의 옷은 정말 특이하군요. 100년 전 사람 같아요.")

	# ---- 묘지 (남쪽 동편) ----

	# (72,78) 묘지기
	if (On(72, 78))
		Say("묘지기", "여기는 로어성의 묘지입니다. 함부로 들어가지 마십시오.")

	# (63~73,76) 묘비 줄 — 674년과 같이 서 있지만 (64,76) 데네브의 묘비를 조사해도 글이 나오지 않는다 (06 §6.6)

####### 푯말 ########

if (Equal(ScriptMode(), FLAG_SIGN))

	# (51,84) 성 입구
	if (On(51, 84))
		Talk("이곳은 로어성입니다.")
		Talk("여러분을 환영합니다.")
		Talk("이곳의 성주 로드안 씀")

	# (51,18)·(52,18) 감옥 — 674년의 (51,15) 에서 입구 쪽으로 옮겨졌다
	if (OnArea(51, 18, 52, 18))
		Talk("로어 왕립 죄수 수용소")

	# (24,31) 주점
	if (On(24, 31))
		Talk("로어 주점")
		Talk("(코리아 위스키가 잘 팔린다는 말 않겠음)")

####### 이벤트 칸 ########

if (Equal(ScriptMode(), FLAG_EVENT))

	# (49~53,95) 남문 출구 줄 → 로어 대륙 (20,12)
	if (OnArea(49, 95, 53, 95))
		Ask("여기서 나가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E3_Ground1", 20, 12)
		else
			WarpPrevPos()

####### 이야기용 물건 ########

if (Equal(ScriptMode(), FLAG_ITEM))

	# 크로매틱 크리스탈 — 하데스 테라 (46,48) 이 아니면 반응이 없다 (09 §9.8)
	if (Equal(Item::Used(), "crystal.chromatic"))
		Talk("크리스탈에는 아무런 반응이 없었다.")

# (해결된 NEED — BATTLE_REPEAT 로 바꿨다) BATTLE_REPEAT (Battle::Start 값) — 「반복」 전투. 도망에 성공해도 같은 적(깎인 HP 그대로)과 곧바로 다시,
#       다시 적 선공으로 싸운다 (12 §12.4 795년 로어성 1전·2전). 이제 BATTLE_REPEAT 로 한다.
# (해결된 NEED) Timer::Set(n, 0) 은 건 스크립트가 끝나는 대로 울린다 — 결전 대화가 끝나면 엔딩 C 가 바로 나온다.
# (확인) 경호원이 「주위에서 나와 로드안을 감싸는」 장면 — 원작도 문장만 내고 맵에는 아무것도 세우지 않는다
#       (MYSTTAL2.PAS:789~801, 원작 소스 github.com/smgal/LoreTrilogy_1993). 그대로 둔다.
