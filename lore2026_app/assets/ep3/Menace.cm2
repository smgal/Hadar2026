####### 메너스 금광 (Menace) ########
# 근거: 기획서 05 §5.3 M0 · §5.6 S1 · 06 §6.8 · 10 §10.9 · 13 §13.9 · 14 §2·§2.1 · 16 부록 B(새 게임 초기값) ·
#       18 부록 D.10, 공략 원고 Menace.md/json
# 프롤로그 시작 (27,29) · 재방문 시작 (25,44) · 동굴형 · 기본 바닥 44 · 무작위 조우 없음 · 마법 제한 없음
# 사면(PARDONED) 전에는 프롤로그 배치다: 광부 넷이 없고 감독이 (27,32) 에 서 있으며, 출구 줄은 살인 누명 장면이 된다.
# 재판은 Lore.cm2 의 FLAG_MAP 이 이어받는다 (673년 · MAIN_STAGE 0 으로 로어성 (51,36) 에 들어오면).

include("common/const.cm2")

####### 맵에 들어왔다 ########

if (Equal(ScriptMode(), FLAG_MAP))
	Music::Play("den")
	# 다른 맵에서 화면을 어둡게 한 채 넘어왔으면 걷는다. 막이 없으면 아무 일도 없다
	Screen::FadeIn(0)
	# 프롤로그 전용 배치 (부록 B 「새 게임 초기값」): 광부 4명 제거, 감독을 (27,32) 에
	if (Not(Flag::IsSet("PARDONED")))
		Map::ChangeTile(27, 26, 44)
		Map::ChangeTile(24, 34, 44)
		Map::ChangeTile(15, 36, 44)
		Map::ChangeTile(35, 41, 44)
		# 감독은 일당을 주고 떠나면 다시 나타나지 않는다
		if (Not(Flag::IsSet("MENACE_WAGE_PAID")))
			Map::ChangeTile(27, 32, 21)
			# 게임 시작 문구 (14 §2) — 맵이 보이는 채로 메시지 창에 나온다
			Talk("여기는 로어 대륙의 메너스 금광.")
			Talk("때는 673년 11월 27일 오후였다.")

####### 사람 ########

if (Equal(ScriptMode(), FLAG_TALK))

	# (27,32) 광산 감독 — 프롤로그 한정. 시작 갱도의 유일한 출구 칸을 막고 서 있다
	if (On(27, 32))
		Say("광산 감독", "오, {주인공}.")
		Say("광산 감독", "오늘 일도 다 끝냈군요. 자, 여기 일당 받으시오.")
		Party::PlusGold(4)
		Notice("황금 + 4")
		Flag::Set("MENACE_WAGE_PAID")
		# 1초에 한 칸씩 남쪽으로 여섯 칸 걸어 (27,38) 에 이르고 그 자리에서 사라진다. 그 길의 바닥은 43번.
		# 걷는 동안은 배우다 — 서 있던 칸은 바로 바닥이 된다.
		Map::ChangeTile(27, 32, 43)
		Actor::Show("감독", 21, 27, 32)
		DisplayMap()
		Wait(840)
		Actor::Move("감독", 0, 1)
		Actor::Wait()
		Wait(840)
		Actor::Move("감독", 0, 1)
		Actor::Wait()
		Wait(840)
		Actor::Move("감독", 0, 1)
		Actor::Wait()
		Wait(840)
		Actor::Move("감독", 0, 1)
		Actor::Wait()
		Wait(840)
		Actor::Move("감독", 0, 1)
		Actor::Wait()
		Wait(840)
		Actor::Move("감독", 0, 1)
		Actor::Wait()
		Wait(840)
		Actor::Hide("감독")

	# ---- 재방문 (프롤로그 동안에는 광부가 없다) ----

	# (27,26) 광부 — 시작 갱도의 북쪽 끝. 석판과 공룡 머리뼈
	if (On(27, 26))
		Say("광부", "자네 이것 좀 봐. 이건 내가 오래전에 광산 일을 하면서 발견한 건데 이상한 점이 있어. 이건 어떤 형식의 표음 문자가 적힌 석판인데 공교롭게도 30만 년 전 지층에서 나왔다네. 그리고 이건 더 오래된 지층에서 나온 공룡의 머리뼈인데 마법으로 관통당한 구멍이 선명하게 나타나 있다네. 공룡과 인류는 서로 다른 시대를 살았는데 이건 정말 이상하지 않은가?")

	# (24,34) 광부 — 비난
	if (On(24, 34))
		Say("광부", "당신이 여기 나타나다니 정말 뻔뻔스럽군. 사람을 죽여 놓고도 태연한 척하다니...")

	# (15,36) 광부 — 하데스 테라 전설
	if (On(15, 36))
		Say("광부", "내가 전해 들은 전설에 의하면 로어 대륙 지하에 하데스 테라라는 지하 대륙이 있다고 들었다네. 하지만 전설인데 뭐.")

	# (35,41) 광부 — 위로
	if (On(35, 41))
		Say("광부", "몇 개월 전의 사건은 잊어버리게. 이곳에 있는 대부분의 광부들은 자네가 살인을 했다고는 믿지 않네. 단지 자네가 약간 운이 나빴던 거지.")

####### 이벤트 칸 ########

if (Equal(ScriptMode(), FLAG_EVENT))

	# ---- 금화 (각 1회 · 프롤로그 중에도 얻는다) ----

	# (14,27) 금화 1000 — 서쪽 갱도 끝
	if (On(14, 27))
		if (Not(Flag::IsSet("MENACE_GOLD_1")))
			Flag::Set("MENACE_GOLD_1")
			Party::PlusGold(1000)
			Talk("당신은 금화 1000개를 발견했다.")

	# (6,39) 금화 1500 — 서쪽 끝
	if (On(6, 39))
		if (Not(Flag::IsSet("MENACE_GOLD_2")))
			Flag::Set("MENACE_GOLD_2")
			Party::PlusGold(1500)
			Talk("당신은 금화 1500개를 발견했다.")

	# (42,36) 금화 2000 — 동쪽 끝
	if (On(42, 36))
		if (Not(Flag::IsSet("MENACE_GOLD_3")))
			Flag::Set("MENACE_GOLD_3")
			Party::PlusGold(2000)
			Talk("당신은 금화 2000개를 발견했다.")

	# (44,41) 금화 500 — 동남쪽 끝
	if (On(44, 41))
		if (Not(Flag::IsSet("MENACE_GOLD_4")))
			Flag::Set("MENACE_GOLD_4")
			Party::PlusGold(500)
			Talk("당신은 금화 500개를 발견했다.")

	# ---- 봉인된 공간 ----

	# (27,6) 밀랍 상자의 예언서 — 밟을 때마다 다시 읽는다. 물건은 얻지 않는다 (S1)
	if (On(27, 6))
		Talk("당신은 여기서 밀랍으로 봉인된 작은 상자를 발견하였다. 조심해서 열어 보니 예언서 한 권이 그 속에 들어 있었다.")
		Talk("당신은 호기심에 그 책을 펼쳤다.")
		PressAnyKey()
		Talk("INDEX :")
		Talk("Chapter 1. 지식의 성전")
		Talk("Chapter 2. 다크메이지의 탄생")
		Talk("Chapter 3. 제작자의 차원")
		Talk("Chapter 4. 위선자의 최후")
		Talk("Chapter 5. 이 예언의 결말")
		PressAnyKey()
		Talk("Chapter 1.")
		Talk("약 150년 뒤, 지식의 성전의 북쪽 해안에 또 다른 지식의 성전이라는 피라미드가 생긴다. 그곳에서는 이 세계의 진실된 의미를 발견할 수 있게 될 것이며 '또 다른 지식의 성전'이라는 뜻을 이해할 수 있게 할 것이다.")
		PressAnyKey()
		Talk("당신이 다음 장을 넘겼지만 Chapter 2.의 내용은 누군가에 의하여 찢겨져 나갔다.")
		PressAnyKey()
		Talk("Chapter 3.")
		Talk("이곳 3차원에서 4차원의 축으로 조금만 이동하면 전혀 다른 새로운 3차원의 세계가 펼쳐진다. 대부분은 텅 빈 공간 속이거나 생명체가 없는 거대한 땅덩이가 있기도 하지만 때때로 생명체가 있는 곳일 수도 있다. 그중 하나는 자신의 별을 스스로 지구라고 부르는 종족이 사는 곳이 있다. 그곳에는 이 공간의 창조자인 안영기님이 지금도 열심히 게임 시나리오와 시스템을 구상하고 있을 것이다.")
		PressAnyKey()
		Talk("Chapter 4.")
		Talk("795년 위선자는 사라지고 로어 세계는 진정한 평화의 길로 접어든다. 이후의 세계는 안영기님이 창조하지 않아도 우리 스스로가 미래를 개척해 나가게 되고, 안영기님 역시 로어 세계에 대한 일들을 우리에게 모두 위임하고 더 이상 로어 역사에 개입하지 않게 된다.")
		PressAnyKey()
		Talk("Chapter 5.")
		Talk("795년 이후의 미래는 더 이상 창조되지 않는다. 그때부터는 우리 스스로가 개척해 나가는 미래가 있을 뿐이다. 그리고 나의 예언서도 이것으로 끝을 맺게 된다.")
		PressAnyKey()
		Talk("그리고 마지막 장에 이렇게 써 있었다.")
		Talk("이 책은 내가 죽은 다음 날 세상에 나타날 것이다.")

	# ---- 출구 줄 ----

	# (25~26,45) 출구 줄 — 사면 뒤: 로어 대륙 (18,89) / 사면 전: 살인 누명
	if (OnArea(25, 45, 26, 45))
		if (Flag::IsSet("PARDONED"))
			Ask("여기서 나가기를 원합니까?")
			if (Equal(Select::Result(), 1))
				LoadScript("E3_Ground1", 18, 89)
			else
				WarpPrevPos()
		else
			# 살인 누명 — 나갈지 묻지 않고 장면이 시작된다 (M0)
			Talk("당신이 광산을 나가려 했을 때 당신은 당신 앞에 벌어져 있는 광경을 보고 섬뜩함을 느꼈다. 조금 전에 당신에게 일당을 주었던 그 광산업자가 창에 찔린 채로 쓰러져 있었다. 당신은 그자에게로 다가갔다. 그는 창으로 심장을 관통당한 채 쓰러져 있었다. 나는 그 창이 낯이 익어서 그 창을 뽑아 쥐었다. 그 창은 바로 내가 사냥용으로 쓰던 나의 창이었다.")
			# 횃불 수치가 10 이 된다
			Party::SetTorch(10)
			# 로어성 병사 2명(3부 스프라이트 13, 창을 든 병사)이 남쪽 입구 통로 (25~26,50) 에서 (25~26,46) 까지
			# 0.5초에 한 칸씩 걸어 올라온다 (MYSTSPEC.PAS:568~575)
			Actor::ShowSprite("병사1", 13, 25, 50)
			Actor::ShowSprite("병사2", 13, 26, 50)
			Wait(500)
			Actor::Move("병사1", 0, -1)
			Actor::Move("병사2", 0, -1)
			Actor::Wait()
			Wait(340)
			Actor::Move("병사1", 0, -1)
			Actor::Move("병사2", 0, -1)
			Actor::Wait()
			Wait(340)
			Actor::Move("병사1", 0, -1)
			Actor::Move("병사2", 0, -1)
			Actor::Wait()
			Wait(340)
			Actor::Move("병사1", 0, -1)
			Actor::Move("병사2", 0, -1)
			Actor::Wait()
			Wait(340)
			Talk("갑자기 나타난 로어성의 병사들은 당신의 창을 빼앗아 들고 말했다.")
			Say("로어성 병사", "우리는 당신을 살인 혐의로 체포합니다. 그리고 이 창은 증거물로 압수하겠습니다. 변명은 법정에서 하십시오.")
			PressAnyKey()
			# 화면이 닫히고 로어성 알현실의 재판으로 — Lore.cm2 의 FLAG_MAP 이 이어받는다
			Screen::FadeOut()
			LoadScript("E3_Lore", 51, 36)

####### 이야기용 물건 ########

if (Equal(ScriptMode(), FLAG_ITEM))

	# 크로매틱 크리스탈 — 하데스 테라 (46,48) 이 아니면 반응이 없다 (09 §9.8)
	if (Equal(Item::Used(), "crystal.chromatic"))
		Talk("크리스탈에는 아무런 반응이 없었다.")

# (해결된 NEED) 인물 그림만 놓고 옮기는 연출 — 감독과 병사는 Actor::Show · Move · Hide 로 걷는다.
# 남은 것: 동굴형 타일 표에는 사람 칸이 21번(광부 그림) 하나뿐이라 감독·병사도 광부 그림으로 나온다.
# (원작 확인) 프롤로그의 감독은 사람 칸 21 이 1초에 한 칸씩 (27,33)→(27,38) 로 걷고 (MYSTTAL1.PAS:26~33),
#       살인 누명의 병사는 3부 스프라이트 13 이다 (MYSTSPEC.PAS:568~575).
# (원작 확인) 병사 둘은 0.5초에 한 칸씩 걸어 올라온다 (MYSTSPEC.PAS:568~575 의 delay(500)).
# (원작 확인) 필드가 아닌 곳에서 크리스탈 볼을 쓰면 「크리스탈 볼은 주위가 트인 곳에서만 작동합니다.」 — 엔진(메뉴)이
#       맵 스크립트에 묻기 전에 낸다 (MYSTMENU.PAS:2068~2072).
