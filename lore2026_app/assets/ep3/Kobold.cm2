				DisplayMap()
			else
				Party::Warp(72, 26)                           # 도망치면 남쪽으로 한 칸
			halt

		# 상자 C (76,25) — 천문 O/X 퀴즈 (6문: 아니다 · 맞다 · 맞다 · 아니다 · 아니다 · 맞다)
		if (On(76, 25))
			if (Or(Flag::IsSet("KOBOLD_QUIZ_C_SOLVED"), Flag::IsSet("KOBOLD_MIMIC_C_DEAD")))
				halt
			if (Not(Flag::IsSet("KOBOLD_QUIZ_C_FAILED")))
				if (Equal(bitC, 0))                       # 이 상자는 잠들어 있다
					Talk("당신이 보물상자 앞으로 다가섰지만 상자 위의 두개골은 아무 말도 하지 않았다.")
					halt
				if (Not(Flag::IsSet("KOBOLD_SPEECH")))      # 코볼트 말을 모른다
					Talk("당신이 보물상자 앞으로 다가섰을 때 상자 위의 두개골이 무어라 말을 했지만 전혀 알아들을 수가 없었다.")
					halt
				wrong.assign(0)
				Talk("당신이 보물상자 앞으로 다가섰을 때 상자 위의 두개골이 당신에게 질문을 던졌다.")
				Select::Init()
				Select::Add("달과 지구의 나이는 같거나 지구가 더 많다.")
				Select::Add("맞다")
				Select::Add("아니다")
				Select::Run()
				if (Not(Equal(Select::Result(), 2)))    # 정답: 아니다
					wrong.add(1)
				ClearText()
				Select::Init()
				Select::Add("예전에는 화성과 목성 사이에 혹성이 하나 있었다.")
				Select::Add("맞다")
				Select::Add("아니다")
				Select::Run()
				if (Not(Equal(Select::Result(), 1)))    # 정답: 맞다
					wrong.add(1)
				ClearText()
				Select::Init()
				Select::Add("태양의 나이는 50억 살이다. 80억 년 전에도 지금의 태양 자리에 항성이 있었을 것이다.")
				Select::Add("맞다")
				Select::Add("아니다")
				Select::Run()
				if (Not(Equal(Select::Result(), 1)))    # 정답: 맞다
					wrong.add(1)
				ClearText()
				Select::Init()
				Select::Add("우주의 크기는 변함이 없다.")
				Select::Add("맞다")
				Select::Add("아니다")
				Select::Run()
				if (Not(Equal(Select::Result(), 2)))    # 정답: 아니다
					wrong.add(1)
				ClearText()
				Select::Init()
				Select::Add("태양계 혹성의 순서는 수성, 금성, 지구,... 천왕성, 해왕성, 명왕성의 순서로 일정하다.")
				Select::Add("맞다")
				Select::Add("아니다")
				Select::Run()
				if (Not(Equal(Select::Result(), 2)))    # 정답: 아니다
					wrong.add(1)
				ClearText()
				Select::Init()
				Select::Add("토성을 물에 띄우면 뜬다.")
				Select::Add("맞다")
				Select::Add("아니다")
				Select::Run()
				if (Not(Equal(Select::Result(), 1)))    # 정답: 맞다
					wrong.add(1)
				# 모든 문제에 답한 뒤 한꺼번에 판정한다
				ClearText()
				if (Equal(wrong, 0))
					Talk("보물상자는 스스로 스르륵 열렸다.")
					Item::Give("crystal.flame", 1)
					Notice("화염의 크리스탈 + 1")
					Flag::Set("KOBOLD_QUIZ_C_SOLVED")
					halt
				Flag::Set("KOBOLD_QUIZ_C_FAILED")
			# 미미크 — 틀린 뒤로는 이 칸을 밟을 때마다 덤빈다. 다시 풀 기회는 없다. 덤빌 때마다 변신 서술이 나온다 (MYSTSPEC.PAS:1925~1934)
			Talk("갑자기 보물상자의 양옆에서 팔이 나오고 밑에서 다리가 나오더니 괴물로 변해 당신을 공격하기 시작했다. 당신은 그것이 보물상자의 모습을 하고 있는 미미크라는 것을 금방 알아차렸다.")
			PressAnyKey()
			Battle::Init()
			Battle::RegisterEnemy(46)    # 미미크
			Battle::Start(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE))
			if (Equal(Battle::Result(), BATTLERESULT_WIN))
				Flag::Set("KOBOLD_MIMIC_C_DEAD")
				Map::ChangeTile(77, 25, 43)                # 상자 그림이 사라진다
				DisplayMap()
			else
				Party::Warp(76, 26)                           # 도망치면 남쪽으로 한 칸
			halt

		# 상자 D (80,25) — 프로그래밍 O/X 퀴즈 (5문: 아니다 · 아니다 · 맞다 · 아니다 · 맞다)
		if (On(80, 25))
			if (Or(Flag::IsSet("KOBOLD_QUIZ_D_SOLVED"), Flag::IsSet("KOBOLD_MIMIC_D_DEAD")))
				halt
			if (Not(Flag::IsSet("KOBOLD_QUIZ_D_FAILED")))
				if (Equal(bitD, 0))                       # 이 상자는 잠들어 있다
					Talk("당신이 보물상자 앞으로 다가섰지만 상자 위의 두개골은 아무 말도 하지 않았다.")
					halt
				if (Not(Flag::IsSet("KOBOLD_SPEECH")))      # 코볼트 말을 모른다
					Talk("당신이 보물상자 앞으로 다가섰을 때 상자 위의 두개골이 무어라 말을 했지만 전혀 알아들을 수가 없었다.")
					halt
				wrong.assign(0)
				Talk("당신이 보물상자 앞으로 다가섰을 때 상자 위의 두개골이 당신에게 질문을 던졌다.")
				Select::Init()
				Select::Add("BASIC 언어의 ';'(세미콜론)은 문장의 끝을 의미한다")
				Select::Add("맞다")
				Select::Add("아니다")
				Select::Run()
				if (Not(Equal(Select::Result(), 2)))    # 정답: 아니다
					wrong.add(1)
				ClearText()
				Select::Init()
				Select::Add("Pascal에서 대입 기호는 '='이다.")
				Select::Add("맞다")
				Select::Add("아니다")
				Select::Run()
				if (Not(Equal(Select::Result(), 2)))    # 정답: 아니다
					wrong.add(1)
				ClearText()
				Select::Init()
				Select::Add("C 언어는 영문 소문자를 기본으로 설계되었다.")
				Select::Add("맞다")
				Select::Add("아니다")
				Select::Run()
				if (Not(Equal(Select::Result(), 1)))    # 정답: 맞다
					wrong.add(1)
				ClearText()
				Select::Init()
				Select::Add("FORTRAN은 subroutine 기능이 없다.")
				Select::Add("맞다")
				Select::Add("아니다")
				Select::Run()
				if (Not(Equal(Select::Result(), 2)))    # 정답: 아니다
					wrong.add(1)
				ClearText()
				Select::Init()
				Select::Add("Small Talk, C++, Pascal은 현재 모두 객체지향 프로그래밍을 지원한다.")
				Select::Add("맞다")
				Select::Add("아니다")
				Select::Run()
				if (Not(Equal(Select::Result(), 1)))    # 정답: 맞다
					wrong.add(1)
				# 모든 문제에 답한 뒤 한꺼번에 판정한다
				ClearText()
				if (Equal(wrong, 0))
					Talk("보물상자는 스스로 스르륵 열렸다.")
					# 이름 있는 대원 전원(보조 일원 포함) 체력 +((행운÷5)+1)÷2 — 마법사 계열(family 1)은 체력 대신 정신력
					if (Player::IsAvailable(1))
						inc.assign(Div(Add(Div(Player::GetAttribute(1, "luck"), 5), 1), 2))
						if (Equal(Player::GetAttribute(1, "family"), 1))
							Player::AddAttribute(1, "mentality", inc)
						else
							Player::AddAttribute(1, "strength", inc)
					if (Player::IsAvailable(2))
						inc.assign(Div(Add(Div(Player::GetAttribute(2, "luck"), 5), 1), 2))
						if (Equal(Player::GetAttribute(2, "family"), 1))
							Player::AddAttribute(2, "mentality", inc)
						else
							Player::AddAttribute(2, "strength", inc)
					if (Player::IsAvailable(3))
						inc.assign(Div(Add(Div(Player::GetAttribute(3, "luck"), 5), 1), 2))
						if (Equal(Player::GetAttribute(3, "family"), 1))
							Player::AddAttribute(3, "mentality", inc)
						else
							Player::AddAttribute(3, "strength", inc)
					if (Player::IsAvailable(4))
						inc.assign(Div(Add(Div(Player::GetAttribute(4, "luck"), 5), 1), 2))
						if (Equal(Player::GetAttribute(4, "family"), 1))
							Player::AddAttribute(4, "mentality", inc)
						else
							Player::AddAttribute(4, "strength", inc)
					if (Player::IsAvailable(5))
						inc.assign(Div(Add(Div(Player::GetAttribute(5, "luck"), 5), 1), 2))
						if (Equal(Player::GetAttribute(5, "family"), 1))
							Player::AddAttribute(5, "mentality", inc)
						else
							Player::AddAttribute(5, "strength", inc)
					if (Player::IsAvailable(6))
						inc.assign(Div(Add(Div(Player::GetAttribute(6, "luck"), 5), 1), 2))
						if (Equal(Player::GetAttribute(6, "family"), 1))
							Player::AddAttribute(6, "mentality", inc)
						else
							Player::AddAttribute(6, "strength", inc)
					DisplayStatus()
					Notice("체력 또는 정신력 + 0 에서 + 2")
					Flag::Set("KOBOLD_QUIZ_D_SOLVED")
					halt
				Flag::Set("KOBOLD_QUIZ_D_FAILED")
			# 미미크 — 틀린 뒤로는 이 칸을 밟을 때마다 덤빈다. 다시 풀 기회는 없다. 덤빌 때마다 변신 서술이 나온다 (MYSTSPEC.PAS:1925~1934)
			Talk("갑자기 보물상자의 양옆에서 팔이 나오고 밑에서 다리가 나오더니 괴물로 변해 당신을 공격하기 시작했다. 당신은 그것이 보물상자의 모습을 하고 있는 미미크라는 것을 금방 알아차렸다.")
			PressAnyKey()
			Battle::Init()
			Battle::RegisterEnemy(46)    # 미미크
			Battle::Start(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE))
			if (Equal(Battle::Result(), BATTLERESULT_WIN))
				Flag::Set("KOBOLD_MIMIC_D_DEAD")
				Map::ChangeTile(81, 25, 43)                # 상자 그림이 사라진다
				DisplayMap()
			else
				Party::Warp(80, 26)                           # 도망치면 남쪽으로 한 칸
			halt

		# 말하는 해골 (84,25) — 처음 한 번, 상자의 활성·코볼트 말과 관계없이 일어난다
		# 이 사건이 에인션트 이블 신전의 무덤 앞 결계를 푼다 (KOBOLD_SKULL_WARNED)
		if (On(84, 25))
			if (Not(Flag::IsSet("KOBOLD_SKULL_WARNED")))
				Talk("당신이 앞에 있는 보물상자를 보았을 때 섬찟함을 느끼며 한 걸음 물러섰다. 그 상자 위에는 인간의 해골이 앉아 있었고 그 해골에는 두 눈동자와 머리카락이 듬성듬성 붙어 있었다.")
				Talk("스르르 해골이 고개를 들며 당신을 노려보았다. 당신은 다시 한 걸음을 물러섰다. 그러자 그 해골은 뼈뿐인 두 손을 들어 당신을 가리켰다. 그리고 인간의 말을 하기 시작했다.")
				Say("해골", "당신은 당신들이 지금 하고 있는 일이 어떤 것인지 모르고 있다. 지금 이 시대가 정의라고 생각하는 것을 역사가 반드시 정의라고 평가짓지는 않을 것이다. 당신이 만약 에인션트 이블을 만나지 않았다면 당장 그를 만나보아라. 그를 통해 당신은 진정한 정의를 체험하게 될 것이다. 게다가 너는 ...")
				Talk("그가 이런 말을 하고 있을 때 갑자기 천장을 뚫고 직격뇌진이 그를 강타했다. 당신은 순간적으로 벌어진 이 일을 보고 넋 나간 듯 얼마 동안 있다가 산산이 흩어진 뼈를 보며 방금의 말을 되새겼다.")
				Flag::Set("KOBOLD_SKULL_WARNED")
			# 해골이 앉아 있던 상자 — 다섯째 상자가 활성일 때 한 번. 퀴즈도 코볼트 말도 필요 없다
			# 철퇴는 원작에서 양날 전투 도끼로 들어왔다 (부록 A #8) — 의도대로 철퇴를 준다
			if (And(Equal(bitE, 1), Not(Flag::IsSet("KOBOLD_SKULL_CHEST_OPENED"))))
				Talk("당신은 해골이 걸터앉아 있던 보물상자를 열었다.")
				Item::Give("shield.chromatic", 1)
				Notice("크로매틱 방패 + 1")
				Item::Give("armour.brigandine", 1)
				Notice("브리간디 + 1")
				Item::Give("weapon.mace", 1)
				Notice("철퇴 + 1")
				Flag::Set("KOBOLD_SKULL_CHEST_OPENED")
			halt
		halt

	# ──────── 코볼트킹 전당 (x 61~90, y 85~96) ────────

	# 근위대장 (76,90)·(77,90) — 한 번. 도망치면 남쪽으로 한 칸 밀린다
	if (OnArea(76, 90, 77, 90))
		if (Not(Flag::IsSet("KOBOLD_ROYAL_GUARD_DEAD")))
			Say("근위기사장", "나는 코볼트킹님의 근위대의 대장이다. 내가 살아 있는 한 너희들을 결코 이 안으로 한 발자국도 들여놓지 못할 것이다.")
			Battle::Init()
			Battle::RegisterEnemy(41, 2) # 코볼트성전사 2
			Battle::RegisterEnemy(40)    # 코볼트위저드
			Battle::RegisterEnemy(42)    # 소환주술사
			Battle::RegisterEnemy(44)    # 근위기사장
			Battle::Start(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE))
			if (Equal(Battle::Result(), BATTLERESULT_WIN))
				Flag::Set("KOBOLD_ROYAL_GUARD_DEAD")
			else
				Party::Warp(Party::PosX(), 91)
		halt

	# 코볼트킹 (76,86)·(77,86) — 혼자 싸운다, 적 선공, 반복 (12.4)
	# 도망에 성공해도 결계에 막혀 곧바로 다시 싸우고, 앞에서 입힌 피해가 그대로 남는다 (BATTLE_REPEAT).
	# 이기면 공간이동으로 사라진다 (KOBOLD_KING_FLED)
	if (OnArea(76, 86, 77, 86))
		if (Not(Flag::IsSet("KOBOLD_KING_FLED")))
			Say("코볼트킹", "지상 최상 최대의 마도사인 나, 코볼트킹에게 도전해 오다니 정말 배짱 한번 좋구나. 네놈들은 나 혼자서 상대하겠다. 가소로운 것들...")
			Battle::Init()
			Battle::SetRepeatText("당신은 코볼트킹에게서 도망치려 했지만 그가 만든 결계를 벗어날 수가 없었다.")
			Battle::RegisterEnemy(45)
			Battle::Start(Add(BATTLE_ENEMY_FIRST, Add(BATTLE_NO_PRELUDE, BATTLE_REPEAT)))
			if (Equal(Battle::Result(), BATTLERESULT_WIN))
				Talk("당신이 코볼트킹을 물리쳤구나라고 생각했을 때 코볼트킹은 공간이동의 마법을 써서 어디론가 사라져 버렸다. 당신은 당황해서 이곳 전 지역을 투시해 보았지만 그는 없었다.")
				Flag::Set("KOBOLD_KING_FLED")
		halt

	# ──────── 동문과 동쪽 관문 (y 60~61) ────────

	# 동문 열쇠 칸 (124,60)·(124,61) — 백금 키 + 소환주술사 격파 → 동문 (123,60~61) 이 열리고 (122,60~61) 이 관문 전투 칸이 된다
	if (OnArea(124, 60, 124, 61))
		if (And(Flag::IsSet("KEY_PLATINUM"), Flag::IsSet("KOBOLD_GATE_C")))
			Map::ChangeTileArea(123, 60, 123, 61, 43)
			Map::ChangeTileArea(122, 60, 122, 61, 0)
			DisplayMap()
		halt

	# 동쪽 관문 (122,60)·(122,61) — 한 번. 도망치면 동쪽으로 한 칸 밀린다
	if (OnArea(122, 60, 122, 61))
		if (Not(Flag::IsSet("KOBOLD_GATE_E")))
			Say("코볼트 근위기사", "정말 끈질긴 인간들이군. 번번이 패하면서 또 시비를 걸어 오다니...")
			Battle::Init()
			Battle::RegisterEnemy(39, 6) # 근위기사 6
			Battle::RegisterEnemy(40, 2) # 코볼트위저드 2
			Battle::Start(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE))
			if (Equal(Battle::Result(), BATTLERESULT_WIN))
				Flag::Set("KOBOLD_GATE_E")
			else
				Party::Warp(123, Party::PosY())
		halt

	# ──────── 완전한 암흑 구역 (x 91~121, y 41~80) ────────

	# 미로의 바닥은 거의 모두 숨은 칸이고, 밟으면 완전한 암흑이 된다 (횃불이 꺼진다 · DARKNESS_ZONE).
	# 통로 y 60~61 은 평범한 바닥이라 여기로 오지 않는다 — 네 토막 x 89~91 / 93~105 / 107~118 / 121.
	# 동문 → (121,62) → 남쪽 미로 → (108,75) → 북동 미로 → (105,58) → 통로 가운데 토막 → (93,60) → (91,60)
	# 은 되돌아갈 수 없는 한 방향 길이다. (91,60) 에서 나가는 길은 에메랄드 문뿐이다
	if (OnArea(91, 41, 121, 80))

		# 순간 이동 칸 넷
		# (93,60) → (91,60) — 통로 가운데 토막의 서쪽 끝 → 서쪽 토막. 암흑이 풀린다 (암흑 탈출)
		if (On(93, 60))
			Party::Warp(91, 60)
			Map::SetDark(0)
			Variable::Set("DARKNESS_ZONE", 0)
			DisplayMap()
			halt
		# (119,61) → (121,61) — 통로 동쪽 토막의 끝 → 남쪽 미로 입구 바로 위. 암흑은 그대로
		if (On(119, 61))
			Party::Warp(121, 61)
			DisplayMap()
			halt
		# (103,75) → (107,60) — 남쪽 미로의 되돌이 칸 → 통로 동쪽 토막. 암흑이 풀린다
		if (On(103, 75))
			Party::Warp(107, 60)
			Map::SetDark(0)
			Variable::Set("DARKNESS_ZONE", 0)
			DisplayMap()
			halt
		# (108,75) → (102,49) — 남쪽 미로 → 북동 미로. 암흑은 그대로. 되돌아올 수 없다
		if (On(108, 75))
			Party::Warp(102, 49)
			DisplayMap()
			halt

		# 미로 입구 칸 (91,59) 북서 미로 · (121,62) 남쪽 미로 — 켜고 끄는 칸
		# 밝을 때 밟으면 암흑이 시작되고, 암흑 속에서 밟으면 풀린다
		if (Or(On(91, 59), On(121, 62)))
			if (Equal(Variable::Get("DARKNESS_ZONE"), 1))
				Map::SetDark(0)
				Variable::Set("DARKNESS_ZONE", 0)
			else
				Map::SetDark(1)
				Party::SetTorch(0)
				Variable::Set("DARKNESS_ZONE", 1)
			DisplayMap()
			halt

		# 그 밖의 칸 — 밟으면 암흑 (이미 암흑이어도 횃불을 다시 끈다)
		Map::SetDark(1)
		Party::SetTorch(0)
		Variable::Set("DARKNESS_ZONE", 1)

		# 흑요석키 (91,41) — 북서 미로의 막다른 곳
		if (On(91, 41))
			if (Not(Flag::IsSet("KEY_OBSIDIAN")))
				Talk("당신은 어둠 속에서도 반짝이는 물체를 하나 보았다. 자세히 보니 그것은 흑요석키였고 즉시 그것을 가졌다.")
				Flag::Set("KEY_OBSIDIAN")

		# 통로 여는 칸 (105,58) — 북동 미로. 바로 아래 벽 (105,59) 가 통로가 되어 통로 가운데 토막으로 내려간다
		if (On(105, 58))
			Map::ChangeTile(105, 59, 43)

		# 영혼의 크리스탈 (106,54) — 북동 미로의 벽감. 숨은 장치 (64,25) 가 벽을 열어야 닿는다. 한 번
		# 동료가 있으면 마지막 동료(2~5번 중 가장 뒤 번호)가 알아본다
		if (On(106, 54))
			if (Not(Flag::IsSet("KOBOLD_SOUL_CRYSTAL_TAKEN")))
				Talk("당신은 벽에서 무언가 반짝이는 것이 있어 벽으로 다가갔다. 가까이에서 보니 그것은 수정이었다. 하지만 그 수정은 특이하게도 스스로 희미한 빛을 발하고 있었다. 당신이 수정 속을 들여다보았을 때 소스라치게 놀랄 수밖에 없었다. 그 속에는 형체를 분간하기 힘들 정도의 많은 영혼들이 배회하고 있었다. 그들이 아마 이 희미한 빛을 발하는 것 같았다. 당신이 약간의 힘을 주어 빼어 보니 쉽게 벽에서 떨어져 나왔다.")
				found.assign(0)
				if (Player::IsAvailable(2))
					who.assign(Player::GetName(2))
					found.assign(1)
				if (Player::IsAvailable(3))
					who.assign(Player::GetName(3))
					found.assign(1)
				if (Player::IsAvailable(4))
					who.assign(Player::GetName(4))
					found.assign(1)
				if (Player::IsAvailable(5))
					who.assign(Player::GetName(5))
					found.assign(1)
				if (Equal(found, 1))
					Talk("그걸 보더니 {$who:이/가} 말했다.")
					Say(who, "아니, 이건.... 이건 바로 그 전설 속에서나 논해지던 영혼의 크리스탈임에 틀림없네. 이것은 전 세계에 두 개밖에 존재하지 않는 귀한 것인데 우리가 발견했군.")
				Item::Give("crystal.spirit", 1)
				Flag::Set("KOBOLD_SOUL_CRYSTAL_TAKEN")

		DisplayMap()
		halt

############################################################
# 남은 것
############################################################
# (해결된 NEED) 반복 전투 — 코볼트킹은 BATTLE_REPEAT(도망쳐도 같은 적, 입힌 피해 그대로), 탈출은 BATTLE_RENEW
#       (이기면 새 킹, 도망에 성공해야 끝)로 쓴다. 여덟 번까지 펼쳐 쓴 것을 걷었다.
# (해결된 NEED) Map::IsTile · Map::GetTile — 원작처럼 칸을 읽는다: (8,30) 은 (9,30) 이 푯말인지, (58,101) 은
#       (58,100) 이 늪인지, (48,73) 은 (46,47) 이 용암인지, (64,25) 는 (108,53) 이 닫힌 벽인지, 움직이는 바닥은
#       옮겨 갈 칸이 평범한 바닥(43)인지 본다.
# (해결된 NEED) Map::ReplaceTile — 용암→늪 · 용암→물을 사각형 하나로 쓴다. 원작 맵 데이터와 대조해 줄 단위로
#       적었던 76칸 · 57칸과 같은 칸이 바뀐다.
#
# (원작 확인) 주인공 혼자일 때의 탈출 — 원작도 따로 처리하지 않는다. 탈출 전투는 도망에 성공해야 끝나고
#       (repeat … until party.etc[6] = 2, MYSTSPEC.PAS:1458~1465) 주인공에게는 도망 명령이 없으니 질 때까지 싸운다.
#       바꿀지는 부록 A D20 에서 정한다 — 지금은 원작대로다.
# (원작 확인) 코볼트 말(getbit(11))을 보는 곳은 해골 상자 퀴즈뿐이다. 관문 · 대제사장 · 근위기사장 · 코볼트킹 ·
#       불사의 코볼트킹 대사는 말을 몰라도 나온다(MYSTSPEC.PAS:1449~1456 · 1650~1716 · 1892 · 2295 · 2313).
# (원작 확인) 상자 B · C · D 도 「…두개골이 당신에게 질문을 던졌다.」로 시작한다(MYSTSPEC.PAS:2033 · 2123 · 2195).
# (원작 확인) 미미크는 덤빌 때마다 변신 서술이 나온다 — 서술이 battle1~4 표지 아래에 있다(MYSTSPEC.PAS:1925~1934).
# (원작 확인) 사건 전투는 모두 BattleMode(FALSE,TRUE) — 머리말(적이 출현했다 · 교전/도망) 없이 적이 먼저 친다(16곳).
# (원작 확인) 로드안의 봉인 장면은 성 밖 맵을 불러온 뒤에 나온다(DefaultExit 다음, MYSTSPEC.PAS:1467~1480) — Arrival 로 낸다.
# (원작 확인) 음악은 요새형 공통 곡(Music5.Bgm) — 전용 곡이 있는 맵이 아니면 맵 유형으로 고른다(MYSTSUB.PAS:3021~3037).
# (원작 확인) (105,59) 는 43 이 된다 — PutMap(105,59,43) (MYSTSPEC.PAS:1788).
