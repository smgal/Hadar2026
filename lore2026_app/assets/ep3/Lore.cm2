####### 로어성 (Lore) — 673~674년 ########
# 근거: 기획서 05 §5.2·§5.3 M0·M1·M6·M10 · §5.4 L1·L3 · 06 §6.5 · 10 §10.7 · 13 §13.9 · 14 §2(재판·감옥)·§3·§11 ·
#       15 부록 A #49·D18 · 16 부록 B.3 · 18 부록 D.10, 공략 원고 Lore.md/json
# 시작 (51,94) · 마을형 · 기본 바닥 44 · 무작위 조우 없음 · 마법 제한 없음 · 약초 가게 없음
# 이 맵이 이어받는 장면: 재판(Menace.cm2 의 살인 누명 → (51,36)) · 즉위식(episode.cm2 의 13연전 승리 → (51,36)).
# 엔딩 글은 episode.cm2 에 있다 — 엔딩 B 는 즉위식 끝의 Timer::Set(12, 0), 엔딩 A 는 로드안의 배신 뒤
# LoadScript("E3_UnderGrd", 31, 21) → UnderGrd.cm2 → Dome.cm2 의 에필로그 장면이 Timer::Set(11, 0) 으로 부른다.
#
# 조건에 인자 없는 함수 하나만 쓰면 엔진이 부르지 않고 늘 참으로 본다 — 그런 자리는 And(...) 로 감싼다.

include("common/const.cm2")
variable(stage)

####### 맵에 들어왔다 ########

if (Equal(ScriptMode(), FLAG_MAP))
	Music::Play("lore_castle")
	# 부록 B.3 — 가입한 동료의 자리는 빈 바닥
	if (Flag::IsSet("JOINED_CANOPUS"))
		Map::ChangeTile(41, 10, 44)
	if (Flag::IsSet("JOINED_ALCOR"))
		Map::ChangeTile(22, 50, 44)
	if (Flag::IsSet("JOINED_MIZAR"))
		Map::ChangeTile(22, 54, 44)
	if (Flag::IsSet("JOINED_ANTARES"))
		Map::ChangeTile(18, 38, 44)

	# ---- 재판 (프롤로그의 살인 누명에서 넘어온다. 673년 · 단계 0 · (51,36)) ----
	if (And(Equal(Variable::Get("MAIN_STAGE"), 0), Equal(Time::Year(), 673)))
		# 병사 둘이 주인공 양옆(x=50·52)에 붙어 0.7초에 한 칸씩 로드안 앞 (51,31) 까지 올라간다.
		# 병사는 배우(3부 스프라이트 13, MYSTSPEC.PAS:602~608)다 — 칸을 바꾸지 않으므로 양탄자가 지워지지 않고, 주인공과 함께 걷는다.
		Actor::ShowSprite("병사1", 13, 50, 36)
		Actor::ShowSprite("병사2", 13, 52, 36)
		Party::Face(FACE_UP)
		Screen::FadeIn()
		Wait(700)
		Actor::Move("병사1", 0, -1)
		Actor::Move("병사2", 0, -1)
		Party::Move(0, -1)
		Actor::Wait()
		Wait(540)
		Actor::Move("병사1", 0, -1)
		Actor::Move("병사2", 0, -1)
		Party::Move(0, -1)
		Actor::Wait()
		Wait(540)
		Actor::Move("병사1", 0, -1)
		Actor::Move("병사2", 0, -1)
		Party::Move(0, -1)
		Actor::Wait()
		Wait(540)
		Actor::Move("병사1", 0, -1)
		Actor::Move("병사2", 0, -1)
		Party::Move(0, -1)
		Actor::Wait()
		Wait(540)
		Actor::Move("병사1", 0, -1)
		Actor::Move("병사2", 0, -1)
		Party::Move(0, -1)
		Actor::Wait()
		Talk("로드안이 병사에게 말했다.")
		Say("로드안", "이자는 누구인데 여기로 끌고 왔소?")
		Say("로어성 병사", "이자는 여기 이 창으로 광산업자를 찔러 죽였습니다. 우리 둘이 공교롭게도 이자가 그를 찔렀던 이 창을 뽑아내는 것을 목격하고는 즉시 체포했습니다. 우리들의 견해로는 광산업자와의 금전 관계로 인해 저질러진 살인이라고 보아집니다.")
		# 증거 제시 — 한 병사가 1초 간격으로 (50,29) 까지 나가 창을 내놓고 돌아온다
		Actor::Move("병사1", 0, -1)
		Actor::Wait()
		Wait(840)
		Actor::Move("병사1", 0, -1)
		Actor::Wait()
		Say("로어성 병사", "그리고 이 창을 증거물로 제시하겠습니다.")
		Wait(1000)
		Actor::Move("병사1", 0, 1)
		Actor::Wait()
		Wait(840)
		Actor::Move("병사1", 0, 1)
		Actor::Wait()
		Talk("로드안이 말했다.")
		Say("로드안", "당신은 이곳의 법률을 알고 있겠지요? 범죄 없는 평화로운 세상을 만들기 위해 살인자는 모두 사형 또는 종신형에 처한다는 것도 알고 있을 거요. 당신은 전과가 없기 때문에 사형을 선고하지는 않겠소. 그렇지만 최대한 자비를 베풀어도 종신형은 면치 못할 거요.")
		PressAnyKey()
		# 감옥 (39,10) 으로 — 같은 감방 (41,10) 의 카노푸스가 옆으로 다가와 인사하고 제자리로 돌아간다
		Screen::FadeOut()
		Actor::Hide("병사1")
		Actor::Hide("병사2")
		Party::Warp(39, 10)
		Party::Face(FACE_RIGHT)
		Screen::FadeIn()
		Map::ChangeTile(41, 10, 44)
		Actor::Show("카노푸스", 53, 41, 10)
		Actor::Move("카노푸스", -1, 0)
		Actor::Wait()
		Say("카노푸스", "나의 동료가 한 명 생겼군. 나는 1년 반 전에 절도 상해 혐의로 종신형을 선고받은 카노푸스라고 하네. 우리는 같이 평생을 살 동료이니 잘 지내도록 하지.")
		PressAnyKey()
		Actor::Move("카노푸스", 1, 0)
		Actor::Wait()
		Actor::Hide("카노푸스")
		Map::ChangeTile(41, 10, 53)
		DisplayMap()
		# 약 두 달이 지난다 — 674년 1월 19일 08:00
		Time::Set(674, 1, 19, 8, 0)
		Talk("때는 674년 1월 19일. 당신은 여기서 약 두 달을 지냈다.")
	else
		# ---- 즉위식 (반역 루트 13연전 승리 → 엔딩 B. 로드안의 자리가 비어 있다) ----
		if (Flag::IsSet("LORE_CORONATION"))
			# 즉위식 (MYSTTIME.PAS:340~380) — 로드안의 자리 (51,28) 은 비어 있다
			Map::ChangeTile(51, 28, 42)
			Party::Face(FACE_UP)
			Screen::FadeIn()
			Talk("얼마 후 로어성에는 성대한 의식이 행해졌다.")
			# 알현실 통로를 0.8초에 한 칸씩 걸어 올라가 왕좌 자리 (51,28) 에 서서 아래를 본다
			Wait(800)
			Party::Move(0, -1)
			Wait(640)
			Party::Move(0, -1)
			Wait(640)
			Party::Move(0, -1)
			Wait(640)
			Party::Move(0, -1)
			Wait(640)
			Party::Move(0, -1)
			Wait(640)
			Party::Move(0, -1)
			Wait(640)
			Party::Move(0, -1)
			Wait(640)
			Party::Move(0, -1)
			Party::Face(FACE_DOWN)
			Talk("그것은 바로 새로운 군주를 탄생시키는 자리였다. 진정한 선을 행할 수 있는 자만이 설 수 있는 자리.")
			Wait(1500)
			# 왼쪽에서 한 사람(3부 스프라이트 21)이 (47,28) 에서 (50,28) 까지 0.8초에 한 칸씩 걸어와 1.5초 머문다
			Actor::ShowSprite("경의", 21, 47, 28)
			Wait(800)
			Actor::Move("경의", 1, 0)
			Actor::Wait()
			Wait(640)
			Actor::Move("경의", 1, 0)
			Actor::Wait()
			Wait(640)
			Actor::Move("경의", 1, 0)
			Actor::Wait()
			Wait(640)
			Wait(1500)
			# 왕좌의 당신이 군주의 모습(사람 칸 54)으로 바뀌고, 그 사람은 돌아서서(스프라이트 22) 왼쪽으로 물러간다
			Party::Hide()
			Map::ChangeTile(51, 28, 54)
			Actor::Hide("경의")
			Actor::ShowSprite("경의", 22, 49, 28)
			DisplayMap()
			Wait(800)
			Actor::Move("경의", -1, 0)
			Actor::Wait()
			Wait(640)
			Actor::Move("경의", -1, 0)
			Actor::Wait()
			Wait(640)
			Actor::Hide("경의")
			Talk("그 의식의 주인공은 바로 당신이었다. 새로운 로어 세계의 역사를 창조하는 그 순간을 모든 사람들은 두 손 모아 찬미하였다.")
			PressAnyKey()
			# 엔딩 B (episode.cm2)
			Timer::Set(12, 0)
			halt
		else
			# 다른 맵에서 화면을 어둡게 한 채 넘어왔으면 걷는다. 막이 없으면 아무 일도 없다
			Screen::FadeIn(0)

####### 사람 ########

if (Equal(ScriptMode(), FLAG_TALK))

	# ---- 감옥 (북쪽 가운데) ----

	# (41,10) 카노푸스 — 주인공과 같은 감방. 합류는 문 밖 복도 (46,10) 에서
	if (On(41, 10))
		if (Equal(Variable::Get("MAIN_STAGE"), 0))
			Say("카노푸스", "특별한 일이 없는 한 우리 둘은 평생 여기서 지낼 거요.")
		else
			Say("카노푸스", "나도 자네처럼 모험을 하고 싶소.")

	# (50,11) 간수
	if (On(50, 11))
		Say("간수", "당신은 정말 행운입니다. 로드안님은 한 번 선고 내린 피고인에 대해서는 절대로 사면시켜 주는 일이 없었는데 말입니다.")

	# (53,11) 간수
	if (On(53, 11))
		Say("간수", "당신은 로드안님에 의해서 선택되어진 인간입니다.")

	# (63,9) 사형수 — 화합의 책 저자
	if (On(63, 9))
		Say("사형수", "나는 다른 종족과의 화합에 대한 책을 발간하려다가 사형 선고를 받았습니다. 나는 정말 억울합니다. 로드안님의 말인즉 악을 행하는 다른 종족과의 화합은 악과의 화합을 말하는 것이라는 겁니다. 내가 아는 몇몇의 종족들은 해를 끼치기도 하지만 그것은 그저 그들의 속성일 뿐이지 결코 본성이 악한 것은 아닙니다. 로드안님을 위시한 이곳의 교육 체계는 너무나 선을 강조하며 악을 배척하려 합니다. 하지만 어느 정도의 필요악도 있어야 하며 이런 교육 방식에 의한 평화는 잠시뿐이지 마침내는 자체적으로 붕괴해 버릴 겁니다.")

	# (40,15) 옆방 죄수
	if (On(40, 15))
		Say("죄수", "넌 옆방에 있었던 {주인공} 아냐.")
		Say("죄수", "이제 제법 로드안의 충실한 개가 되었군. 그가 주는 달콤한 사탕에 꼬리를 흔드는 격이라...")

	# (61,15) 좀도둑 사형수
	if (On(61, 15))
		Say("사형수", "나는 전과가 많아서 사형 선고를 받았습니다. 로드안님도 너무하십니다. 범죄 없는 세상을 만드는 것도 좋지만 나 같은 좀도둑에게도 사형을 선고하시다니...")

	# ---- 알현실 (해자 안쪽 가운데) ----

	# (51,28) 로드안 — 메인 진행 단계별 (05 §5.2). 반역 루트에서도 단계 8 대사만 되풀이한다 (부록 A D18)
	if (On(51, 28))
		stage.assign(Variable::Get("MAIN_STAGE"))

		# 단계 2 — 베스퍼성 원정 명령. 황금 +5000, 단계 3
		if (Equal(stage, 2))
			Say("로드안", "나는 베스퍼성 원정에 따른 지원자를 찾고 있었소. 여러 방면으로 수소문한 끝에 당신을 선택하게 된 거요. 만약 당신이 베스퍼성 원정을 성공리에 끝낸다면 당신의 전과는 말끔히 없애 주겠소. 그리고 당신이 원하는 삶을 제공해 줄 의향도 있소. 당신이 주축이 되어 여러 용사들을 합세시킬 수도 있소. 당신이 성공적으로 임무를 완수하기 위한 자금도 주겠소. 베스퍼성의 위치를 잘 모르겠다면 마을 사람들에게 물어보면 될 거요. 다른 성에서 온 원정대와 별개로 행동해도 상관없소. 그리고 내가 다른 성의 성주들에게도 당신에게 호의를 베풀어 주도록 부탁했으니 아프로디테 테라까지 가는 데 별 어려움은 없을 거요. 당신을 믿겠소.")
			Party::PlusGold(5000)
			Notice("황금 + 5000")
			Variable::Set("MAIN_STAGE", 3)

		# 단계 3 — 재촉
		if (Equal(stage, 3))
			Say("로드안", "당신은 아프로디테 테라의 베스퍼성으로 지금 즉시 떠나야 하오.")

		# 단계 4 — 트롤족 토벌 보고. 황금 +40000, 이름 있는 대원 전원(1~6번, 행동 가능 여부 무관) 경험치 +200000, 단계 5
		if (Equal(stage, 4))
			Say("로드안", "{주인공}, 정말 장한 일을 해 주었소.")
			Say("로드안", "이제 당신은 완전한 자유의 몸이오. 이건 나의 성의라오.")
			Party::PlusGold(40000)
			if (Player::IsAvailable(1))
				Player::AddAttribute(1, "exp", 200000)
			if (Player::IsAvailable(2))
				Player::AddAttribute(2, "exp", 200000)
			if (Player::IsAvailable(3))
				Player::AddAttribute(3, "exp", 200000)
			if (Player::IsAvailable(4))
				Player::AddAttribute(4, "exp", 200000)
			if (Player::IsAvailable(5))
				Player::AddAttribute(5, "exp", 200000)
			if (Player::IsAvailable(6))
				Player::AddAttribute(6, "exp", 200000)
			Notice("황금 + 40000")
			Notice("경험치 + 200000")
			Variable::Set("MAIN_STAGE", 5)

		# 단계 5 — 추가 부탁(코볼트·드라코니안). 단계 6
		if (Equal(stage, 5))
			Say("로드안", "당신에게 한 가지 부탁을 더 해도 되겠소? 이 일은 당신과 같은 영웅들만이 할 수 있기 때문에 당신에게 부탁하는 것이오. 아직 이 세계에는 인간 이외에 코볼트족과 드라코니안족이 있소. 그 종족들은 오크나 트롤 같은 하급 종족에 비해서는 월등한 전투력을 가지고 있는 데다가 드라코니안족 같은 경우에 있어서는 우리보다 더 뛰어난 지능과 문화를 가지고 있소. 그들은 2개의 대륙을 차지하고 있으면서 항상 인간들을 배척하고 있기 때문에 인간들의 진출을 방해하는 요소라고 할 수 있소. 만약 그들이 우리들이 있는 대륙을 침범한다면 어떻게 될는지는 충분히 예상될 거요. 특히 드라코니안족이 덤벼든다면 로어 대륙을 제외하고는 모두 전멸될 것이 뻔한 일인 데다가 이곳 역시도 그리 오래는 대항하기 힘들 것이오. 그들이 숭배하고 있는 악의 화신 에인션트 이블이 그들을 선동하여 이곳으로 쳐들어왔을 때를 상상해 봤소? 아마 수천 년을 유지해 오던 이곳의 평화는 산산이 깨어져 버릴 것이오.")
			Variable::Set("MAIN_STAGE", 6)

		# 단계 6 — 선제공격 부탁
		if (Equal(stage, 6))
			Say("로드안", "당신에게 부탁하겠소. 코볼트족과 드라코니안족을 선제공격하여 이곳의 평화를 보장하고 신대륙 개척을 앞당기게 해 주시오. 만약 당신이 그 두 종족을 멸해 준다면 나는 우라누스 테라를 당신에게 넘겨줄 의향도 있소. 제발 부탁하오.")

		# 단계 7 — 귀환 보상과 반란 소식. 황금 +100000, 이름 있는 대원 전원 경험치 +2500000, 반란 발발, 단계 8
		if (Equal(stage, 7))
			Say("로드안", "돌아왔군요. {주인공}.")
			Say("로드안", "역시 내가 보는 눈은 정확했소. 당신이라면 분명히 우리에게 승리를 안겨 줄 거란 걸 알았소. 당신에게 주기로 약속한 우라누스 테라도 곧 당신의 손에 들어갈 거요. 그리고 그때 당신은 그곳의 성주가 되는 것이오.")
			Party::PlusGold(100000)
			if (Player::IsAvailable(1))
				Player::AddAttribute(1, "exp", 2500000)
			if (Player::IsAvailable(2))
				Player::AddAttribute(2, "exp", 2500000)
			if (Player::IsAvailable(3))
				Player::AddAttribute(3, "exp", 2500000)
			if (Player::IsAvailable(4))
				Player::AddAttribute(4, "exp", 2500000)
			if (Player::IsAvailable(5))
				Player::AddAttribute(5, "exp", 2500000)
			if (Player::IsAvailable(6))
				Player::AddAttribute(6, "exp", 2500000)
			Notice("황금 + 100000")
			Notice("경험치 + 2500000")
			Say("로드안", "하지만 그 전에 먼저 할 일이 생겼소. 지금 배리언트 피플즈에서 대대적인 반란이 발생했는데 빨리 진압하지 않으면 다른 성으로까지 번질지도 모르오. 이번의 반란은 나에 대한 반역임과 동시에 선에 대한 도전이라고 받아들이고 있소. 그들의 이런 행위는 여태껏 지켜 온 평화를 깨어 버리려는 에인션트 이블의 마지막 발악인 것 같소.")
			Flag::Set("REBELLION")
			Variable::Set("MAIN_STAGE", 8)

		# 단계 8 — 반란 진압 명령
		if (Equal(stage, 8))
			Say("로드안", "즉시 배리언트 피플즈로 가서 폭동을 진압해 주시오. 당신이 그 일을 끝내고 돌아오면 나는 당신에게 공작의 작위와 함께 우라누스 테라에 당신의 공국을 건설하도록 허락해 주겠소.")

		# 단계 9 (충성 루트) — 공작 작위와 크리스탈 볼. 단계 10
		if (Equal(stage, 9))
			Say("로드안", "당신 덕택에 세상은 완전한 평화를 얻게 되었소. 그리고 약속한 대로 당신에게 우라누스 테라의 통치권과 공작의 칭호를 내려 주겠소.")
			Say("로드안", "축하하오, {주인공} 공작...")
			Say("로드안", "그런데 미안하지만 한 가지 부탁만 더 들어주겠소? 당신이 멸망시킨 네 종족이 사실은 완전히 사라진 게 아니오. 그들은 지금 현재, 죽어 간 그 종족의 의지가 하나로 뭉쳐 자신이 있던 대륙에 원혼이 되어 남아 있소. 그것들 중에서는 스스로의 의지로 이곳을 향해 오는 원혼도 있소. 그 원혼들이 이 대륙에 들어와서 우리에게 복수하기 전에 우리가 먼저 그들을 발견하여 강한 힘 속에 봉인시켜 버려야 하오. 그래서 부탁하건대, 이 크리스탈 볼을 받으시오. 이 크리스탈 볼 속을 들여다보면 오크, 트롤, 코볼트, 드라코니안 종족의 원혼이 있는 장소가 드러날 거요. 그리고 그 장소에서 그들의 원혼을 발견하여 크리스탈 볼 속에 봉인시켜 버리시오. 네 종족을 모두 봉인시켰을 때 그 크리스탈 볼을 나에게 가져오면 그 이후는 내가 알아서 하겠소. 그리고 당신의 영토인 우라누스 테라로 이동시켜 주겠소.")
			Item::Give("crystal.ball", 1)
			Notice("크리스탈 볼 + 1")
			Variable::Set("MAIN_STAGE", 10)

		# 단계 10 — 재촉
		if (Equal(stage, 10))
			Say("로드안", "내가 준 크리스탈 볼을 이용하여 네 종족의 원혼을 모두 그 안에 봉인시켜서 나에게 가져오시오. 꼭 부탁하오.")

		# 단계 11 — 크리스탈 볼 헌상과 배신 (엔딩 A). 주인공이 알현 위치 (51,31) 에 선 채 장면이 진행된다
		if (Equal(stage, 11))
			Party::Warp(51, 31)
			Party::Face(FACE_UP)
			DisplayMap()
			Say("로드안", "오, {주인공} 공작!")
			Say("로드안", "당신은 나의 마지막 부탁까지 훌륭하게 들어주었소. 이제는 당신에게 더 이상 이런 일을 시키지 않겠다고 약속하오. 먼저, 네 종족의 원혼을 봉인한 크리스탈 볼을 이리 주시오.")
			PressAnyKey()
			# 로드안 앞으로 두 칸 나아가 크리스탈 볼을 바치고 물러난다
			Party::Move(0, -1)
			Wait(500)
			Party::Move(0, -1)
			Wait(500)
			Item::Take("crystal.ball", 1)
			Party::Move(0, 1)
			Wait(500)
			Party::Move(0, 1)
			Party::Face(FACE_UP)
			Say("로드안", "이제는 이 수정 구슬을 완전히 봉인해서 다시는 그들의 원혼이 우리를 위협하지 못하게 해야겠소.")
			Talk("로드안의 손에 들린 크리스탈 볼이 가볍게 떠오르기 시작했다. 로드안은 차츰 양손의 기력을 증강시켰고 크리스탈 볼은 붉게 달아오르기 시작했다. 곧이어 크리스탈 볼은 이글거리는 에너지 공으로 변하였다.")
			# 로드안 손 앞 (51,29) 에 에너지 공 (3부 스프라이트 20)
			Actor::ShowSprite("에너지 공", 20, 51, 29)
			Say("로드안", "자, 이제 이것을 아무도 구제할 수 없는 곳으로 보내 버려야겠소. 그곳은 바로 로어 대륙의 지하에 있는 하데스 테라라고들 하는 곳이오.")
			Talk("로드안이 양손을 내리자 에너지 공은 서서히 밑으로 떨어지기 시작했다. 그리고는 바닥에 스며드는 것처럼 땅속으로 사라져 버렸다.")
			Actor::Hide("에너지 공")
			Say("로드안", "그럼, 이제 당신을 우라누스 테라로 보내 주겠소.")
			Say("로드안", "그 전에 당신은 새로운 모습으로 태어날 거요. 그러기 위해서는 당신의 일행들과 나의 신하들이 자리를 피해 줘야만 하오. 그 이유는 차차 알려 드리리다.")
			PressAnyKey()
			# 동료(영구 이탈)와 신하가 모두 물러난다 — 빈 알현실
			if (Player::IsAvailable(5))
				Party::Dismiss(5)
			if (Player::IsAvailable(4))
				Party::Dismiss(4)
			if (Player::IsAvailable(3))
				Party::Dismiss(3)
			if (Player::IsAvailable(2))
				Party::Dismiss(2)
			Party::RemoveAssistant()
			Map::ChangeTile(48, 31, 44)
			Map::ChangeTile(48, 33, 44)
			Map::ChangeTile(48, 35, 44)
			Map::ChangeTile(48, 37, 44)
			Map::ChangeTile(54, 31, 44)
			Map::ChangeTile(54, 33, 44)
			Map::ChangeTile(54, 35, 44)
			Map::ChangeTile(54, 37, 44)
			DisplayMap()
			DisplayStatus()
			Talk("잠시간의 침묵이 흘렀다.")
			Talk("지금 주위에는 아무도 없다는 것을 확인한 로드안은 갑자기 당신을 향해 독심을 사용하기 시작했다. 당신은 긴장을 완전히 풀고 있었던 데다가 로드안의 갑작스런 최면에 말려들어 방어를 할 기회도 없이 그에게 독심술을 당하였다. 당신은 곧 당신의 자유의사를 잃어버렸고 정신이 아득해지기 시작하였다.")
			Say("로드안", "정말 미안하게 됐네, {주인공}.")
			Say("로드안", "당신은 여태껏 나를 위해 일해 주었는데 나는 당신에게 이렇게 할 수밖에는 없다네. 나는 처음부터 이미 당신을 지목하고 있었지. 나와의 관계를 만들기 위해서 당신을 살인죄로 몰았던 것도 나였고, 항상 천리안과 투시로 당신을 감시하던 사람도 바로 나였다네. 지금의 당신은 나 로드안을 제외하고는 명실공히 이 세계 최강의 용사이지. 내가 지금 하려는 이야기를 잘 들어 보게.")
			Say("로드안", "이곳은 현재 너무 평화가 지속되어서 사람들이 현재의 평화를 전혀 고마워할 줄을 모른다네. 그래서 내가 새로운 일을 지금 꾸미려 하지. 그 일이란 어떤 악의 추종자가 이 세계에 나타나 사람들을 위협하고 악을 퍼뜨려서 이 세계의 평화를 말살하려고 할 때 나와 내가 선택한 인물의 활약으로 세계는 다시 평화를 찾게 되고 주민들은 더욱 나에게 감사하며 선을 지키려 노력한다는 내용일세. 이런 일을 내가 꾸몄다는 것을 아무도 알지 못한다면 나는 분명히 평화의 구세주로서의 자리를 확보하게 된다네. 여기서 필요한 사람은 바로 위에서 말한 '악의 추종자'가 될 사람이네. 하지만 아무도 지원하지 않을 거란 건 뻔한 사실이지. 그래서 세계를 위협할 만한 능력을 가진 당신을 이런 식으로 끌어들인 거라네. 당신은 항상 악을 퍼뜨리려 이 세계에 발을 내리지만 번번이 나와 내가 선택한 용사에 의해 패배하게 되지. 그것이 바로 당신이 이제 지게 될 운명이라네. 당신은 이제 스스로의 자유의사에 관계없이 운명에 묶여서 행동하게 될 걸세. 하지만 패배를 너무 의식할 필요는 없네. 최종적인 승리는 당신이 하게 만들어 줄 테니까...")
			Talk("로드안은 말을 마치자 당신을 향해 백색의 가루를 뿌리며 주문을 외우기 시작했다.")
			Screen::Flash()
			# 주인공이 2칸 크기의 네크로만서로 변한다 — 3부 스프라이트 25(위) · 26(아래), 주인공 자리 (51,31) 가 아래 칸
			Party::Hide()
			Actor::ShowSprite("네크로만서 위", 25, 51, 30)
			Actor::ShowSprite("네크로만서 아래", 26, 51, 31)
			Say("로드안", "당신은 이제 악의 추종자로서의 형체를 갖추었다네. 4m가량의 키와 강력한 마력을 겸비한 악의 최대 전투사로서... 당신은 이제 네크로만서란 이름으로 이 세상의 평화가 오래 지속될 때 이 세상을 위협하려 내려올 운명을 가지게 되었다네. 당신은 그때 우라누스 테라를 기점으로 세력을 뻗치게 될 걸세. 그때는 당신이 우라누스 테라의 주인이 될 거라네. 아마 그때서야 내가 당신에게 우라누스 테라를 주겠다는 약속이 지켜질 걸세.")
			Say("로드안", "그럼... 안녕, 네크로만서.")
			# 공간의 틈으로 빠져 사라진다
			Actor::Hide("네크로만서 위")
			Actor::Hide("네크로만서 아래")
			Talk("네크로만서로 변한 당신은 공간의 틈을 통해 다른 공간으로 빠져 버렸다. 그리고 로어 세계의 평화가 너무 오래 유지될 때 당신은 운명에 의해 이 세계로 내려올 것이다.")
			PressAnyKey()
			# 에필로그 — 에너지 공이 하데스 테라를 가로질러 빛의 지붕의 카미너스에게 들어간다.
			# UnderGrd.cm2 → Dome.cm2 의 FLAG_MAP(ALLEGIANCE 1)이 장면을 잇고, 두 악마의 대화와 엔딩 A 는
			# episode.cm2 의 예약 11 이 낸다. 0.5초 페이드 아웃 뒤 하데스 테라로 (부록 D.10) — 에필로그는
			# 그 맵의 FLAG_MAP 안에서 돌므로 UnderGrd.cm2 가 첫머리에서 막을 걷는다
			Screen::FadeOut(500)
			LoadScript("E3_UnderGrd", 31, 21)

	# (48|54, 31·33·35·37) 알현실 병사 8명 — 단계 3 미만 / 이상
	if (OnArea(48, 31, 54, 37))
		if (Less(Variable::Get("MAIN_STAGE"), 3))
			Say("병사", "어서 우리 성주님을 만나 보시지요.")
		else
			Say("병사", "만세, 만세, 만만세, 로드안 만세")

	# (50,51)·(52,51) 성문 병사
	if (Or(On(50, 51), On(52, 51)))
		Say("병사", "당신의 성공을 진심으로 기원합니다.")

	# ---- 훈련장 (북서쪽) ----

	# (12,13) 경험치 훈련장
	if (On(12, 13))
		Shop::ExpTraining()

	# (21,12)·(25,13) 훈련소·마법 학교
	if (Or(On(21, 12), On(25, 13)))
		Shop::Training()

	# ---- 병원 (북동쪽) ----

	# (86,12)·(87,14) 병원
	if (Or(On(86, 12), On(87, 14)))
		Shop::Hospital()

	# ---- 주점 (서쪽) ----

	# (13,27) 입구 종업원 — 주인공 성별에 따라 (gender: 0 남성 · 1 여성)
	if (On(13, 27))
		if (Equal(Player::GetAttribute(1, "gender"), 1))
			Say("종업원", "거기 여성분, 어서 앉으시지요.")
		else
			Say("종업원", "거기 남성분, 어서 앉으시지요.")

	# (18,27) 바텐더
	if (On(18, 27))
		Say("바텐더", "우리 주점의 명물인 코리아 위스키 맛 좀 보시겠습니까?")

	# (21,33) 종업원
	if (On(21, 33))
		Say("종업원", "과음은 삼가십시오.")

	# (18,38) 안타레스 Jr. — 동료 (위저드, 레벨 15). 합류 제의는 독심 중일 때만 나온다
	if (On(18, 38))
		Say("안타레스 Jr.", "자네를 못 볼 줄 알았는데 다시 보게 되었군. 자! 그 기념으로 한 잔 받게나. 완~~~샷!!")
		if (Party::CheckIf(CHECKIF_MINDCONTROL))
			Say("안타레스 Jr.", "당신의 모습을 보니 내가 가이아 테라의 수석 위저드로 있을 때가 생각나는군. 자네를 도와주고픈 마음이 있는데 자네는 어떤가?")
			Select::Init()
			Select::Add("")
			Select::Add("역시 안타레스답군요")
			Select::Add("안됐지만 사양하겠습니다")
			Select::Run()
			if (Equal(Select::Result(), 1))
				if (And(Party::HasFreeSeat()))
					Party::Join("antares_jr")
					if (And(Party::Joined()))
						Flag::Set("JOINED_ANTARES")
						Map::ChangeTile(18, 38, 44)
						DisplayMap()
				else
					Say("안타레스 Jr.", "벌써 사람이 모두 채워져 있군요. 다음 기회를 기다리지요.")

	# (13,32) 술꾼
	if (On(13, 32))
		Say("술꾼", "역시 술은 코리아 위스키(소주)가 최고야.")

	# (15,35) 잠든 손님
	if (On(15, 35))
		Say("손님", "음냐, 음냐, 쿨쿨쿨...")

	# (18,33) 여행자
	if (On(18, 33))
		Say("여행자", "이 세계는 다섯 개의 대륙이 있다고 하더군요.")
		Say("여행자", "로어 대륙, 가이아 테라, 아프로디테 테라, 이쉬도 테라, 우라누스 테라가 있다고 들었습니다.")

	# (10,30) 손님
	if (On(10, 30))
		Say("손님", "만약 당신이 베스퍼성으로 가려 한다면, 가이아 테라를 거쳐 그 성이 있는 아프로디테 테라로 가야 합니다.")

	# ---- 여관 (서쪽, 주점 아래) ----

	# (12,49) 여관 주인
	if (On(12, 49))
		Say("여관 주인", "이 세계의 창시자는 안영기님이시며 그는 위대한 프로그래머입니다.")

	# (15,55) 카노푸스의 어머니 — 카노푸스 미합류 / 합류 후
	if (On(15, 55))
		if (Flag::IsSet("JOINED_CANOPUS"))
			Say("카노푸스의 어머니", "{주인공}님. 제 아들을 잘 부탁합니다.")
		else
			Say("카노푸스의 어머니", "당신이 혹시 내 아들 카노푸스와 같은 감방을 사용했던 {주인공:이/가} 아닌가요?")
			Say("카노푸스의 어머니", "역시 그렇군요. 당신이 베스퍼성으로 원정을 간다는 말을 들었습니다. 만약 여유가 있으시다면 내 아들을 당신의 일행에 참가시켜 주실 수 있겠습니까? 지금은 비록 절도죄로 잡혀 있는 몸이지만 원래 내 아들의 꿈은 로어성 최고의 전사가 되는 것이었습니다. 아마 짐은 되지 않을 것입니다. 제발 부탁합니다.")

	# (22,50) 알코르 — 동료 (검사, 레벨 2)
	if (On(22, 50))
		Say("알코르", "나의 이름은 알코르라고 하오. 나는 이곳의 검사로서 나의 길을 개척하려 하오. 특히 당신과 함께 베스퍼성의 원정을 하고 싶은데 당신 생각은 어떻소?")
		Select::Init()
		Select::Add("")
		Select::Add("그거 좋은 생각이군요")
		Select::Add("미안하지만 그건 좀 어렵군요")
		Select::Run()
		if (Equal(Select::Result(), 1))
			if (And(Party::HasFreeSeat()))
				Party::Join("alcor")
				if (And(Party::Joined()))
					Flag::Set("JOINED_ALCOR")
					Map::ChangeTile(22, 50, 44)
					DisplayMap()
			else
				Say("알코르", "벌써 사람이 모두 채워져 있군요. 다음 기회를 기다리지요.")

	# (22,54) 미자르 — 동료 (기사, 레벨 2)
	if (On(22, 54))
		Say("미자르", "나는 이곳의 기사로 있는 미자르라고 하오. 당신의 임무에 동참한다면 큰 영광으로 여기겠소.")
		Select::Init()
		Select::Add("")
		Select::Add("그럼 그렇게 하시오")
		Select::Add("하지만 그건 좀 곤란하오")
		Select::Run()
		if (Equal(Select::Result(), 1))
			if (And(Party::HasFreeSeat()))
				Party::Join("mizar")
				if (And(Party::Joined()))
					Flag::Set("JOINED_MIZAR")
					Map::ChangeTile(22, 54, 44)
					DisplayMap()
			else
				Say("미자르", "벌써 사람이 모두 채워져 있군요. 다음 기회를 기다리지요.")

	# ---- 무기상점 · 물품 가게 (남서쪽) ----

	# (16,64) 물품 가게
	if (On(16, 64))
		Shop::Goods()

	# (8,71)·(14,69)·(14,73) 무기상점
	if (Or(On(8, 71), On(14, 69), On(14, 73)))
		Shop::Weapon()

	# ---- 식료품점 (남동쪽) ----

	# (91,65)·(94,68)·(87,73) 식료품점
	if (Or(On(91, 65), On(94, 68), On(87, 73)))
		Shop::Grocery()

	# ---- 묘지 (남쪽 동편) ----

	# (72,78) 묘지기
	if (On(72, 78))
		Say("묘지기", "여기는 로어성의 묘지입니다. 함부로 들어가지 마십시오.")

	# (64,76) 예언자 데네브의 묘비 — 아래쪽의 27,6 은 메너스 금광 예언서의 자리.
	# 같은 줄의 다른 묘비 (63·65·67·68·69·71·72·73, 76) 에는 글이 없다
	if (On(64, 76))
		Talk("비석에 어떤 글이 적혀 있었다.")
		Talk("여기는 위대한 예언자 데네브의 묘")
		Talk("620년 8월 30일 여기에 잠들다")
		Talk("당신이 자세히 보니 묘비의 아래쪽에 희미하게 27,6이라고 새겨져 있음을 알았다.")

	# ---- 시민들 ----

	# (80,23) 광부 — 원문은 「남동쪽」이지만 메너스 금광 입구는 남서쪽 (17,89) 이다. 실제에 맞췄다 (부록 A #49)
	if (On(80, 23))
		Say("광부", "나는 대륙의 남서쪽에 있는 메너스 금광에서 일하고 있습니다.")

	# (42,31) 시민
	if (On(42, 31))
		Say("시민", "크리스탈로 소환시킨 몇몇의 생물들은 절대 주인을 배반하지 않는다고 하더군요.")

	# (24,37) 시민
	if (On(24, 37))
		Say("시민", "오크족과 트롤족은 미개 종족이라 우리와는 차원이 틀리지요.")

	# (62,38) 시민
	if (On(62, 38))
		Say("시민", "트롤족에 의한 베스퍼성 침공은 에인션트 이블이 배후 조종한 것이라고 로드안님이 그러시더군요.")

	# (90,42) 시민
	if (On(90, 42))
		Say("시민", "트롤족은 주로 동굴 속에 살며 호전적인 성품을 지녔어요.")

	# (31,64) 시민
	if (On(31, 64))
		Say("시민", "에인션트 이블은 이 세상에 악을 뿌리고 다니는 아주 나쁜 자입니다.")

	# (56,64) 시민
	if (On(56, 64))
		Say("시민", "이 세상에 존재하는 모든 선의 대표자는 로드안님이며 악의 대표자는 에인션트 이블입니다.")

	# (10,73) 시민
	if (On(10, 73))
		Say("시민", "로어 대륙에는 이곳 로어성과 대륙의 남동쪽에 있는 라스트 디치성이 있습니다. 로어성은 지식의 성전이란 뜻이며 라스트 디치성은 최후까지 버티는 자들의 성이란 뜻입니다.")

	# (59,82) 시민
	if (On(59, 82))
		Say("시민", "세상의 악은 모두 응징되어야 합니다. 아마 그건 로드안님만이 할 수 있을 겁니다.")

	# (90,82) 시민
	if (On(90, 82))
		Say("시민", "천신의 대륙과 대지신의 대륙은 큰 산맥을 경계로 나누어져 있다던데요.")

	# (29,79) 남서쪽 전당 안의 인물 — 원작에 대사가 없다. 말을 걸어도 반응이 없다 (부록 A.2)

####### 푯말 ########

if (Equal(ScriptMode(), FLAG_SIGN))

	# (51,84) 성 입구
	if (On(51, 84))
		Talk("이곳은 로어성입니다.")
		Talk("여러분을 환영합니다.")
		Talk("이곳의 성주 로드안 씀")

	# (51,15) 감옥
	if (On(51, 15))
		Talk("로어 왕립 죄수 수용소")

	# (24,31) 주점
	if (On(24, 31))
		Talk("로어 주점")
		Talk("(코리아 위스키 전문점)")

	# (51,58) 광장 게시판 — 반란 발발 후 / 전
	if (On(51, 58))
		if (Flag::IsSet("REBELLION"))
			Talk("이제 우리를 위협하던 네 종족은 정의의 심판에 의해 무릎을 꿇고 말았다. 이제부터는 새로운 인류의 역사가 시작될 것이다.")
		else
			Talk("674년 1월 17일. 아프로디테의 베스퍼성이 호전적인 트롤족에 의해 참변을 당했다.")
			Talk("이를 계기로 로어성과 그 이외의 성들은 오크족, 트롤족, 코볼트족, 드라코니안족에 대한 무차별 정벌을 선포하는 바이다.")
			Talk("이로 인해 인간 이외의 다른 종족에 대한 호의를 일체 중지하며 이제는 적대 관계로 그들을 대할 것이다.")

####### 이벤트 칸 ########

if (Equal(ScriptMode(), FLAG_EVENT))

	# (44,10) 감방 안 문 앞 — 간수의 호출과 사면 (단계 0 → 2). 감방은 닫힌 방이고 이 사건이 유일한 출구다
	if (On(44, 10))
		if (Equal(Variable::Get("MAIN_STAGE"), 0))
			# 간수(사람 칸 53)가 감방 문 앞 줄 (48,10) 에 나타나 1초에 한 칸씩 (46,10) 까지 온다. 배우라서 칸을 바꾸지
			# 않는다 — 복도에 서 있는 간수 (50,11) 은 그대로다 (MYSTSPEC.PAS:270~274)
			Actor::Show("간수", 53, 48, 10)
			Wait(1000)
			Actor::Move("간수", -1, 0)
			Actor::Wait()
			Wait(840)
			Actor::Move("간수", -1, 0)
			Actor::Wait()
			Wait(840)
			Say("간수", "어이, {주인공}. 로드안님이 널 찾으신다. 따라와!")
			PressAnyKey()
			# 감방 문 (45,10) 이 열리고 2초 뒤, 0.8초에 한 칸씩 동쪽으로 걸어 나간다. 간수는 첫걸음에는 서 있다가
			# 주인공 한 칸 앞에서 함께 걷고, (48,10) 에서 사라진다 (MYSTSPEC.PAS:278~287)
			Map::ChangeTile(45, 10, 44)
			DisplayMap()
			Wait(2000)
			Party::Move(1, 0)
			Wait(640)
			Actor::Move("간수", 1, 0)
			Party::Move(1, 0)
			Actor::Wait()
			Wait(640)
			Actor::Move("간수", 1, 0)
			Party::Move(1, 0)
			Actor::Wait()
			Wait(640)
			Actor::Hide("간수")
			Party::Move(1, 0)
			Wait(640)
			# 화면이 닫히고 2초 뒤 알현실. 문은 연출일 뿐 — 감방은 다시 닫힌다
			Screen::FadeOut()
			Map::ChangeTile(45, 10, 7)
			Wait(2000)
			Party::Warp(51, 36)
			Party::Face(FACE_UP)
			# 알현실의 간수는 3부 스프라이트 13 (창을 든 병사). 간수(x=50)와 주인공(x=51)이 0.7초에 한 칸씩 (50~51,31) 까지
			# 올라간다 (MYSTSPEC.PAS:294~302)
			Actor::ShowSprite("간수", 13, 50, 36)
			Screen::FadeIn()
			Wait(700)
			Actor::Move("간수", 0, -1)
			Party::Move(0, -1)
			Actor::Wait()
			Wait(540)
			Actor::Move("간수", 0, -1)
			Party::Move(0, -1)
			Actor::Wait()
			Wait(540)
			Actor::Move("간수", 0, -1)
			Party::Move(0, -1)
			Actor::Wait()
			Wait(540)
			Actor::Move("간수", 0, -1)
			Party::Move(0, -1)
			Actor::Wait()
			Wait(540)
			Actor::Move("간수", 0, -1)
			Party::Move(0, -1)
			Actor::Wait()
			# 로드안의 사면 제의
			Say("로드안", "음.. 당신이 {주인공}(이)라는 사람이오?")
			Say("로드안", "내가 당신을 특별히 부른 이유는 다름이 아니라 당신을 특별 사면시켜 주려는 의도에서라오.")
			Say("로드안", "당신이 살인죄로 잡혀 오기 전까지는 주위 사람들에게 매우 인정받은 용감한 사람이었다는 것을 알고 있소. 내가 지금 부탁하는 몇 가지를 들어준다면 당신에게 그 대가로 자유로운 삶을 보장하겠소.")
			PressAnyKey()
			# 간수가 남쪽으로 물러간다 — 0.7초에 한 칸씩 (50,36) 까지 내려가 사라진다 (MYSTSPEC.PAS:315~320)
			Actor::Move("간수", 0, 1)
			Actor::Wait()
			Wait(540)
			Actor::Move("간수", 0, 1)
			Actor::Wait()
			Wait(540)
			Actor::Move("간수", 0, 1)
			Actor::Wait()
			Wait(540)
			Actor::Move("간수", 0, 1)
			Actor::Wait()
			Wait(540)
			Actor::Move("간수", 0, 1)
			Actor::Wait()
			Wait(540)
			Actor::Hide("간수")
			DisplayMap()
			# 베스퍼성 참변 설명 — 원작은 서술 색으로 내지만 로드안의 대사다
			Say("로드안", "674년 1월 17일 날, 로어 세계에서는 커다란 참변이 있었소. 당신은 이전에도 인류와 타 종족 간에 사이가 안 좋았다는 것을 기억할 거요. 또한 사소한 영토 분쟁이 많았던 것도 사실이오. 그런데 바로 이날 수백 년의 역사를 지닌 아프로디테 테라의 베스퍼성이 트롤족에 의해 완전히 함락당했던 것이오. 거기서 가까스로 탈출한 사람들의 말을 빌면 그날 베스퍼성은 처절한 절규와 아비규환 속에서 아이들이나 부녀자 할 것 없이 모두 처참히 죽어 갔다고 하오. 트롤족은 시체가 즐비한 거리에서 환각 작용제를 맞으며 광적인 살인을 계속 해 대었다고 하는 탈출자의 말을 듣고 나는 분을 참지 못해 모든 성주들을 불러서 타 종족과의 전쟁을 결의했소. 이렇게 함으로써 베스퍼성에서 죽어 간 사람들의 원혼을 달래 주려는 의도라오.")
			# 사면 — 단계 2. 이때부터 메너스 금광의 출구가 평범한 출구가 된다
			Flag::Set("PARDONED")
			Variable::Set("MAIN_STAGE", 2)

	# (46,10) 감방 문 밖 복도 — 카노푸스 석방. 사면 뒤 · 미합류 · 반란 발발 전 · 빈자리가 있을 때만 (없으면 아무 일도 없다)
	if (On(46, 10))
		if (And(GreaterEqual(Variable::Get("MAIN_STAGE"), 2), Not(Flag::IsSet("JOINED_CANOPUS")), Not(Flag::IsSet("REBELLION")), Party::HasFreeSeat()))
			# 카노푸스가 감방 안 문 앞 (44,10) 까지 다가온다
			Map::ChangeTile(41, 10, 44)
			Map::ChangeTile(42, 10, 53)
			DisplayMap()
			Wait(500)
			Map::ChangeTile(42, 10, 44)
			Map::ChangeTile(43, 10, 53)
			DisplayMap()
			Wait(500)
			Map::ChangeTile(43, 10, 44)
			Map::ChangeTile(44, 10, 53)
			DisplayMap()
			Say("카노푸스", "{주인공}.")
			Say("카노푸스", "나도 역시 자네처럼 베스퍼성으로 가고 싶네. 이런 감옥에서 평생을 지내느니 한번 모험을 해 보는 게 좋을 것 같아서 말이지. 나는 전사로서의 교육도 받았으니 아마 자네 일원 중에서는 가장 전투력이 뛰어날 걸세.")
			Select::Init()
			Select::Add("")
			Select::Add("역시 카노푸스 자네뿐이야")
			Select::Add("자네 도움까지는 필요 없다네")
			Select::Run()
			if (Equal(Select::Result(), 1))
				# 간수가 제자리 (50,11) 에서 복도를 따라 1.5초에 한 칸씩 (46,11) 까지 온다 (MYSTSPEC.PAS:367~373)
				Map::ChangeTile(50, 11, 44)
				Actor::Show("간수", 53, 50, 11)
				DisplayMap()
				Actor::Move("간수", -1, 0)
				Actor::Wait()
				Wait(1340)
				Actor::Move("간수", -1, 0)
				Actor::Wait()
				Wait(1340)
				Actor::Move("간수", -1, 0)
				Actor::Wait()
				Wait(1340)
				Actor::Move("간수", -1, 0)
				Actor::Wait()
				Wait(1340)
				Say("간수", "그렇다면 카노푸스도 당신과 같은 목적을 가진다는 이유로 사면시켜 달라는 얘기군요. 그럼 로드안님에게 물어보고 오겠습니다.")
				PressAnyKey()
				# 로드안에게 간다 — 0.5초에 한 칸씩 (50,11) 까지 가서 사라진다 (MYSTSPEC.PAS:378~382)
				Actor::Move("간수", 1, 0)
				Actor::Wait()
				Wait(340)
				Actor::Move("간수", 1, 0)
				Actor::Wait()
				Wait(340)
				Actor::Move("간수", 1, 0)
				Actor::Wait()
				Wait(340)
				Actor::Move("간수", 1, 0)
				Actor::Wait()
				Wait(340)
				Actor::Hide("간수")
				# 화면이 어두워지고 30분이 흐른다
				Screen::FadeOut()
				Time::Pass(0, 30)
				Talk("그로부터 30분이 지났다.")
				PressAnyKey()
				Screen::FadeIn()
				# 간수가 (50,11) 에서 1초에 한 칸씩 돌아온다 (MYSTSPEC.PAS:388~392)
				Actor::Show("간수", 53, 50, 11)
				Wait(1000)
				Actor::Move("간수", -1, 0)
				Actor::Wait()
				Wait(840)
				Actor::Move("간수", -1, 0)
				Actor::Wait()
				Wait(840)
				Actor::Move("간수", -1, 0)
				Actor::Wait()
				Wait(840)
				Actor::Move("간수", -1, 0)
				Actor::Wait()
				Wait(840)
				Say("간수", "카노푸스를 풀어 줘도 좋다고 로드안님이 허락하셨습니다. 정말 희한한 일입니다. 예전에는 전혀 없던 일인데... 어쨌든 카노푸스는 이제 자유의 몸입니다.")
				PressAnyKey()
				# 감방 문이 열리고 1초 뒤 카노푸스가 문 칸 (45,10) 으로 나와 1초 뒤 합류한다 (전사, 레벨 5, MYSTSPEC.PAS:398~403).
				# 감방 안 칸은 다시 숨은 이벤트 칸으로
				Map::ChangeTile(45, 10, 44)
				DisplayMap()
				Wait(1000)
				Map::ChangeTile(44, 10, 0)
				Actor::Show("카노푸스", 53, 45, 10)
				DisplayMap()
				Wait(1000)
				Actor::Hide("카노푸스")
				Party::Join("canopus")
				if (And(Party::Joined()))
					Flag::Set("JOINED_CANOPUS")
				else
					Map::ChangeTile(41, 10, 53)
				# 문이 닫히고 간수는 제자리 (50,11) 로 돌아간다
				Actor::Hide("간수")
				Map::ChangeTile(45, 10, 7)
				Map::ChangeTile(50, 11, 53)
				DisplayMap()
			else
				# 카노푸스가 제자리 (41,10) 로 돌아간다. 다시 밟으면 같은 부탁을 한다
				Map::ChangeTile(44, 10, 0)
				Map::ChangeTile(43, 10, 53)
				DisplayMap()
				Wait(500)
				Map::ChangeTile(43, 10, 44)
				Map::ChangeTile(42, 10, 53)
				DisplayMap()
				Wait(500)
				Map::ChangeTile(42, 10, 44)
				Map::ChangeTile(41, 10, 53)
				DisplayMap()

	# (49~53,95) 남문 출구 줄 → 로어 대륙 (20,12)
	if (OnArea(49, 95, 53, 95))
		Ask("여기서 나가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E3_Ground1", 20, 12)
		else
			WarpPrevPos()

	# (21,36) 주점 안 · (59~62,14)·(59,15)·(59,16)·(61,16) 오른쪽 아래 감방 안의 이벤트 칸 —
	# 원작에 처리가 없다. 밟아도 아무 일이 없다 (부록 A.4)

####### 이야기용 물건 ########

if (Equal(ScriptMode(), FLAG_ITEM))

	# 크로매틱 크리스탈 — 하데스 테라 (46,48) 이 아니면 반응이 없다 (09 §9.8)
	if (Equal(Item::Used(), "crystal.chromatic"))
		Talk("크리스탈에는 아무런 반응이 없었다.")

# (해결된 NEED) 인물 그림만 놓고 옮기는 연출 — 재판의 병사 · 사면의 간수 · 카노푸스는 Actor::Show · Move · Hide 로 걷는다.
#       칸을 바꾸지 않으므로 양탄자(42·43)와 복도 바닥을 되돌릴 필요가 없다.
# (해결된 NEED) 엔딩 A 의 변신 연출 — 흰 가루(Screen::Flash) 뒤 주인공 그림을 감추고 2칸 크기의 네크로만서
#       (3부 스프라이트 25·26)를 세웠다가 공간의 틈으로 사라지게 한다. 에너지 공은 3부 스프라이트 20 (2026-11-16 원작자 확인).
# (해결된 NEED) Timer::Set(n, 0) 은 건 스크립트가 끝나는 대로 울린다 — 즉위식(FLAG_MAP)이 끝나면 엔딩 B 가 바로 나온다.
# (해결된 NEED) 「페이드 아웃(0.5초) → 하데스 테라」(부록 D.10, 엔딩 A) — Screen::FadeOut(500) 뒤 LoadScript, UnderGrd.cm2 의
#       에필로그 첫머리가 막을 걷는다. 겹침 전환은 아직 없다.
# (원작 확인) 사면의 간수는 감방 문 앞 줄 (48→46,10) 을 1초에 한 칸씩 오고, 주인공 한 칸 앞에서 0.8초에 한 칸씩
#       동쪽으로 걷는다(MYSTSPEC.PAS:270~287). 석방의 간수는 복도 (50→46,11) 를 1.5초에 한 칸씩 왔다가 0.5초에 한 칸씩
#       돌아가고, 30분 뒤 1초에 한 칸씩 다시 온다(MYSTSPEC.PAS:367~392). 알현실의 간수는 스프라이트 13.
# (원작 확인) 재판·사면 모두 알현실 (51,36) 에서 (51,31) 까지 0.7초에 한 칸씩 올라간다 (MYSTSPEC.PAS:294~302 · 600~608).
# (원작 확인) 즉위식 — 기획서의 「좌우에서 인물들이 차례로」와 달리 원작은 왼쪽에서 한 사람(스프라이트 21)이 (47,28)→(50,28)
#       로 걸어왔다가, 왕좌가 사람 칸 54 로 바뀐 뒤 돌아서서(스프라이트 22) 물러간다 (MYSTTIME.PAS:350~375).
# (원작 확인) 필드가 아닌 곳에서 크리스탈 볼을 쓰면 「크리스탈 볼은 주위가 트인 곳에서만 작동합니다.」 — 엔진(메뉴)이
#       맵 스크립트에 묻기 전에 낸다 (MYSTMENU.PAS:2068~2072).
