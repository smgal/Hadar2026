####### 라스트디치성 (LastDtch) ########
# 근거: 기획서 05 §5.3 M2 · §5.7(트롤 글) · 06 §6.7 · 10 §10.7 · 14 §5 · 16 부록 B.3, 공략 원고 LastDtch.md/json
# 시작 (38,69) · 게이트 도착 (38,9) · 마을형 · 기본 바닥 47 · 무작위 조우 없음 · 마법 제한 없음 · 물품 가게 없음
# 795년에는 들어올 수 없다 — 이방인이라며 쫓아내는 것은 로어 대륙의 입구 (76,57) 다 (Ground1.cm2).
#
# 조건에 인자 없는 함수 하나만 쓰면 엔진이 부르지 않고 늘 참으로 본다 — 그런 자리는 And(...) 로 감싼다.

include("common/const.cm2")

####### 맵에 들어왔다 ########

if (Equal(ScriptMode(), FLAG_MAP))
	Music::Play("town")
	# 다른 맵에서 화면을 어둡게 한 채 넘어왔으면 걷는다. 막이 없으면 아무 일도 없다
	Screen::FadeIn(0)
	# 부록 B.3 — 가입한 동료의 자리는 빈 바닥 (게이트로 돌아왔을 때도 같다)
	if (Flag::IsSet("JOINED_ALTAIR"))
		Map::ChangeTile(61, 58, 47)
	if (Flag::IsSet("JOINED_VEGA"))
		Map::ChangeTile(34, 30, 47)

####### 사람 ########

if (Equal(ScriptMode(), FLAG_TALK))

	# ---- 성주 홀 ----

	# (38,17) 성주 — 트롤킹 처치 전 / 후
	if (On(38, 17))
		if (Flag::IsSet("TROLL_KING_DEAD"))
			Say("라스트디치 성주", "당신은 역시 로드안이 지목한 용사답소. 정말 훌륭한 일을 해내었소.")
		else
			Say("라스트디치 성주", "나는 로드안에게서 당신이 여기로 온다는 소식을 들었소. 유감스럽게도 우리 성의 원정대는 벌써 떠났다오. 당신도 빨리 뒤따라갔으면 하오. 성안의 북쪽에 가이아 테라로 통하는 게이트가 있소. 그곳으로 들어가면 가이아 테라로 이동될 것이오. 돌아오는 방법도 마찬가지라오. 부디 성공하기를 빌겠소.")

	# (36,19) 주민
	if (On(36, 19))
		Say("주민", "이 세상에서 로드안만큼 칭송받는 인물도 드물 겁니다. 그는 항상 선의 선봉에 서서 주민들을 악으로부터 지켜 내고 있으니까요.")

	# (36,21) 주민
	if (On(36, 21))
		Say("주민", "'테라'라고 하는 말은 라틴어로 대륙이란 뜻이지요.")

	# (41,18) 주민
	if (On(41, 18))
		Say("주민", "라스트 디치성과 배리언트 피플즈성은 생김새가 똑같습니다.")

	# (41,20) 주민
	if (On(41, 20))
		Say("주민", "이 성안에 있는 게이트는 가이아 테라의 배리언트 피플즈라는 성으로 통해 있습니다.")

	# (41,22) 주민
	if (On(41, 22))
		Say("주민", "으윽! 요즘에도 음악 제어하기 힘든 파스칼 언어로 게임을 만드는 무식한 사람이 있다니.")

	# (34,30) 베가 — 동료 (컨져러, 레벨 4, 여성). 음유시인
	if (On(34, 30))
		Say("베가", "나의 이름은 내가 가진 이 하프에서 유래된 베가라고 하며 현재는 이곳의 음유시인으로 있습니다. 나는 원래 이곳저곳을 돌아다니는 성미라서 계속 이곳에 머무르는 것은 매우 답답합니다. 그래서 당신과 함께 여행하고 싶습니다.")
		Select::Init()
		Select::Add("")
		Select::Add("좋소, 허락하지요")
		Select::Add("우리가 하는 일은 너무 위험해서...")
		Select::Run()
		if (Equal(Select::Result(), 1))
			if (And(Party::HasFreeSeat()))
				Party::Join("vega")
				if (And(Party::Joined()))
					Flag::Set("JOINED_VEGA")
					Map::ChangeTile(34, 30, 47)
					DisplayMap()
			else
				Say("베가", "벌써 사람이 모두 채워져 있군요. 다음 기회를 기다리지요.")

	# (37,41)·(40,41) 주민 — 성주 홀 입구
	if (Or(On(37, 41), On(40, 41)))
		Say("주민", "... ...")

	# ---- 북서쪽 방 ----

	# (18,19) 경험치 훈련장
	if (On(18, 19))
		Shop::ExpTraining()

	# (16,24)·(24,19) 훈련소·마법 학교
	if (Or(On(16, 24), On(24, 19)))
		Shop::Training()

	# ---- 북동쪽 방 · 동쪽 방 ----

	# (57,17)·(54,20)·(58,22) 식료품점
	if (Or(On(57, 17), On(54, 20), On(58, 22)))
		Shop::Grocery()

	# (60,42) 주민
	if (On(60, 42))
		Say("주민", "내가 전에 어떤 모험가를 통해서 얼핏 들었는데 이 세계에는 모두 여섯 개의 테라가 있다고 들었습니다.")

	# (61,46) 주민
	if (On(61, 46))
		Say("주민", "정말 로드안은 선의 상징입니다. 이번에도 사건이 터지자마자 악을 무찌르기 위해서 노력을 다했으니까 말입니다.")

	# ---- 아래층 홀 서쪽 ----

	# (17,56)·(17,60) 병원
	if (Or(On(17, 56), On(17, 60)))
		Shop::Hospital()

	# (17,58) 약초 가게 — 674년의 로어 대륙에서 약초를 파는 유일한 곳
	if (On(17, 58))
		Shop::Herb()

	# (21,61) 베스퍼성 생존자 — 트롤 글 교사. 독심 중 · 트롤 글 미습득 · 트롤킹이 살아 있을 때만 가르친다
	if (On(21, 61))
		if (Flag::IsSet("TROLL_KING_DEAD"))
			# 트롤킹 처치 후 — 감사 인사만 하고 가르치지 않는다
			Say("베스퍼 생존자", "베스퍼성에 대한 복수를 해 주셔서 대단히 감사합니다.")
		else
			if (And(Party::CheckIf(CHECKIF_MINDCONTROL), Not(Flag::IsSet("TROLL_SCRIPT"))))
				Say("베스퍼 생존자", "원하신다면 제가 트롤의 글을 가르쳐 드리죠. 식량 50개만 주시면 일주일 안에 모두 가르쳐 드리겠습니다.")
				Select::Init()
				Select::Add("")
				Select::Add("그에게 트롤의 글을 배운다")
				Select::Add("그의 제안을 거절한다")
				Select::Run()
				if (Equal(Select::Result(), 1))
					if (Less(Party::Food(), 50))
						Say("베스퍼 생존자", "하지만 당신에게는 충분한 식량이 없군요.")
					else
						# 식량 50 소모, 7일(168시간) 경과, 트롤 글 습득
						Party::PlusFood(-50)
						Screen::FadeOut(300)
						Time::Pass(168, 0)
						Flag::Set("TROLL_SCRIPT")
						Talk("당신은 그에게 일주일간 트롤의 글을 배웠다.")
						Talk("이제 당신은 트롤의 글을 읽고 쓸 수 있게 되었다.")
						PressAnyKey()
						Screen::FadeIn(300)
			else
				Say("베스퍼 생존자", "저는 베스퍼성에서 이곳으로 가까스로 탈출해 왔습니다. 아마 베스퍼성의 생존자는 아무도 없을 것입니다. 나는 내 눈으로 나의 아내와 어린 자식이 트롤족의 곤봉에 죽어 가는 것을 봤습니다. 나는 차마 그곳을 떠나고 싶지는 않았지만 이 소식을 다른 대륙에 알리기 위해 겨우 탈출에 성공하여 여기서 치료를 받고 있습니다.")

	# ---- 아래층 홀 동쪽 ----

	# (59,56)·(59,58)·(59,60) 무기상점
	if (Or(On(59, 56), On(59, 58), On(59, 60)))
		Shop::Weapon()

	# (61,58) 알타이르 — 동료 (투사, 레벨 3). 무기상점 점원
	if (On(61, 58))
		Say("알타이르", "나의 이름은 알타이르라고 하오. 독수리 같은 용맹을 지녔다는 뜻이지요. 나는 이 무기상점에서 일하면서 파이터로서의 기술을 연마했소. 만약 당신이 나를 필요로 한다면 기꺼이 도와주겠소.")
		Select::Init()
		Select::Add("")
		Select::Add("나에게는 당신 같은 사람이 필요하오")
		Select::Add("그럴 필요까지는 없소")
		Select::Run()
		if (Equal(Select::Result(), 1))
			if (And(Party::HasFreeSeat()))
				Party::Join("altair")
				if (And(Party::Joined()))
					Flag::Set("JOINED_ALTAIR")
					Map::ChangeTile(61, 58, 47)
					DisplayMap()
			else
				Say("알타이르", "벌써 사람이 모두 채워져 있군요. 다음 기회를 기다리지요.")

	# (56,59) 주민 — 안타레스 소문
	if (On(56, 59))
		Say("주민", "전갈의 심장을 상징하는 이름을 가진 안타레스라는 자의 마법 능력은 정말 대단했습니다.")
		Say("주민", "한때, 가이아 테라성의 수석 위저드로서 지상 최대의 공격 마법을 구사하더군요. 약 몇 년 전에 이곳에 머물렀던 적이 있습니다.")

####### 푯말 ########

if (Equal(ScriptMode(), FLAG_SIGN))

	# (39,8) 게이트 안내
	if (On(39, 8))
		Talk("이곳은 가이아 테라로 통하는 게이트입니다.")

	# (39,68) 성 입구
	if (On(39, 68))
		Talk("선을 위해서라면 어떤 위험이나 어려움에도 굴하지 않는 사람들이 있는 곳, 라스트 디치.")
		Talk("여러분을 환영합니다.")
		Talk("이곳의 성주로부터")

####### 입구 ########

if (Equal(ScriptMode(), FLAG_ENTER))

	# (38,10)·(39,10) 가이아 게이트 — 반란 발발 전: 배리언트 피플즈성 (38,9) / 반란 발발 뒤: 빛의 성 (38,9). 조건 없음
	if (OnArea(38, 10, 39, 10))
		Ask("가이아 게이트에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			# 게이트 통과 — 0.3초 페이드 아웃 뒤 새 맵 (부록 D). 막은 맵을 옮긴 뒤 엔진이 걷는다
			Screen::FadeOut(300)
			if (Flag::IsSet("REBELLION"))
				LoadScript("E3_Light", 38, 9)
			else
				LoadScript("E3_Valiant", 38, 9)

####### 이벤트 칸 ########

if (Equal(ScriptMode(), FLAG_EVENT))

	# (37~40,70) 남문 출구 줄 → 로어 대륙 (77,57)
	if (OnArea(37, 70, 40, 70))
		Ask("여기서 나가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E3_Ground1", 77, 57)
		else
			WarpPrevPos()

####### 이야기용 물건 ########

if (Equal(ScriptMode(), FLAG_ITEM))

	# 크로매틱 크리스탈 — 하데스 테라 (46,48) 이 아니면 반응이 없다 (09 §9.8)
	if (Equal(Item::Used(), "crystal.chromatic"))
		Talk("크리스탈에는 아무런 반응이 없었다.")

# (해결된 NEED) 게이트 전환 — Screen::FadeOut(300) 뒤 LoadScript. 맵을 옮긴 뒤 엔진이 막을 걷는다 (부록 D).
#       두 풍경이 겹치는 전환(13 §13.9)은 아직 없다 — 어두워졌다가 밝아진다.
# (원작 확인) 트롤 글 교습은 날짜만 7일 넘기고 시각은 그대로, 식량 50 (party.day + 7, MYSTTALK.PAS:40~46) — Time::Pass(168, 0) 과 같다.
# (원작 확인) 필드가 아닌 곳에서 크리스탈 볼을 쓰면 「크리스탈 볼은 주위가 트인 곳에서만 작동합니다.」 — 엔진(메뉴)이
#       맵 스크립트에 묻기 전에 낸다 (MYSTMENU.PAS:2068~2072).
