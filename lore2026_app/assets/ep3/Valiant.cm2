####### 배리언트 피플즈성 (Valiant) — 반란 전 ########
# 근거: 기획서 06 §6.9 · 14 §6.1 · 16 부록 B.3 · 10 §10.7, 공략 원고 Valiant.md/json
# 시작 (38,69) · 게이트 도착 (38,9) · 마을형 · 기본 바닥 47 · 무작위 조우 없음 · 마법 제한 없음
# 반란 소식(REBELLION) 뒤에는 이 맵 대신 Light.cm2 가 쓰인다 — 갈라 주는 쪽은 들어오는 맵이다
# (Ground2 (19,26) · LastDtch 게이트).

include("common/const.cm2")

####### 맵에 들어왔다 ########

if (Equal(ScriptMode(), FLAG_MAP))
	Music::Play("town")
	# 부록 B.3 — 가입한 동료의 자리는 빈 바닥
	if (Flag::IsSet("JOINED_ALGOL"))
		Map::ChangeTile(17, 24, 47)
	if (Flag::IsSet("JOINED_PROXIMA"))
		Map::ChangeTile(56, 40, 47)

####### 사람 ########

if (Equal(ScriptMode(), FLAG_TALK))

	# ---- 대전 ----

	# (38,17) 성주 — 코볼트 봉인 뒤 · 드라코니안 멸망 전에는 우라누스 게이트를 연다
	if (On(38, 17))
		if (And(Flag::IsSet("KOBOLD_SEALED"), Not(Flag::IsSet("DRACONIAN_DESTROYED"))))
			Say("배리언트 피플즈 성주", "당신의 위용은 모두 전해 들었소. 인류를 위협하는 세 종족을 없애고 마지막 남은 우라누스 테라의 드라코니안족을 벌하러 간다고 들었소. 나에게는 우라누스 게이트를 여는 마법이 있소. 그럼 당신을 우라누스 테라로 보내 드리리다.")
			PressAnyKey()
			# 되묻지 않고 곧바로 보낸다. 도착은 우라누스 테라 (25,11) — 부록 A #31 의 의도된 좌표
			LoadScript("E3_Ground5", 25, 11)
		else
			Say("배리언트 피플즈 성주", "나의 성 배리언트 피플즈에 오신 것을 대단히 환영하오. 우리 성의 이름에서 알 수 있듯이 이곳의 사람들은 진정한 용기에서 오는 참다운 용기를 아주 높이 평가하고 있소. 당신같이 용기 있는 자들이라면 이 성 어느 곳에서도 환영을 받을 것이오.")

	# (36,19) 주민
	if (On(36, 19))
		Say("주민", "고대 최강의 마법사였던 레드 안타레스의 아들이 시공간을 넘어 이 세계 어딘가에서 살고 있다고 들었습니다.")

	# (41,19) 주민 — 트롤킹 처치 전/후
	if (On(41, 19))
		if (Flag::IsSet("TROLL_KING_DEAD"))
			Say("주민", "당신이 트롤족을 멸한 것은 후세에 오점으로 남을 것입니다.")
		else
			Say("주민", "제 생각에는 당신이 지금 하려고 하는 일이 옳지 않다고 봅니다. 비록 트롤족이 야만스럽고 호전적이라고는 하지만 아무런 이유 없이 베스퍼성을 침공하려 했겠습니까? 당신은 지금 원인은 모른 채 결과만을 가지고 분개하고 있다는 생각을 안 하십니까? 좀 더 깊이 알아보고 행동하는 것이 진정한 용기라고 봅니다.")

	# (36,21) 주민 — 코볼트 정벌 전/후
	if (On(36, 21))
		if (Flag::IsSet("KOBOLD_SEALED"))
			Say("주민", "당신 덕분에 이제는 이쉬도 테라에도 인간의 문명을 뻗칠 수 있게 되었습니다.")
		else
			Say("주민", "이쉬도 테라에는 아직 인류의 문명이 뻗치지 못했습니다. 거기에는 코볼트족이 지배하고 있기 때문에 아무도 접근하지 못했던 것입니다. 가기만 하면 번번이 쫓겨 나오곤 하니까요.")

	# (41,21) 주민 — 크리스탈 이야기
	if (On(41, 21))
		Say("주민", "세상에는 크리스탈에 여러 가지 힘을 봉인한 물질이 있습니다. 가장 강력한 영혼의 크리스탈은 모든 적을 한꺼번에 유체 이탈시켜 버린다더군요. 그것뿐만 아니라 화염의 크리스탈과 한파의 크리스탈 같은 공격용 크리스탈, 소환의 크리스탈 같은 소환용 크리스탈도 있고, 치료용과 그 이외의 용도로 쓰이는 것도 있다고 들었습니다.")

	# (44,31) 주민 — 코볼트 봉인 뒤 · 드라코니안 멸망 전에는 성주에게 가 보라고 한다
	if (On(44, 31))
		if (And(Flag::IsSet("KOBOLD_SEALED"), Not(Flag::IsSet("DRACONIAN_DESTROYED"))))
			Say("주민", "지금 당신은 우라누스 게이트를 찾고 있는 것 같은데, 그렇다면 저희 성주님을 만나 보십시오.")
		else
			Say("주민", "이 대륙에는 모두 4개의 대륙으로 가는 게이트가 있습니다. 그중, 2개의 게이트가 이 성 안에 있습니다.")

	# ---- 가운데 마당 · 남쪽 구역 ----

	# (45,45) 주민
	if (On(45, 45))
		Say("주민", "가이아 테라는 대지신을 상징하는 대륙입니다.")

	# (50,56) 주민
	if (On(50, 56))
		Say("주민", "오크족의 마을은 대륙의 남동쪽에 있습니다. 그들의 무기는 시원찮은 것들뿐이라 우리에게 위협이 되지는 않습니다.")

	# (32,61) 주민
	if (On(32, 61))
		Say("주민", "오크족은 미개한 집단이지만 개중에는 머리가 약간 뛰어나서 마법 능력이 있는 자도 있다고 하더군요.")

	# ---- 서쪽 별채 ----

	# (17,24) 알골 — 동료 (주술사, 레벨 3)
	if (On(17, 24))
		Say("알골", "나의 이름은 메듀사의 머리를 뜻하는 알골이라고 하오. 나는 이름처럼, 보기만 해도 상대를 제압할 수 있는 용맹을 지녔소. 나는 소환 계통의 마법을 이곳에서 수년을 연마했다오.")
		Say("알골", "이제는 나의 능력을 실전에 이용할 때가 되었소. 나는 꼭 당신의 원정을 도와주고 싶소.")
		Select::Init()
		Select::Add("")
		Select::Add("당신같이 용맹을 지닌 자라면 좋소")
		Select::Add("안됐지만 저는 지금 바쁘군요")
		Select::Run()
		if (Equal(Select::Result(), 1))
			# 인자 없는 함수는 if 에 혼자 쓰면 불리지 않고 늘 참이 된다 — Equal 로 감싼다
			if (Equal(Party::HasFreeSeat(), 1))
				Party::Join("algol")
				if (Equal(Party::Joined(), 1))
					Flag::Set("JOINED_ALGOL")
					Map::ChangeTile(17, 24, 47)
					DisplayMap()
			else
				Say("알골", "벌써 사람이 모두 채워져 있군요. 다음 기회를 기다리지요.")

	# (15,19) 경험치 훈련장
	if (On(15, 19))
		Shop::ExpTraining()

	# (20,21)·(22,23) 훈련소·마법 학교
	if (Or(On(20, 21), On(22, 23)))
		Shop::Training()

	# (21,55) 약초 가게
	if (On(21, 55))
		Shop::Herb()

	# (19,56)·(20,60)·(24,59) 병원
	if (Or(On(19, 56), On(20, 60), On(24, 59)))
		Shop::Hospital()

	# ---- 동쪽 별채 ----

	# (56,40) 프록시마 — 동료 (사냥꾼, 레벨 4)
	if (On(56, 40))
		Say("프록시마", "나는 켄타우루스의 정기를 받은 사냥꾼으로, 프록시마라고 하오. 이름에서 알 수 있듯이 나의 수호성은 알파 센타우리라오. 사냥을 나온 중에 당신이 이곳에 있다는 소리를 듣고 당신의 일행에 참가하려고 왔던 거요. 나를 받아들이겠소?")
		Select::Init()
		Select::Add("")
		Select::Add("좋소, 승낙하지요")
		Select::Add("글쎄요, 곤란한데요")
		Select::Run()
		if (Equal(Select::Result(), 1))
			if (Equal(Party::HasFreeSeat(), 1))
				Party::Join("proxima")
				if (Equal(Party::Joined(), 1))
					Flag::Set("JOINED_PROXIMA")
					Map::ChangeTile(56, 40, 47)
					DisplayMap()
			else
				Say("프록시마", "벌써 사람이 모두 채워져 있군요. 다음 기회를 기다리지요.")

	# (54,27)·(58,26)·(61,21) 식료품점
	if (Or(On(54, 27), On(58, 26), On(61, 21)))
		Shop::Grocery()

	# (54,57)·(54,59) 무기상점
	if (Or(On(54, 57), On(54, 59)))
		Shop::Weapon()

####### 푯말 ########

if (Equal(ScriptMode(), FLAG_SIGN))

	# (39,8) 게이트 안내
	if (On(39, 8))
		Talk("이곳은 로어 대륙으로 통하는 게이트입니다.")

	# (39,68) 성 입구
	if (On(39, 68))
		Talk("여기는 가이아 테라의 배리언트 피플즈")
		Talk("불의에 대해 가장 강력한 저항을 하는 곳")
		Talk("여러분을 환영합니다.")
		Talk("이곳의 성주로부터")

####### 입구 ########

if (Equal(ScriptMode(), FLAG_ENTER))

	# (38,10)·(39,10) 로어 게이트 → 라스트디치성 (38,9). 조건 없음
	if (OnArea(38, 10, 39, 10))
		Ask("로어 게이트에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E3_LastDtch", 38, 9)

####### 이벤트 칸 ########

if (Equal(ScriptMode(), FLAG_EVENT))

	# (37~40,70) 남쪽 출구 줄 → 가이아 테라 (19,27)
	if (OnArea(37, 70, 40, 70))
		Ask("여기서 나가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E3_Ground2", 19, 27)
		else
			WarpPrevPos()
