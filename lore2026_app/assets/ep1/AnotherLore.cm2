####### 제1부 또 다른 지식의 성전 (E1_AnotherLore) — 30×50 마을형 피라미드 ########
# 근거: 1st/02 §2.6 · 1st/05 §5.3 S5 · 1st/06 §6.2 · §6.14 · 1st/07 §7.4(마법 방해) · 1st/10 §10 ·
#       공략집 Walkthrough/1st/src/maps/AnotherLore.md · 원작 칸 번호(maps.json)
# 마을형 · 기본 바닥 44 · 전투·보물·진행 조건이 없는 이야기 전용 장소. 유골(48)은 서쪽 x=10, 동쪽 x=21 의
# y=10·12·…·40. 의지 다섯과 두루마리 하나 말고는 다가가면 재가 된다. 재가 된 칸은 그 방문 동안만 바닥(35).
# 원작은 진행 상태를 기록하지 않는다 — 다시 들어오면 유골이 다시 서 있다. 남쪽·북쪽 출구 줄 모두 로어 대륙 (20,8).

include("common/const.cm2")
variable(px)
variable(py)

####### 맵에 들어왔다 ########

if (Equal(ScriptMode(), FLAG_MAP))
	Music::Play("town")
	Map::SetHandicap(HANDICAP_SEETHROUGH, 1)
	Map::SetHandicap(HANDICAP_CLAIRVOYANCE, 1)

####### 사람 ########

if (Equal(ScriptMode(), FLAG_TALK))
	px.assign(Party::PosX())
	py.assign(Party::PosY())

	# ---- 피라미드의 남자 (15,6) — 몇 번이든 ----
	if (On(15, 6))
		Talk("당신 앞의 사람이 갑자기 어떤 남자로 변하였다.")
		Say("피라미드의 남자", "당신과는 초면이 아니지요? LORE 성에서도 봤으니까 말이죠. 당신은 나의 정체가 어떨지 궁금하기도 하겠지만 나중에 밝혀질 일이니까 천천히 알아보기로 하고 먼저 이 피라미드에 대해서 말하기로 하지요.")
		Say("피라미드의 남자", "이 피라미드는 Necromancer와 함께 저편의 공간에서 튕겨져 나왔지요. 이곳은 육신은 죽고 의지만 남은 사람들의 안식처라고도 할 수 있죠.")
		Say("피라미드의 남자", "여기의 '의지'들 중에서 당신과 관계가 없는 의지는 모두 재가 되어 버릴 거요. 여기서 얻은 정보는 모두 당신의 운명을 더욱더 모질게 만들어 버릴 것들이지만, 만약 당신이 알지 못한다면 더더욱 당신을 힘겹게 하는 것들만 있지요. 당신의 현명한 판단에 모든 걸 맡기도록 하지요.")
		halt

	# ---- 데네브의 의지 (10,14) ----
	if (On(10, 14))
		Talk("당신이 유골에 다가서자 어디선가 소리가 들려왔다.")
		Say("데네브의 의지", "오! 당신이 나의 잠을 깨웠나?")
		Say("데네브의 의지", "실로 몇천 년 만에 보는 세상이군. 나는 당신의 운명적인 만남을 관장하는 데네브의 의지라고 불리고 있지. 당신이 만나게 될 사람들은 이미 자네가 세상에 나기 전부터 정해져 있었다네. 만약 그 사람들을 만나지 않고 지나쳐 버린다거나 못 만나는 경우가 생긴다면 절대로 Necromancer를 물리치지 못할 걸세. 그렇다면 당신이 꼭 만나야 할 사람들을 말해 보겠네.")
		Talk("@FRed Antares@@")
		Say("데네브의 의지", "그는 이미 죽은 지가 수천 년이 지났지만 그의 의지는 아직 NOTICE란 동굴 속에 잠들어 있네.")
		Say("데네브의 의지", "그는 과거 최강의 마법사로서 이 땅을 통치하였고 다시 세계가 혼미스러울 때 새로이 나타나겠노라고 말하며 홀로 그 동굴에서 살다가 죽었지. 하지만 지금이 그가 말한 때라는 걸 그의 영혼이 알 수 있게만 한다면, 그는 다시금 최강의 마법사로 부활해서 당신들을 도와주게 되는 사람이지.")
		Talk("@FSpica@@")
		Say("데네브의 의지", "지금 초자연력에 대해 알고 있고 사용할 수 있는 사람은 몇 명 되지 않는데, 그중의 한 사람이 Necromancer이고 또 지금 말하는 Spica라네.")
		Say("데네브의 의지", "자네가 이 기술을 그녀에게 배우지 않는다면 Necromancer를 만나기 위한 도중에 무릎을 꿇고 말 것이며 설령 그와 대결하게 된다 해도 자네들은 참패를 하게 될 걸세. 이 기술로 자연을 조작하고 인간의 마음을 읽으며 시공간을 넘겨 볼 수만 있다면 분명 당신은 세계 최강의 전사가 되어 있을 걸세. 그리고 그녀가 있는 곳은 바로 물로 덮인 대륙의 Dragon이 사는 동굴의 어느 깊숙한 곳이라네.")
		Talk("@FAncient Evil@@")
		Say("데네브의 의지", "그는 지금 늪의 대륙의 서쪽 바다 건너 작은 섬에 살고 있다네. 그가 사는 섬을 찾기는 무척 어렵겠지만 초자연력으로 공간을 넘겨 보아 위치를 파악한 후 텔레포트 마법을 통해 이동하면 다다를 수 있을 걸세. 그는 당신의 미래를 쉽게 풀어 주고, 또 새로운 만남을 이어 주게 될 걸세.")
		Say("데네브의 의지", "이 외에도 Polaris, Jr. Antares, Lore Hunter, Rigel 등등의 사람들을 수도 없이 만나게 되겠지만 반드시 당신에게 도움을 주지만은 않을 것이며, 만약 당신이 남을 도와준다면 반드시 그도 당신에게 보이지 않는 도움을 주게 될 거라는 말을 끝으로 나는 다시 몇천 년의 잠으로 빠져들어야겠네. 그럼 안녕히...")
		Map::ChangeTile(px, py, 35)
		DisplayMap()
		halt

	# ---- 시리우스의 의지 (10,18) ----
	if (On(10, 18))
		Talk("당신이 유골에 다가서자 어디선가 소리가 들려왔다.")
		Say("시리우스의 의지", "당신과 나의 만남은 이렇듯 운명적이네. 나는 당신이 이때쯤 나를 찾아오리라고 내가 잠들기 전 몇천 년 전에 이미 알고 있었다네.")
		Say("시리우스의 의지", "소개하지. 나는 당신의 순회적 운명을 관장하는 시리우스의 의지라고 하네. 당신은 나를 처음 봤겠지만 나는 원래 당신의 또 다른 분신으로서 당신은 결코 나에게는 낯설지가 않다네. 당신은 어느 순간에도 당신이 단지 이 세계에서만 당신의 삶이 존재한다고 생각하는가? 분명 지금 현재로서는 그렇게밖에 생각을 못 하지만 실제는 그렇지 않지. 당신은 분명 이 순간에도 다른 공간에서는 또 다른 삶을 살고 있다네. 하지만... '또 다른 삶'이라고 내가 말했지만 결국은 한 운명을 가지고 계속 윤회하는 것일 뿐이지. 나는 이렇게 당신이 찾아오는 것만도 헤아릴 수 없이 겪었지. 언제나 당신은 정해진 운명 때문에 어쩔 수 없이 나를 계속 찾아오게 되는 거라네. 이해가 가지 않을 거라고 나도 생각하면서도 달리 설명할 방도가 없어서 이런 애매한 말만 되풀이할 뿐이네.")
		Say("시리우스의 의지", "더 자세한 운명을 알고 싶다면 스왐프 게이트에 있는 피라미드의 예언서를 읽어 보게나. 그러면 더 이해가 빠를 걸세.")
		Say("시리우스의 의지", "그래도 잘 이해가 안 된다면 '늪의 대륙'의 외딴 섬에 은둔하고 있는 Draconian을 만나 보도록 하게. 그는 Necromancer가 이전의 공간에서 이 공간으로 온 이유를 알고 있기 때문이라네.")
		Say("시리우스의 의지", "그럼 우리의 만남은 다음 공간의 또 다른 운명에 의해 다시 시작될 걸세. 그럼 그때까지 안녕히!")
		Map::ChangeTile(px, py, 35)
		DisplayMap()
		halt

	# ---- 알비레오의 의지 (10,30) ----
	if (On(10, 30))
		Talk("당신이 유골에 다가서자 어디선가 소리가 들려왔다.")
		Say("알비레오의 의지", "나는 이 세계의 운명을 담당하는 알비레오의 의지라고 하오. 나는 이 세상이 생기면서부터 늘 이런 모습으로 여기서 지내 왔소. 나는 이제껏 세상의 많은 위기들을 보아 왔소. 하지만 지금과 같은 공간을 뛰어넘은 침입자에 의한 위기는 처음이라고 기억되오. 나는 이곳에서도 이 세상 모든 것을 볼 수 있소. 그리고 여태껏 당신의 자라온 모습과 여기에 서 있는 이유도 알고 있소. 또한 Necromancer가 이 세상에 온 이후로부터의 그의 행동도 보아 왔소. 그리고 결국은... ... 당신과 그의 미래도 나에게는 보이고 있소. 나는 이 자리에서 미래의 일을 말할 수는 없소. 당신이 그 결말을 알고 싶다면 '늪의 대륙'에 있는 Draconian을 만나 보는 게 좋을 거요. 그 전에 Ancient Evil도 역시 만나게 될 것이오. 그리고 한 가지를 명심하시오.")
		Say("알비레오의 의지", "당신이 옳다고 생각하는 게 항상 옳은 것은 아니오. 남들이 증오하는 것이 항상 당신에게 그릇되게 작용하지는 않을 것이오. 또한 현재의 증오가 미래의 증오가 되지도 않을 것이오. 그리고 결국에는 Necromancer를 용서하시오.")
		Map::ChangeTile(px, py, 35)
		DisplayMap()
		halt

	# ---- 카노푸스의 의지 (21,32) ----
	if (On(21, 32))
		Talk("당신이 유골에 다가서자 어디선가 소리가 들려왔다.")
		Say("카노푸스의 의지", "안녕하시오. 나는 Necromancer의 운명을 관장하고 있는 카노푸스의 의지라고 하오. 이 공간뿐만 아니라 다른 공간에서 존재하고 있는 Necromancer의 운명 또한 내가 담당하는 범주에 들어간다오. 하지만 그는 그의 운명을 따르는 존재일 뿐 그 이상의 의미는 없소. 그는 수도 없는 저편의 공간에서 지워진 운명을 다해 갔소. 그리고 또 여기서 다시 그의 운명을 시작하려 하고 있소. 이 공간 하나밖에 인식하지 못하는 인간의 사고로는 별 가치가 없는 일이지만, 운명을 따르기 위해 다음 공간에서도 같은 운명을 반복해야 한다는 그 금단의 이치는 분명 그도 따르고 싶지 않았을 것이오. 하지만 그는 그 자신도 그것이 절대 바뀔 수 없는 패러독스라는 걸 알고 있을 게요. Necromancer 그 자신은 정말 불행한 존재라오. 스스로의 운명을 등에 지고 힘겹게 차원을 쫓기어 다니는 힘없는 짐승일 뿐이오.")
		Say("카노푸스의 의지", "당신이 마지막의 그에게 받을 수 있는 느낌은 진정한 마음에서 우러나오는 동정일 것이오. 당신은 저번 공간에서도 역시 그것을 느꼈소. 하지만 그때의 기억은 당신이 이 세계에 그를 물리치려는 운명을 지니고 다시 태어났을 때 이미 사라져 버렸소. 당신은 내 말을 이해하지 못하겠지만 그것은 사실이오. 지금은 그를 증오로서 맞이하려 하겠지만 그 증오는 다시 다음 공간으로 이어지려 하오. 당신이 그를 물리친다고 하여도 다시 다음 공간에서도 지금과 같은 대립을 반복할 뿐이오. 당신과 그와의 대립은 이 우주가 생기기 시작할 때부터 지금까지 수도 없이 반복했고 그 이후로도 이 우주가 사라질 때까지 영원히 반복될 것이오. 그리고 마지막으로 내가 하고 싶은 말은 이런 것이오.")
		Say("카노푸스의 의지", "당신은 결국 Necromancer를 동정할지 모르오. 하지만 결코 그만이 동정의 대상이 아니오. 결국은 그와 연관되어 운명이 결정지어진 당신도 예외가 될 수는 없소.")
		Map::ChangeTile(px, py, 35)
		DisplayMap()
		halt

	# ---- 아크투루스의 의지 (21,22) ----
	if (On(21, 22))
		Talk("당신이 유골에 다가서자 어디선가 소리가 들려왔다.")
		Say("아크투루스의 의지", "당신 앞의 유골은 바로 나의 것이오. 나를 소개하자면 아크투루스의 의지라고 불리는 존재로서 Ancient Evil의 운명을 관장하고 있소. 이름에서 알 수 있듯이 그를 수호하는 의지는 목자의 성격을 갖고 있소. 하지만 그의 이름이나 평판으로 볼 때는 전혀 그런 성격을 알지 못하게 되고 마는 게 보통이오. 그는 Lord Ahn과 대립하는 운명을 지니고 세상에 존재하게 되었소. 마치 당신과 Necromancer와 같이 말이오. Lord Ahn과의 대립 관계란 운명 때문에 그는 그의 모든 성격을 포기한 채 Lord Ahn을 위하여 악의 편에 서게 되었던 것이오. 그때 둘 중에 누구 하나가 악의 대표가 되지 않으면 안 되었고 Lord Ahn은 결코 세인의 지탄을 받는 악을 대표하려고 하지 않음으로 해서 그가 직접 악의 대표가 되기로 하였던 것이오. 하지만 원래 그의 마음은 극도의 선에 있었기 때문에 결국 그의 악이란 악의 대표 정도밖에는 될 수 없었던 것이오. 하지만 반대로 Lord Ahn의 입장에서는 그를 계속 비판하며 사람들에게 선의 개념을 심어 주려 하였으므로 결국은 그에 대한 철저한 조작으로 위장해서 그를 비하시키고 자신을 부각시켜, 어릴 때부터 선과 악의 개념을 구분시키고 악을 배척하는 생활을 하여 사회를 순탄하게 이끌어 나가려고 하였소. 물론 Lord Ahn의 생각이 틀렸다고는 할 수 없소. 그게 Lord Ahn의 운명이라 할 수 있기 때문이오. 항상 Lord Ahn의 마음도 편하지 않다는 걸 알고 있소. 절친한 동반자인 그를 적으로 돌려 버린 것도 그의 운명을 벗어날 수 없었기 때문이오. 그리고 그들의 경지는 반신반인이라는 최고의 경지에 올랐소. 당신 역시 Necromancer에게 도전하고자 한다면 그 경지에 다다라야 하오. 분명 그들 둘의 능력으로는 당신과 당신 일행들을 반신반인으로 만들어 줄 수 있을 것이오.")
		Map::ChangeTile(px, py, 35)
		DisplayMap()
		halt

	# ---- 두루마리를 쥔 유골 (21,12) — 읽으면 재가 된다. 지나가면 그대로 ----
	if (On(21, 12))
		Talk("당신 앞에 있는 유골의 손에는 어떤 두루마리가 쥐어져 있었다.")
		Select::Init()
		Select::Add("어떻게 하겠습니까?")
		Select::Add("그 문서를 읽어 보고 싶다")
		Select::Add("그냥 지나가겠다")
		Select::Run()
		if (Not(Equal(Select::Result(), 1)))
			halt
		Talk("Durant l'estoille cheuelue apparente,")
		Talk("머리를 푼 별이 나타날 때")
		Talk("Les trois grand princes seront faits ennemies,")
		Talk("거대한 세 왕자가 서로를 적대한다")
		Talk("Frappez du ciel paix terre trembulente,")
		Talk("평화는 하늘에서 당하고 대지는 요동한다")
		Talk("En son haut auge de l'exaltation,")
		Talk("그 찬미해야 할 높은 오류 속에서")
		Talk("Neromancer sur le bord mis.")
		Talk("Necromancer는 해안으로 밀려나리라.")
		Map::ChangeTile(px, py, 35)
		DisplayMap()
		halt

	# ---- 그 밖의 유골 — 다가가면 재가 된다 ----
	if (Or(Equal(px, 10), Equal(px, 21)))
		Talk("당신이 유골에 다가가자 재로 변하였다.")
		Map::ChangeTile(px, py, 35)
		DisplayMap()
		halt

####### 밟는 칸 — 남쪽·북쪽 출구 줄 ########

if (Equal(ScriptMode(), FLAG_EVENT))
	if (Or(OnArea(14, 46, 17, 46), OnArea(14, 5, 17, 5)))
		Ask("여기서 나가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E1_Lore", 20, 8)
		else
			WarpPrevPos()
