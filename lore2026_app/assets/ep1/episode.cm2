####### 제1부 「또 다른 지식의 성전」 — 편 전체의 일 (episode) ########
# 근거: 1st/03 §3.2 · 1st/04 §4.1~4.2 · 1st/05 §5.5(예언) · 1st/07 §7.4(달력) · 1st/10 §2.2(도입 편지) ·
#       1st/12 부록 B(진행 변수)
# 맵과 무관하게 불린다: FLAG_OPENING(편을 고른 직후, 캐릭터 생성 전) · FLAG_START(캐릭터를 만들고
# 동료 넷을 고른 직후) · FLAG_PROPHECY(초능력 「예언」).
# 제1부에는 예약한 사건이 없다 (FLAG_TIMER 없음). 동료 넷 고르기는 엔진의 생성 화면이 맡는다(1st/04 §4.2).
#
# 조건에 인자 없는 함수 하나만 쓰면 엔진이 부르지 않고 늘 참으로 본다 — 그런 자리는 Equal(…, 1) 로 쓴다.

include("common/const.cm2")
variable(lord)
variable(ditch)
variable(gaia)
variable(water)
variable(seals)
variable(r)

####### 오프닝 — 「오래전부터 만날 운명이었던 당신에게 드리는 글」 (1st/10 §2.2) ########
# 주인공이 아직 없다 — {주인공} 을 쓰지 않는다.

if (Equal(ScriptMode(), FLAG_OPENING))
	SetHeader("오래전부터 만날 운명이었던 당신에게 드리는 글")
	Talk("어서 오십시오. LORE의 세계에 당신을 초대합니다. 이곳은 당신이 지금 있는 지구와는 같은 시간대를 지니고 있지만 공간적으로는 다르게 진화해 온 또 다른 지구라고 할 수 있습니다. 이곳은 아직도 검과 마법이 존재하며 과학 기술은 지구의 중세 정도라고 해 두면 이곳이 이해가 되겠습니까? 지금 이곳은 다른 공간에서 차원의 문을 이용해 들어온 어떤 자에 의해 고통을 겪고 있습니다. 이 일은 그전부터 이 세계에 지워진 운명으로 예언되었었고 그 불가변한 운명에서 벗어나기 위해 당신을 이 세계로 소환하게 되었습니다. 이제부터 당신은 이 세계의 사람입니다. 지금부터 당신의 일행과 함께 당신의 운명 또한 새롭게 개척해 보십시오. 당신의 현명한 판단에 의해 당신 앞에 펼쳐질 세계에 도전하십시오. 언제나 운명의 파문은 당신 앞에 엄습해 오고 있으니 ...")
	Talk("— 제작자 안 영기 드림")
	PressAnyKey()

####### 새 게임 (캐릭터를 만들고 동료 넷을 고른 직후) ########
# 1st/07 §7.4: 771년 3월 1일 09:00, 로어성 알현실. 1st/04 §4.1: 로드안 바로 앞 (51,31).
# 모든 플래그 꺼짐 · 모든 변수 0 은 엔진이 새 판을 그렇게 연다. 장비 없음(맨손)·식량·금화 0 도 같다.

if (Equal(ScriptMode(), FLAG_START))
	Time::Set(771, 3, 1, 9, 0)
	Variable::Set("LORD_STAGE", 0)
	Variable::Set("LASTDITCH_QUEST", 0)
	Variable::Set("GAIA_QUEST", 0)
	Variable::Set("WATERFIELD_QUEST", 0)
	Variable::Set("EVILGOD_SEAL", 0)
	Variable::Set("WIVERNS_KILLED", 0)
	Party::Face(FACE_UP)
	LoadScript("E1_CastleLore", 51, 31)

####### 예언 — 「당신은 ○○ 것이다」 (1st/05 §5.5) ########
# 원작 LOREMENU.PAS:643~697 (ReturnPredict) 를 그대로 옮긴다 — 위에서부터 정하고 뒤의 줄이 앞의 결과를 덮는다.
# 기획서 표는 「마지막으로 맞는 것」으로만 적었지만, 원작은 13(가이아 테라 들판) · 14(와이번 동굴) 뒤의 워터 필드 표를
# 「결과가 13 일 때만」 적용해서 13 · 14 가 덮이지 않는다. 8(GROUND GATE로 갈)은 원작에서도 9 에 늘 덮인다.
# 원작 맵 번호: 2 가이아 테라 · 4 늪의 대륙 · 5 용암의 대륙 · 7 라스트디치 · 13 스왐프 게이트 · 16 와이번 동굴 ·
#   19 이블 갓 · 20 머디 · 21 스왐프 킵 · 22 임페리엄 · 23 이블 컨센트레이션 · 24 라스트 셸터 · 25 던전 오브 이블 · 26 네크로만서의 방
# 두 봉인: 이블 갓은 EVILGOD_SEAL 이 홀수(etc[40]), 머디는 MUDDY_SEAL(etc[41]).

if (Equal(ScriptMode(), FLAG_PROPHECY))
	lord.assign(Variable::Get("LORD_STAGE"))
	ditch.assign(Variable::Get("LASTDITCH_QUEST"))
	gaia.assign(Variable::Get("GAIA_QUEST"))
	water.assign(Variable::Get("WATERFIELD_QUEST"))
	seals.assign(0)
	if (Equal(Mod(Variable::Get("EVILGOD_SEAL"), 2), 1))
		seals.add(1)
	if (Flag::IsSet("MUDDY_SEAL"))
		seals.add(1)
	r.assign(0)
	# 1~5 — 로드안 단계 (etc[10])
	if (Less(lord, 3))
		r.assign(1)
	if (Equal(lord, 3))
		r.assign(2)
	if (Or(Equal(lord, 4), Equal(lord, 5)))
		r.assign(3)
	if (Equal(lord, 6))
		r.assign(4)
	if (And(Equal(r, 4), Map::Is("E1_LastDitch")))
		r.assign(5)
	# 6~8 — 라스트디치 의뢰 (etc[13])
	if (Equal(ditch, 1))
		r.assign(6)
	if (Equal(ditch, 2))
		r.assign(7)
	if (Equal(ditch, 3))
		r.assign(8)
	# 9~13 — 가이아 테라 의뢰 (etc[14]). 라스트디치 의뢰 3 일 때만
	if (Equal(ditch, 3))
		if (Equal(gaia, 0))
			r.assign(9)
		if (Equal(gaia, 1))
			r.assign(10)
		if (Equal(gaia, 2))
			r.assign(11)
		if (Equal(gaia, 3))
			r.assign(9)
		if (Equal(gaia, 4))
			r.assign(12)
		if (Equal(gaia, 5))
			r.assign(11)
		if (Equal(gaia, 6))
			r.assign(13)
	# 14 · 13 — 물의 열쇠를 받은 뒤 와이번 동굴(16) · 가이아 테라 들판(2)
	if (And(Equal(gaia, 6), Map::Is("E1_Wivern")))
		r.assign(14)
	if (And(Equal(gaia, 6), Map::Is("E1_Gaia")))
		r.assign(13)
	else
		if (Equal(r, 13))
			if (Equal(water, 0))
				r.assign(15)
			if (Equal(water, 1))
				r.assign(16)
			if (Equal(water, 2))
				r.assign(15)
			if (Equal(water, 3))
				r.assign(17)
			if (Equal(water, 4))
				r.assign(15)
			if (Equal(water, 5))
				r.assign(18)
	# 19 — 스왐프 게이트(13) 안에서 봉인을 하나도 풀지 않았을 때. 원작은 같은 봉인을 두 번 보는 오타
	#      (not (odd(etc[40]) or odd(etc[40])))라 머디 봉인을 보지 않았다 — 두 봉인을 모두 본다
	if (And(Map::Is("E1_SwampGate"), Equal(seals, 0)))
		r.assign(19)
	# 20 · 21 — 늪의 열쇠(워터 필드 의뢰 5)를 받은 뒤
	if (Equal(water, 5))
		if (Or(Or(Map::Is("E1_Swamp"), Map::Is("E1_EvilGod")), Or(Map::Is("E1_Muddy"), Map::Is("E1_SwampKeep"))))
			r.assign(20)
		if (Equal(seals, 2))
			r.assign(21)
	# 22~25 — 용암의 대륙(5)과 그 안의 맵들
	if (Map::Is("E1_Lava"))
		r.assign(22)
	if (Equal(water, 5))
		if (Or(Map::Is("E1_Imperium"), Map::Is("E1_LastShelter")))
			r.assign(22)
		if (Map::Is("E1_EvilConc"))
			r.assign(23)
		if (Map::Is("E1_DungeonEvil"))
			r.assign(24)
		if (Map::Is("E1_Chamber"))
			r.assign(25)

	if (Equal(r, 0))
		Talk("당신은 어떤 힘에 의해 예언을 방해받고 있다")
		halt
	if (Equal(r, 1))
		Talk("당신은 Lord Ahn을 만날 것이다")
	if (Equal(r, 2))
		Talk("당신은 MENACE를 탐험할 것이다")
	if (Equal(r, 3))
		Talk("당신은 Lord Ahn에게 다시 돌아갈 것이다")
	if (Equal(r, 4))
		Talk("당신은 LASTDITCH로 갈 것이다")
	if (Equal(r, 5))
		Talk("당신은 LASTDITCH의 성주를 만날 것이다")
	if (Equal(r, 6))
		Talk("당신은 PYRAMID 속의 Major Mummy를 물리칠 것이다")
	if (Equal(r, 7))
		Talk("당신은 LASTDITCH의 성주에게로 돌아갈 것이다")
	if (Equal(r, 8))
		Talk("당신은 LASTDITCH의 GROUND GATE로 갈 것이다")
	if (Equal(r, 9))
		Talk("당신은 GAIA TERRA의 성주를 만날 것이다")
	if (Equal(r, 10))
		Talk("당신은 EVIL SEAL에서 황금의 봉인을 발견할 것이다")
	if (Equal(r, 11))
		Talk("당신은 GAIA TERRA의 성주에게 돌아갈 것이다")
	if (Equal(r, 12))
		Talk("당신은 QUAKE에서 ArchiGagoyle를 물리칠 것이다")
	if (Equal(r, 13))
		Talk("당신은 북동쪽의 WIVERN 동굴에 갈 것이다")
	if (Equal(r, 14))
		Talk("당신은 WATER FIELD로 갈 것이다")
	if (Equal(r, 15))
		Talk("당신은 WATER FIELD의 군주를 만날 것이다")
	if (Equal(r, 16))
		Talk("당신은 NOTICE 속의 Hidra를 물리칠 것이다")
	if (Equal(r, 17))
		Talk("당신은 LOCKUP 속의 Dragon을 물리칠 것이다")
	if (Equal(r, 18))
		Talk("당신은 GAIA TERRA의 SWAMP GATE로 갈 것이다")
	if (Equal(r, 19))
		Talk("당신은 위쪽의 게이트를 통해 SWAMP KEEP으로 갈 것이다")
	if (Equal(r, 20))
		Talk("당신은 SWAMP 대륙에 존재하는 두 개의 봉인을 풀 것이다")
	if (Equal(r, 21))
		Talk("당신은 SWAMP KEEP의 라바 게이트를 작동시킬 것이다")
	if (Equal(r, 22))
		Talk("당신은 적의 집결지인 EVIL CONCENTRATION으로 갈 것이다")
	if (Equal(r, 23))
		Talk("당신은 숨겨진 적의 마지막 요새로 들어갈 것이다")
	if (Equal(r, 24))
		Talk("당신은 위쪽의 동굴에서 Necromancer를 만날 것이다")
	if (Equal(r, 25))
		Talk("당신은 Necromancer와 마지막 결전을 벌일 것이다")

