####### 제1부 로어 대륙 (E1_Lore) — 100×100 필드 ########
# 근거: 1st/05 §5.3 S5·S16 · 1st/06 §6.2(도착 좌표) · §6.3 · 1st/08 §8.3(무작위 조우) · 1st/10 §4 ·
#       공략집 Walkthrough/1st/src/maps/Lore.md
# 필드에는 사람도 푯말도 없다. 숨은 칸은 메너스 동쪽의 나무 (42,84) 하나.
# 도착 자리: 로어성에서 (20,12) · 라스트디치성에서 (77,57) · 메너스에서 (18,89) · 또 다른 지식의 성전에서 (20,8)

include("common/const.cm2")

####### 맵에 들어왔다 ########

if (Equal(ScriptMode(), FLAG_MAP))
	Music::Play("ground")
	# 원작 번호 1~10: 오크·트롤·서펀트·어스 웜·드워프·자이언트·팬텀·울프·임프·고블린 (레벨 1~3)
	Encounter::Clear()
	Encounter::Add(1, 10)
	Encounter::Enable(1)

####### 입구 ########

if (Equal(ScriptMode(), FLAG_ENTER))
	if (On(20, 11))
		Ask("CASTLE LORE에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E1_CastleLore", 51, 95)
		halt
	if (On(76, 57))
		Ask("LASTDITCH에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E1_LastDitch", 37, 70)
		halt
	if (On(17, 89))
		Ask("MENACE에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E1_Menace", 25, 45)
		halt
	# 바다 한가운데 — 네 방향이 모두 물이라 물위를 걸음이 있어야 닿는다 (S5)
	if (On(20, 6))
		Ask("ANOTHER LORE에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E1_AnotherLore", 15, 45)
		halt

####### 밟는 칸 ########

if (Equal(ScriptMode(), FLAG_EVENT))
	# 메너스 동쪽의 외딴 나무 (42,84) — 처음 한 번 식량 +100. 나무 위에 서지 않고 원래 칸으로 돌아간다 (S16)
	if (On(42, 84))
		if (Flag::IsSet("LORE_TREE_FOOD"))
			Talk("우리들은 아무것도 발견할 수 없었다.")
		else
			Talk("일행들은 100인분의 식량을 발견했다.")
			Party::PlusFood(100)
			Flag::Set("LORE_TREE_FOOD")
		WarpPrevPos()
