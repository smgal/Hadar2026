####### 제1부 늪의 대륙 (E1_Swamp) — 100×100 필드 ########
# 근거: 1st/04 §4.4(드라코니안) · 1st/05 §5.2 M5 · §5.3 S13·S14 · 1st/06 §6.2 · §6.12 · 1st/08 §8.3 · 1st/10 §8 ·
#       1st/12 부록 B · 공략집 Walkthrough/1st/src/maps/Swamp.md · 원작 칸 번호(maps.json)
# 필드형 · 기본 바닥 41. 숨은 칸: 드라코니안의 피라미드 (26,16), 에인션트 이블의 영 (20,39), 순간 이동 (40,18).
# 북서쪽 외딴 땅 (10~41,13~18)은 에인션트 이블이 처음 내려 줄 때만 들어간다(부록 A D18).
# 도착 자리: 스왐프 킵에서 (48,36) · 이블 갓에서 (48,58) · 머디에서 (82,17)

include("common/const.cm2")

####### 맵에 들어왔다 ########

if (Equal(ScriptMode(), FLAG_MAP))
	Music::Play("ground")
	# 원작 번호 24~40: 락맨·코볼트·미라·악마 사냥꾼·크레이지 원·오우거·헤들리스·머드맨·헬 캣·위습·
	# 바실리스크·스프라이트·뱀파이어·몰튼 몬스터·그레이트 리치·램페이저·뮤턴트 (레벨 6~10)
	Encounter::Clear()
	Encounter::Add(24, 40)
	Encounter::Enable(1)

####### 입구 ########

if (Equal(ScriptMode(), FLAG_ENTER))
	if (On(48, 35))
		Ask("SWAMP KEEP에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E1_SwampKeep", 25, 45)
		halt
	if (On(48, 57))
		Ask("EVIL GOD에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E1_EvilGod", 25, 45)
		halt
	if (On(82, 16))
		Ask("MUDDY에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E1_Muddy", 25, 95)
		halt

####### 밟는 칸 ########

if (Equal(ScriptMode(), FLAG_EVENT))

	# ---- 외딴 땅의 순간 이동 (40,18) → (46,41). 나오면 다시 들어갈 수 없다 ----
	if (On(40, 18))
		Talk("일행은 공간 이동이 되었다.")
		Party::Warp(46, 41)
		halt

	# ---- 에인션트 이블의 영 (20,39) — 섬에는 물위를 걸음 + 공간 이동으로 (S14) ----
	if (On(20, 39))
		if (Flag::IsSet("AE_MET"))
			Party::Warp(46, 41)
			Say("에인션트 이블", "이제는 더 이상 할 말이 없소.")
			halt
		Flag::Set("AE_MET")
		Say("에인션트 이블", "나는 Ancient Evil이란 존재이오. 이제 나는 육신은 없는 영이오. 당신은 Lord Ahn을 만나 보았겠군요. 그리고 우리들의 운명적인 만남도 역시 예시받았겠군요.")
		Say("에인션트 이블", "사실이야 어떻든 당신에게 이 대륙에서의 할 일을 말해 주겠소.")
		# 원작은 화면을 이블 갓 입구 (48,57) → 머디 입구 (82,16)으로 옮겨 가며 설명한다
		Screen::FadeOut()
		Party::Warp(48, 58)
		Screen::FadeIn()
		Say("에인션트 이블", "여기는 EVIL GOD라는 동굴이오. 여기의 보스는 Crab God인데 적 자체는 별것 아니지만 떼를 지어서 다니기 때문에 약간의 애를 먹을 것이오. 7갈래의 길 중에서 한 곳에 봉인이 숨겨져 있을 것이오.")
		Screen::FadeOut()
		Party::Warp(82, 17)
		Screen::FadeIn()
		Say("에인션트 이블", "여기는 Muddy라는 동굴이오. 여기의 보스는 Astral Mud라는 자인데 그리 실력이 있다고는 볼 수가 없소. 다만 동굴 자체가 어려운 미로라는 것과 시야가 좁아지는 불편 등은 감수해야만 할 것이오. 그리고 마지막에 3마리의 Dragon과 7마리의 Mud-Man을 거쳐야만 그가 나타나기 때문에 약간 까다로울 것이오.")
		Screen::FadeOut()
		Party::Warp(16, 15)
		Screen::FadeIn()
		Say("에인션트 이블", "여기는 이 대륙의 외진 곳이오. 여기서는 어떤 만남이 기다리고 있을 것이오.")
		halt

	# ---- 드라코니안의 피라미드 (26,16) — 밟으면 일어난다. 독심 상태면 합류 제의 (S13) ----
	if (On(26, 16))
		Talk("여기는 인간과 드래곤의 중간 종족이며 혼란스러운 세상을 피해 은둔하고 있는 Draconian이란 자가 살고 있는 피라미드였다.")
		if (Flag::IsSet("DRACONIAN_JOINED"))
			Talk("그러나 아무도 살고 있지 않았다.")
			WarpPrevPos()
			halt
		if (Equal(Party::CheckIf(CHECKIF_MINDCONTROL), 1))
			Say("드라코니안", "나의 운명을 생각해 보니 나 역시 당신들을 필연적으로 만나 Necromancer를 물리쳐야 한다는 걸 깨달았소. 당신들 일행의 제일 뒤에서 도와주고 싶소. 어떻소?")
			Select::Init()
			Select::Add("어떻게 하겠습니까?")
			Select::Add("저도 바라던 차입니다")
			Select::Add("별로 좋지는 않군요")
			Select::Run()
			if (Equal(Select::Result(), 1))
				# 6번 칸에 앉는다 — 있던 보조 일원은 사라진다 (부록 A #12)
				Party::SetAssistant("draconian")
				Flag::Set("DRACONIAN_JOINED")
			if (Equal(Select::Result(), 2))
				Say("드라코니안", "다시 생각해 보니 나는 당신들과 같이 싸울 운명이 아닌 것 같소.")
			WarpPrevPos()
			halt
		Say("드라코니안", "나는 Draconian이라고 하오. 이런 곳까지 사람이 찾아오리라고는 생각하지 못했는데 참 의외로군요. 나는 숨어 지내는 오랜 세월 동안에 여러 가지 학문을 연구하고 있었소. 특히 천문학에 대해서는 특별히 전념하여 다루었소. 내가 그동안 알아낸 지식들은 다음과 같은 것이오.")
		Say("드라코니안", "지금 우리가 살고 있는 지구는 태양계에서 세 번째로 위치한 행성인데 이상하게도 위성인 달이 지구보다도 더 오래되었다는 사실이 연구되었소. 또한 이 지구의 세차 운동에 의해 2등성이었던 북극성이 다른 별로 바뀐다는 걸 알았소. 물리학에서 알아낸 것은, 중수 반응에서 매질의 차이로 빛의 속도가 느려진 틈을 이용해 빛보다 빠른 입자가 생겨났소. 하지만 절대적인 빛의 속도에는 미치지 못했지만 말이오. 이것을 잘만 이용하면 미래로의 타임머신이 가능하다는 걸 입증할 수가 있소.")
		Say("드라코니안", "사실 이런 것은 당신에게는 별 의미가 없는 것일지도 모르오. 하지만 마지막으로 알아낸 것은 바로 당신이 응징하고자 하는 Necromancer의 출처에 관한 것이오. 당신은 시그너스 X1과 같은 블랙홀에 대해서 알고 있을 것이오. 이런 물리학적인 패러독스에 의해 그는 생겨났던 것이오.")
		Say("드라코니안", "지금 우리가 있는 3차원 위에 또 다른 차원이 있다고 생각하오? 생각은 하더라도 눈으로 확인은 못 해 봤을 것이오. 우리는 2차원을 인식할 수가 있소. 하지만 실제로 2차원에 살고 있는 생물은 자신의 차원은 인식해도 우리가 살고 있는 3차원은 인식할 수가 없는 것이오. 그의 차원에는 우리의 차원이 존재하지 않기 때문에 개념을 잡을 수가 없는 것이오. 마찬가지로 우리 또한 지금의 차원보다 한 차원 높은 4차원의 개념을 잡기가 어려운 것이오.")
		Say("드라코니안", "어떤 이는 4차원은 시간의 축이 보태어진다고 하는 이론을 세우더군요. 하지만 나의 이론은 시간은 모든 차원의 기준이며 4차원에 국한되지는 않는다는 생각이오. 3차원에서는 동시간대에 무한한 2차원을 포함하듯이 4차원에서는 동시간대에 무한한 3차원을 포함하고 있다는 이론이 성립되오. 말이 조금은 빗나갔지만 이 이론으로 Necromancer의 출처를 해명해 보겠소. 방금 말했듯이 3차원은 이 공간만이 존재하는 것은 아니오. 동시대를 살아가는 다른 공간도 인정해야 한다는 말이오. 그 공간들을 이어 주는 것이 바로 블랙홀이란 것이지요. 그는 원래 그가 있던 공간에서 블랙홀을 통해서 다른 공간으로 가려고 시도를 했고 웜홀을 통해 시공간을 가로질러 오래전 우리의 공간에 화이트홀이 생기는 틈을 이용하여 내려왔던 것이오.")
		Say("드라코니안", "하지만 3차원에 사는 나로서는 그가 전에 있던 공간에서 왜 이쪽으로 왔는지 알 수가 없었지요. 그래서 그와 같이 이 공간으로 들어왔던 심복들을 통해 그 사정을 알게 되었소.")
		Say("드라코니안", "Necromancer는 저쪽의 공간에서도 지금과 마찬가지로 차원을 통해 그 공간에 도달했소. 역시 거기서도 악을 뿌리며 거기의 생명체들을 위협했소. 하지만 어떤 선택되어진 6인의 용사들에 의해 쫓겨나서 여기로 온 것이오. 지금의 당신들과 비슷하다고 생각되지 않소? 그렇소. 다른 공간의 당신들에게 쫓겨난 후 다시 여기서 당신들을 또 만나게 된 것이오. Necromancer와 당신들의 운명은 언제까지나 쫓고 쫓기며 대립하여야 하는 운명으로 탄생되었던 것이오. 이런 이유에서 당신은 그를 반드시 무찌를 수가 있다는 근거가 되는 것이오.")
		Say("드라코니안", "당신들의 건투를 빌어 주겠소.")
		WarpPrevPos()
		halt
