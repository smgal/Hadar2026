####### 제1부 로어성 (E1_CastleLore) — 100×100 마을 ########
# 근거: 1st/05 §5.2 M1 · §5.3 S1·S3·S4 · 1st/06 §6.4 · 1st/10 §3 · §11(로어성 푯말) · 1st/12 부록 B ·
#       공략집 Walkthrough/1st/src/maps/CastleLore.md · 원작 칸 번호(Walkthrough/1st/maps/maps.json)
# 칸 번호: 기본 바닥 44 · 성문과 안쪽 문 5 · 경비·주민 53 · 로드안 54 · 감옥 문과 출구 줄은 숨은 칸 0 ·
#          감옥 복도 바닥 44 · 묘지의 숨은 길 자리는 벽 7·19 (열리면 44, LORETALK.PAS:126~127).

include("common/const.cm2")
variable(temp)
variable(px)

####### 맵에 들어올 때 ########
# 맵은 들어올 때마다 원본(성문·안쪽 문 닫힘)으로 시작한다. 연 적이 있는 문은 다시 연다 (부록 B.3).
# 원작은 문을 연 기록 없이 필드에서 들어올 때 열었다 — 문을 연 뒤에야 성을 나갈 수 있으므로 같은 결과다.

if (Equal(ScriptMode(), FLAG_MAP))
	Music::Play("town")
	if (Flag::IsSet("CHALLENGE_ACCEPTED"))
		Map::ChangeTileArea(49, 52, 53, 53, 44)
	if (Flag::IsSet("INNER_GATE_OPEN"))
		Map::ChangeTileArea(49, 88, 53, 88, 44)
	# Jr. 안타레스를 만났고 금화를 아직 줍지 않았으면 숨은 길을 다시 연다 (원작은 성을 나가면 닫혔다 — 부록 A #13)
	if (And(Flag::IsSet("JR_ANTARES_MET"), Not(Flag::IsSet("JR_ANTARES_GOLD"))))
		Map::ChangeTileArea(62, 79, 62, 81, 44)
		Map::ChangeTile(62, 82, 0)
		Map::ChangeTile(62, 83, 14)
	# 미친 조가 한 번 일행에 들었으면 독방은 비어 있다
	if (Flag::IsSet("MADJOE_JOINED"))
		Map::ChangeTile(40, 15, 47)

####### 사람 ########

if (Equal(ScriptMode(), FLAG_TALK))

	# ---- 로드안 (51,28) — 말을 걸 때마다 한 단계씩 (1st/05 M1) ----
	if (On(51, 28))
		temp.assign(Variable::Get("LORD_STAGE"))
		if (Equal(temp, 0))
			Say("로드안", "나는 Lord Ahn이오.")
			Say("로드안", "이제부터 당신은 이 게임에서 새로운 인물로서 생을 시작하게 될 것이오. 그럼 나의 이야기를 시작하겠소.")
			Variable::Set("LORD_STAGE", 1)
			halt
		if (Equal(temp, 1))
			Say("로드안", "이 세계는 내가 통치하는 동안에는 무척 평화로운 세상이 진행되어 왔었소. 그러나 그것은 한 운명의 장난으로 무참히 깨어져 버렸소.")
			Say("로드안", "한날, 대기의 공간이 진동하며 난데없는 푸른 번개가 대륙들 중의 하나를 강타했소. 공간은 휘어지고 시간은 진동하며 이 세계를 공포 속으로 몰고 갔소. 그 번개의 위력으로 그 불운한 대륙은 황폐화된 용암 대지로 변하고 말았고, 다른 하나의 대륙은 충돌 시의 진동에 의해 바다 깊이 가라앉아 버렸소.")
			Say("로드안", "그런 일이 있은 한참 후에, 이상하게도 용암 대지의 대륙으로부터 강한 생명의 기운이 발산되기 시작했소. 그래서 우리들은 그 원인을 알아보기 위해 'LORE 특공대'를 조직하기로 합의를 하고 이곳에 있는 거의 모든 용사들을 모아서 용암 대지로 변한 그 대륙으로 급히 그들을 파견하였지만 여태껏 아무 소식도 듣지 못했소. 그들이 생존해 있는지조차도 말이오.")
			Say("로드안", "이런저런 방법을 통하여 그들의 생사를 알아보려던 중 우연히 우리들은 'Necromancer'라고 불리는 용암 대지 속의 새로운 세력의 존재를 알아내었고, 그때의 그들은 이미 막강한 세력으로 성장해 가고 있는 중이었소. 그때의 번개는 그가 이 공간으로 이동하는 수단이었소. 즉 그는 이 공간의 인물이 아닌 다른 차원을 가진 공간에서 왔던 것이오.")
			Say("로드안", "그는 현재 이 세계의 반을 그의 세력권 안에 넣고 있소. 여기서 당신의 궁극적인 임무는 바로 'Necromancer의 야심을 봉쇄시키는 것'이라는 걸 명심해 두시오.")
			Variable::Set("LORD_STAGE", 2)
			halt
		if (Equal(temp, 2))
			Say("로드안", "Necromancer의 영향력은 이미 LORE 대륙까지 도달해 있소. 또한 그들은 이 대륙의 남서쪽에 'MENACE'라고 불리는 지하 동굴을 얼마 전에 구축했소. 그래서 그 동굴의 존재 때문에 우리들은 그에게 위협을 당하게 되었던 것이오.")
			Say("로드안", "하지만 LORE 특공대가 이 대륙을 떠난 후로는 그 일당들에게 대적할 용사는 이미 남아 있지 않았소. 그래서 부탁하건대, 그 동굴을 중심부까지 탐사해 주시오.")
			Say("로드안", "나는 당신들에게 Necromancer에 대한 일을 맡기고 싶지만, 아직은 당신들의 확실한 능력을 모르는 상태이지요. 그래서 이 일은 당신들의 잠재력을 증명해 주는 좋은 기회가 될 것이오.")
			Say("로드안", "만약 당신들이 무기가 필요하다면 무기고에서 약간의 무기를 가져가도록 허락하겠소.")
			Variable::Set("LORD_STAGE", 3)
			halt
		if (Equal(temp, 3))
			Say("로드안", "대륙의 남서쪽에 있는 'MENACE'를 탐사해 주시오.")
			halt
		if (Equal(temp, 4))
			Say("로드안", "당신들의 성공을 축하하오!!")
			Party::GiveExp(1000)
			Notice("EXP + 1000")
			Variable::Set("LORD_STAGE", 5)
			halt
		if (Equal(temp, 5))
			Say("로드안", "드디어 나는 당신들의 능력을 믿을 수 있게 되었소. 그렇다면 당신들에게 Necromancer 응징이라는 막중한 임무를 한번 맡겨 보겠소.")
			Say("로드안", "먼저 대륙의 동쪽에 있는 'LASTDITCH'에 가 보도록 하시오. 'LASTDITCH'성은 지금 많은 근심에 싸여 있소. 그들을 도와주시오.")
			Variable::Set("LORD_STAGE", 6)
			halt
		Say("로드안", "당신은 이제 스스로 행동해 나가시오.")
		halt

	# ---- 알현실 경비 여덟 (48·54, 31~37) ----
	if (Or(OnArea(48, 31, 48, 37), OnArea(54, 31, 54, 37)))
		if (Equal(Variable::Get("LORD_STAGE"), 0))
			Say("경비", "저희 성주님을 만나십시오.")
		else
			Say("경비", "당신이 성공하기를 빕니다.")
		halt

	# ---- 성문 경비 (50,51)·(52,51) — 도전을 받아들이면 성문 (49~53,52~53)이 열린다 ----
	if (Or(On(50, 51), On(52, 51)))
		if (Flag::IsSet("CHALLENGE_ACCEPTED"))
			Say("성문 경비", "행운을 빌겠소!!!")
			halt
		if (Less(Variable::Get("LORD_STAGE"), 3))
			Say("성문 경비", "저희 성주님을 만나 보십시오.")
			halt
		Ask("당신은 이 게임 세계에 도전하고 싶습니까?")
		if (Equal(Select::Result(), 1))
			Answer("예.")
			Say("성문 경비", "이제부터 당신은 진정한 이 세계에 발을 디디게 되는 것입니다.")
			Flag::Set("CHALLENGE_ACCEPTED")
			Map::ChangeTileArea(49, 52, 53, 53, 44)
			DisplayMap()
		else
			Answer("아니오.")
			Say("성문 경비", "다시 생각해 보십시오.")
		halt

	# ---- 안쪽 문 경비 (51,87) — 처음 말을 걸면 안쪽 문 (49~53,88)이 열린다 ----
	if (On(51, 87))
		if (Flag::IsSet("INNER_GATE_OPEN"))
			Say("경비", "힘내시오, {주인공}.")
		else
			Say("경비", "난 당신을 믿소, {주인공}.")
			Flag::Set("INNER_GATE_OPEN")
			Map::ChangeTileArea(49, 88, 53, 88, 44)
			DisplayMap()
		halt

	# ---- 무기고 경비 (42,78)·(42,80) ----
	if (Or(On(42, 78), On(42, 80)))
		if (Flag::IsSet("ARMORY_USED"))
			Say("무기고 경비", "여기서 가져가신 무기를 잘 사용하셔서 세계의 적인 Necromancer를 무찔러 주십시오.")
		else
			Say("무기고 경비", "Lord Ahn님의 명령에 의해서 당신들에게 한 가지의 무기를 드리겠습니다. 들어가셔서 무기를 선택해 주십시오.")
		halt

	# ---- 시설 ----
	if (Or(On(87, 73), On(91, 65)))
		Shop::Grocery()
		halt
	if (Or(On(8, 71), Or(On(14, 69), On(14, 73))))
		Shop::Weapon()
		halt
	if (Or(On(87, 14), On(86, 12)))
		Shop::Hospital()
		halt
	if (Or(On(21, 12), On(25, 13)))
		Shop::Training()
		halt

	# ---- 주민 ----
	if (On(9, 64))
		Say("주민", "당신이 모험을 시작한다면, 많은 괴물들을 만날 것이오.")
		Say("주민", "무엇보다도, Serpent와 Insects와 Python은 맹독이 있으니 주의하시기 바라오.")
		halt
	if (On(72, 73))
		Say("주민", "Orc는 가장 하급 괴물이오.")
		halt
	if (On(51, 72))
		if (Flag::IsSet("PYRAMID_HINT_HEARD"))
			Say("주민", "'MENACE' 속에는 Dwarf, Giant, Wolf, Python 같은 괴물들이 살고 있소.")
		else
			Say("주민", "당신이 Necromancer에 진정으로 대항하고자 한다면, 이 성의 바로 위에 있는 피라미드에 가 보도록 하시오. 그곳은 Necromancer와 동시에 바다에서 떠오른 또 다른 지식의 성전이기 때문이오. 당신이 어느 수준이 되어 그곳에 들어간다면 진정한 이 세계의 진실을 알 수 있을 것이오.")
			Flag::Set("PYRAMID_HINT_HEARD")
		halt
	if (On(58, 74))
		Say("주민", "나의 부모님은 Python의 독에 의해 돌아가셨습니다. Python은 정말 위험한 존재입니다.")
		halt
	if (On(63, 27))
		Say("주민", "단지 Lord Ahn만이 능력상으로 Necromancer에게 도전할 수 있습니다.")
		Say("주민", "하지만 Lord Ahn 자신이 대립을 싫어해서, 현재는 Necromancer에게 대항할 자가 없습니다.")
		halt
	if (On(90, 82))
		Say("주민", "우리는 Ancient Evil을 배척하고 Lord Ahn님을 받들어야 합니다.")
		halt
	if (On(94, 68))
		Say("주민", "우리는 MENACE의 동쪽에 있는 나무로부터 많은 식량을 얻은 적이 있습니다.")
		halt
	if (On(19, 53))
		Say("주민", "이 세계의 창시자는 안영기님이시며, 그는 위대한 프로그래머입니다.")
		halt
	if (On(24, 50))
		Say("주민", "힘내게, {주인공}. 자네라면 충분히 Necromancer를 무찌를 수 있을 걸세. 자네만 믿겠네.")
		halt
	if (On(24, 54))
		Say("주민", "위의 저 친구로부터 당신 얘기 많이 들었습니다. 저는 우리 성에서 당신 같은 용감한 사람이 있다는 걸 자랑스럽게 생각합니다.")
		halt
	if (On(13, 55))
		Say("주민", "만약 당신들이 그 일을 해내기가 어렵다고 생각되시면 LASTDITCH 성에서 성문을 지키고 있는 Polaris란 청년을 일행에 참가시켜 주십시오. 분명 그 사람이라면 흔쾌히 승낙할 겁니다.")
		halt
	if (Or(On(51, 14), On(83, 27)))
		Say("주민", "MENACE에는 금덩이가 많다던데... MENACE는 한때 금광이었습니다.")
		halt

	# ---- LORE 주점 ----
	if (Or(On(13, 27), On(18, 27)))
		Say("주점 주인", "어서 오십시오. 여기는 LORE 주점입니다.")
		if (Equal(Random(2), 0))
			if (Equal(Player::GetAttribute(1, "gender"), 1))
				Say("주점 주인", "거기 여성분, 어서 오십시오.")
			else
				Say("주점 주인", "거기 남성분, 어서 오십시오.")
		else
			Say("주점 주인", "위스키에서 칵테일까지 마음껏 선택하십시오.")
		halt
	if (On(21, 33))
		Say("손님", "...")
		halt
	if (On(10, 30))
		Say("손님", "요새 무덤 쪽에서 유령이 떠돈다던데...")
		halt
	if (On(13, 32))
		Say("손님", "하하하, 자네도 한번 마셔 보게나.")
		halt
	if (On(15, 35))
		Say("손님", "이제 Lord Ahn의 시대도 끝나 가는가? 그까짓 Necromancer라는 작자에게 쩔쩔매는 꼴이라니... 차라리 내가 나가서 그놈과 싸우는 게 낫겠다.")
		halt
	if (On(18, 33))
		Say("손님", "당신은 Skeleton족의 한 명이 우리와 함께 생활하려 한다는 것에 대해서 어떻게 생각하십니까? 저는 그 말을 들었을 때 너무 혐오스러웠습니다. 어서 빨리 그 살아 있는 뼈다귀를 여기서 쫓아냈으면 좋겠습니다.")
		halt
	if (On(21, 36))
		Say("손님", "... 끄~~윽 ... ...")
		halt
	if (On(18, 38))
		Say("손님", "이보게 자네, 내 말 좀 들어 보게나. 나의 친구들은 이제 이 세상에 없다네. 그들은 너무나도 용감하고 믿음직스러운 친구들이었는데... 내가 다리를 다쳐 병원에 있을 동안 그들은 모두 이 대륙의 평화를 위해 LORE 특공대에 지원했다네. 하지만 그들은 아무도 다시는 돌아오지 못했어. 그런 그들에게 이렇게 살아 있는 나로서는 미안할 뿐이네. 그래서 술로 나날을 보내고 있지. 죄책감을 잊기 위해서 말이지...")
		halt

	# ---- 용사의 묘지 ----
	if (On(72, 78))
		Say("관리인", "물러나십시오. 여기는 용사의 유골들을 안치해 놓은 곳입니다.")
		halt
	# Jr. 안타레스의 유골 (63,76) — 한 번. 묘지 서쪽 끝 아래 (62,79~81)이 길로, (62,82)가 숨은 칸으로 (S1)
	if (On(63, 76))
		if (Flag::IsSet("JR_ANTARES_MET"))
			halt
		Talk("당신이 한 유골 앞에 섰을 때 이상한 느낌과 함께 먼 곳으로부터 어떤 소리가 들려왔다.")
		Say("Jr. 안타레스", "안녕하시오, 대담한 용사여.")
		Say("Jr. 안타레스", "당신이 나의 잠을 깨웠소? 나는 고대에 이곳을 지키다가 죽어 간 기사 Jr. Antares라고 하오. 저의 아버지는 Red Antares라고 불렸던 최강의 마법사였소. 그는 말년에 어떤 동굴로 은신을 한 후 아무에게도 모습을 나타내지 않았소. 하지만 당신의 운명은 나의 아버지를 만나야만 하는 운명이라는 것을 알 수 있소. 반드시 나의 아버지를 만나서 당신이 알지 못했던 새로운 능력들을 배우시오. 그리고 나의 아버지를 당신의 동행으로 참가시키도록 하시오. 물론 좀 어렵겠지만...")
		Say("Jr. 안타레스", "아참, 그리고 내가 죽기 전에 여기에 뭔가를 숨겨 두었는데 당신에게 도움이 될지 모르겠소. 그럼, 나는 다시 오랜 잠으로 들어가야겠소.")
		Flag::Set("JR_ANTARES_MET")
		# 묘지 서쪽 끝 아래가 길(44)이 되고 (62,82) 는 숨은 칸, 그 아래 (62,83) 에 상자(14) (LORETALK.PAS:126~127)
		Map::ChangeTileArea(62, 79, 62, 81, 44)
		Map::ChangeTile(62, 82, 0)
		Map::ChangeTile(62, 83, 14)
		DisplayMap()
		halt
	# 유골 줄 y=76 의 다른 유골은 반응이 없다
	if (OnArea(62, 76, 74, 76))
		halt

	# ---- LORE 왕립 죄수 수용소 ----
	if (On(50, 11))
		Say("간수", "이 안에 갇혀 있는 사람들에게는 일체 면회가 허용되지 않습니다. 나가 주십시오.")
		halt
	if (On(53, 11))
		Say("간수", "여기는 Lord Ahn의 체제에 대해서 깊은 반감을 가지고 있는 자들을 수용하고 있습니다.")
		Say("간수", "아마 그들은 죽기 전에는 이곳을 나올 수 없을 겁니다.")
		halt
	# 독방 넷은 문이 없다 — 변화 마법(기화 이동·지형 변화·공간 이동)으로 들어가야 말을 걸 수 있다
	if (On(41, 10))
		Say("투옥된 기사", "나는 이곳의 기사로서 이 세계의 모든 대륙을 탐험하고 돌아왔었습니다. 내가 마지막 대륙을 돌았을 때 나는 새로운 존재를 발견했습니다. 그는 바로 예전까지도 Lord Ahn과 대립하던 Ancient Evil이라는 존재였습니다. 지금 우리의 성에서는 철저하게 배격하도록 어릴 때부터 가르침 받아 온 그 Ancient Evil이었습니다. 하지만 그곳에서 본 그는 우리가 알고 있는 그와는 전혀 다른 인간미를 가진, 말 그대로 신과 같은 존재였습니다. 내가 그의 신앙 아래 있는 어느 도시를 돌면서 내가 느낀 것은 정말 Lord Ahn에게서는 찾아볼 수가 없는 그런 자애와 따뜻한 정이었습니다. 그리고 여태껏 내가 알고 있는 그에 대한 지식이 정말 잘못되었다는 것과 이런 사실을 다른 사람에게도 알려 주고 싶다는 이유로 그의 사상을 퍼뜨리다 이렇게 잡히게 된 것입니다.")
		Say("투옥된 기사", "하지만 더욱 이상한 것은 Lord Ahn 자신도 그에 대한 사실을 인정하면서도 왜 우리에게는 그를 배격하도록만 교육시키는가를 알고 싶을 뿐입니다. Lord Ahn께서는 나를 이해한다고 하셨지만 사회 혼란을 방지하기 위해 나를 이렇게밖에 할 수 없다고 말씀하시더군요. 그리고 이것은 선을 대표하는 자기로서는 이 방법밖에는 없다고 하시더군요.")
		Say("투옥된 기사", "하지만 Lord Ahn의 마음은 사실 이렇지 않다는 걸 알 수 있었습니다. Ancient Evil의 말로는 사실 서로가 매우 절친한 관계임을 알 수가 있었기 때문입니다.")
		halt
	if (On(40, 15))
		if (Party::Has("mad_joe"))
			Say("미친 조", "히히히...")
			halt
		Say("미친 조", "히히히... 위대한 용사님. 낄낄낄.. 내가 당신들의 일행에 끼면 안 될까요? 우히히히..")
		Select::Init()
		Select::Add("어떻게 하겠습니까?")
		Select::Add("그렇다면 당신을 받아들이지요")
		Select::Add("당신은 이곳에 그냥 있는 게 낫겠소")
		Select::Run()
		if (Equal(Select::Result(), 1))
			# 묻지 않고 6번 자리에 앉는다 — 있던 보조 일원은 사라진다 (공략집 「주의」, 부록 A #12)
			Party::SetAssistant("mad_joe")
			Flag::Set("MADJOE_JOINED")
			Map::ChangeTile(40, 15, 47)
			DisplayMap()
		halt
	if (On(63, 10))
		Say("전직 도둑", "안녕하시오. 나는 한때 이곳의 유명한 도둑이었던 사람이오. 결국 그 때문에 나는 잡혀서 평생 여기에 있게 되었지만...")
		Say("전직 도둑", "그건 그렇고, 내가 LORE 성의 보물인 황금의 방패를 훔쳐 달아나다 그만 그것을 MENACE라는 금광에 숨겨 놓은 채 잡혀 버리고 말았소. 나는 이제 그것을 가져 봤자 쓸 데도 없으니 차라리 당신이 그걸 가지시오. 가만있자... 어디였더라... 그래! MENACE의 가운데쯤에 벽으로 사방이 둘러싸인 곳이었는데.. 당신들이라면 지금 여기에 들어온 것과 같은 방법으로 들어가서 방패를 찾을 수 있을 것이오. 행운을 빌겠소.")
		halt
	if (On(60, 15))
		Say("죄수", "당신들에게 경고해 두겠는데 건너편 방에 있는 Joe는 오랜 수감 생활 끝에 미쳐 버리고 말았소. 그의 말에 속아서 당신네 일행에 참가시키는 그런 실수는 하지 마시오.")
		halt

####### 푯말 ########

if (Equal(ScriptMode(), FLAG_SIGN))
	if (On(51, 84))
		Talk("여기는 'CASTLE LORE'성")
		Talk("여러분을 환영합니다")
		Talk("@ELord Ahn@@")
		halt
	if (On(24, 31))
		Talk("여기는 LORE 주점")
		Talk("여러분 모두를 환영합니다!!")
		halt
	if (Or(On(51, 18), On(52, 18)))
		Talk("LORE 왕립 죄수 수용소")
		halt

####### 밟는 칸 ########

if (Equal(ScriptMode(), FLAG_EVENT))

	# ---- 무기고 입구 (41,79) — 한 번: 일행이 서쪽으로 세 걸음 들어가고 맨손인 대원이 단도를 든다 ----
	if (On(41, 79))
		if (Flag::IsSet("ARMORY_USED"))
			halt
		Flag::Set("ARMORY_USED")
		Party::Face(FACE_LEFT)
		Wait(340)
		Party::Move(-1, 0)
		Wait(340)
		Party::Move(-1, 0)
		Wait(340)
		Party::Move(-1, 0)
		Party::ArmBareHanded("weapon.dagger")
		Talk("일행은 가장 기본적인 무기로 모두 무장을 하였다.")
		halt

	# ---- Jr. 안타레스의 숨겨진 상자 (62,82) ----
	if (On(62, 82))
		if (Flag::IsSet("JR_ANTARES_GOLD"))
			halt
		Talk("일행은 상자 속에서 약간의 금을 발견했다.")
		Party::PlusGold(1000)
		Notice("황금 + 1000")
		Flag::Set("JR_ANTARES_GOLD")
		Map::ChangeTile(62, 82, 44)                 # LORESPEC.PAS:190~194
		DisplayMap()
		halt

	# ---- 감옥 문 (51,12)·(52,12) — 미친 조를 받아들인 뒤 수용소 병사 (S3) ----
	# 병사는 미라(적 26번)에서 특수 공격과 마법을 뺀 변형 camp_soldier 다 (1st/08 「이름을 바꿔 쓰는 적」). 적 선공.
	if (Or(On(51, 12), On(52, 12)))
		if (Not(Flag::IsSet("MADJOE_JOINED")))
			halt
		Battle::Init()
		if (Flag::IsSet("PRISON_GUARDS_FOUGHT"))
			Say("수용소 병사", "다시 돌아오다니, {주인공}. 이번에는 기어이 네놈들을 해치우고야 말겠다. 나의 친구들도 이번에 거들 것이다.")
			Battle::RegisterVariant("camp_soldier", 7)
		else
			Say("수용소 병사", "아니! 당신이 우리들을 배신하고 죄수를 풀어 주다니... 그렇다면 우리들은 결투로서 당신들과 승부할 수밖에 없군요.")
			Battle::RegisterVariant("camp_soldier", 2)
		Flag::Set("PRISON_GUARDS_FOUGHT")
		if (Party::Has("mad_joe"))
			Talk("우리들 뒤에 있던 Mad Joe가 전투가 일어나자마자 도망을 가 버렸다.")
			Party::RemoveAssistant()
		Battle::Start(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE))
		if (Equal(Battle::Result(), BATTLERESULT_WIN))
			Talk("당신들은 수감소 병사들을 물리쳤다.")
			# 이번 방문 동안 감옥 문 두 칸과 간수 둘이 빈 바닥이 된다
			Map::ChangeTile(51, 12, 44)
			Map::ChangeTile(52, 12, 44)
			Map::ChangeTile(50, 11, 44)
			Map::ChangeTile(53, 11, 44)
			DisplayMap()
		halt

	# ---- 출구 줄 (49~53,96) — 처음 나갈 때 스켈레톤 (S4) ----
	if (OnArea(49, 96, 53, 96))
		Ask("여기서 나가기를 원합니까?")
		if (Not(Equal(Select::Result(), 1)))
			WarpPrevPos()
			halt
		if (Not(Flag::IsSet("SKELETON_OFFERED")))
			Flag::Set("SKELETON_OFFERED")
			Talk("당신이 LORE 성을 떠나려는 순간 누군가가 당신을 불렀다.")
			# 북쪽 네 칸 위에서 걸어온다 — 1부 마을 타일 48 이 스켈레톤 그림이다 (LORESPEC.PAS:268~271)
			px.assign(Party::PosX())
			Party::Face(FACE_UP)
			Actor::Show("스켈레톤", 48, px, 92)
			Actor::Move("스켈레톤", 0, 1)
			Actor::Wait()
			Wait(340)
			Actor::Move("스켈레톤", 0, 1)
			Actor::Wait()
			Wait(340)
			Actor::Move("스켈레톤", 0, 1)
			Actor::Wait()
			Say("스켈레톤", "나는 Skeleton이라 불리는 종족의 사람이오.")
			Say("스켈레톤", "우리 종족의 사람들은 나를 제외하고는 모두 Necromancer에게 굴복하여 그의 부하가 되었지만 나는 그렇지 않소. 나는 Necromancer의 영향을 피해서 이곳 LORE 성으로 왔지만 나의 혐오스러운 생김새 때문에 이곳 사람들에게 배척되어서 지금은 어디로도 갈 수 없는 존재가 되었소. 이제 나에게 남은 것은 Necromancer의 타도밖에 없소. 그래서 당신들의 일행에 끼고 싶소.")
			Select::Init()
			Select::Add("어떻게 하겠습니까?")
			Select::Add("당신을 환영하오.")
			Select::Add("미안하지만 안 되겠소.")
			Select::Run()
			Actor::Hide("스켈레톤")
			if (Equal(Select::Result(), 1))
				Party::SetAssistant("skeleton")
		LoadScript("E1_Lore", 20, 12)

# (원작 확인) 묘지의 숨은 길은 44, (62,82) 는 숨은 칸, (62,83) 에 상자(14). 금을 주우면 (62,82) 가 44 (LORETALK.PAS:126~127 · LORESPEC.PAS:190~194).
# (결정) 수용소 병사 전투의 되풀이는 원작이 의도한 것으로 보고 그대로 둔다 — 두 번째부터는 「다시 돌아오다니…」 대사로
#       7명이 덤비도록 따로 쓰여 있다(LORESPEC.PAS:196~240). 부록 A D12, 2026-11-16 원작자와 확인.
# (원작 확인) 스켈레톤이 걸어오는 그림은 1부 마을 타일 48 (LORESPEC.PAS:268~271 의 map[x,i] := 48).
