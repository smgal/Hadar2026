####### 제2부 메피스토펠레스의 요새 (E2_Mephisto) — 50×50 요새 (지하 세계 2) ########
# 근거: 2nd/05 §5.2(3차 원정 · 결말) · 2nd/06 §6.11 · 2nd/07 §7.2(어두운 곳) · 2nd/08 §8.2 · 2nd/10 §9.2 · §11 ·
#       2nd/12 부록 B · 공략집 Walkthrough/2nd/src/maps/Mephisto.md · 원작 칸 번호(maps.json)
# 요새형 · 기본 바닥 41 · 마법 제한 없음. 들어오면 저절로 두 칸 걸어 들어가 (25,42)에 서고 입구 (24~27,44)와 그 아래
# (23~28,45~50)이 막힌다 — 나갈 수 없다. 횃불이 최소 10 이 된다.
# 안뜰 테두리 (18,23~26)·(33,23~26)·(18~33,26) 22칸에서 최후의 가디안(이길 때까지). (25~26,15)에서 메피스토펠레스.

include("common/const.cm2")
variable(px)

####### 맵에 들어왔다 ########

if (Equal(ScriptMode(), FLAG_MAP))
	Music::Play("keep")
	Encounter::Clear()
	Encounter::Enable(0)
	if (Less(Party::Torch(), 10))
		Party::SetTorch(10)
	if (Equal(Party::PosY(), 44))
		Screen::FadeIn()
		Party::Face(FACE_UP)
		Party::Move(0, -1)
		Party::Move(0, -1)
	Map::ChangeTileArea(24, 44, 27, 44, 36)
	Map::ChangeTileArea(23, 45, 28, 50, 36)
	DisplayMap()

####### 푯말 ########

if (Equal(ScriptMode(), FLAG_SIGN))
	if (On(24, 40))
		Talk("반드시 메피스토펠레스를 무찔러 주시오. 건투를 빌겠소.")
		Talk("로드안과 에인션트 이블로부터")
		halt
	if (On(27, 40))
		Talk("역시 나의 게임은 훌륭하지 않소? 이제 나의 16번째 자작 게임의 결말이 다가오고 있소. 거의 한 달 가까이 만들었었는데...")
		Talk("제작 기간 : 93/12/08 - 94/01/04")
		Talk("동아 대학교 전기 공학과 92학번")
		Talk("자칭 사상 최고의 프로그래머")
		Talk("안영기로부터")
		halt

####### 밟는 칸 ########

if (Equal(ScriptMode(), FLAG_EVENT))
	px.assign(Party::PosX())

	# ---- 메피스토펠레스 (25~26,15) — 반복 (도망에 성공해도 다시) ----
	if (OnArea(25, 15, 26, 15))
		if (Flag::IsSet("TRIP_MEPHISTO"))
			halt
		Talk("당신은 직감적으로 결전의 순간이 다가왔다는 것을 알았다. 벌써 메피스토펠레스는 당신 앞으로 걸어 나왔고, 일행은 전투 태세를 취하였다.")
		Say("메피스토펠레스", "당신들이 다크 메이지 실리안 카미너스의 새로운 탄생을 방해하러 온 자들인가? 그렇지만 이미 한발 늦었군. 나의 뒤쪽의 생체 배양 튜브 속을 보게나. 저것이 새로 부활하는 실리안 카미너스라네.")
		Talk("당신이 그가 가리키는 곳에서 본 것은 점액이 흘러내리고 있는 붉은 고기 덩어리 같은 육체였다. 머리에는 무수한 전기봉이 꽂혀 있었고 등에는 영양분을 공급하는 관이 연결되어 있었다. 이따금 깜박이는 검은 눈에서는 어린 소녀의 눈빛이 아닌 증오로 가득 찬 짐승의 눈빛을 느낄 수 있었다.")
		Say("메피스토펠레스", "잘 봤겠지. 이미 그녀는 스스로의 몸 안에 봉인되어 있는 힘을 깨달아 버렸지. 내가 이 스위치를 누름과 동시에 로어의 세계로 공간 이동이 되게 되어 있다네.")
		Talk("그는 그의 손 안에 있는 리모컨의 스위치를 눌렀고 순간 실리안 카미너스는 공간 이동을 하여 이곳에서 사라졌다.")
		Say("메피스토펠레스", "그리고 당신들은 내가 처리하도록 하지. 당신들은 로어성이 불타는 장면을 못 보게 되어 정말 아쉽겠군. 아무리 로드안이라고 해도 실리안 카미너스의 악의 힘에는 당하지 못한다네. 그녀는 불멸의 생명체이니까 말일세.")
		Battle::Init()
		Battle::SetRepeatText("하지만 메피스토펠레스는 일행의 도주를 허용하지 않았다.")
		Battle::RegisterEnemy(58, 2)
		Battle::RegisterEnemy(61, 1)
		Battle::RegisterEnemy(69, 2)
		Battle::RegisterEnemy(66, 1)
		Battle::RegisterEnemy(71, 1)
		Battle::RegisterEnemy(75, 1)
		Battle::Start(Add(BATTLE_ENEMY_FIRST, Add(BATTLE_NO_PRELUDE, BATTLE_REPEAT)))
		Flag::Set("TRIP_MEPHISTO")
		Talk("일행이 메피스토펠레스를 물리치고는 모든 마법의 힘을 하나로 뭉쳐 지상으로 공간 이동을 시도했다.")
		Talk("일행은 로어 대륙으로 공간 이동을 했다.")
		# 1~5번 대원의 마력 0 (6번 보조 일원은 그대로)
		Player::ChangeAttribute(1, "mp", 0)
		if (Equal(Player::IsAvailable(2), 1))
			Player::ChangeAttribute(2, "mp", 0)
		if (Equal(Player::IsAvailable(3), 1))
			Player::ChangeAttribute(3, "mp", 0)
		if (Equal(Player::IsAvailable(4), 1))
			Player::ChangeAttribute(4, "mp", 0)
		if (Equal(Player::IsAvailable(5), 1))
			Player::ChangeAttribute(5, "mp", 0)
		Flag::Reset("TRIP_ARRIVED")
		Variable::Set("LORD_STAGE", 16)
		PressAnyKey()
		LoadScript("E2_Lore", 24, 48)

	# ---- 최후의 가디안 — 안뜰 테두리, 이길 때까지. 일행 선공. 도망치면 한 칸 물러난다 ----
	if (Or(Or(OnArea(18, 23, 18, 26), OnArea(33, 23, 33, 26)), OnArea(18, 26, 33, 26)))
		if (Flag::IsSet("LAST_GUARDIAN"))
			halt
		Say("최후의 가디안", "잠깐 거기에 서라. 당신들을 더 이상 안으로 들어가게 할 수 없다. 여기가 바로 메피스토펠레스님의 마지막 방어선이니까. 여러 말 하지 않겠다. 바로 결전이다.")
		Battle::Init()
		Battle::RegisterEnemy(58, 4)
		Battle::RegisterEnemy(61, 3)
		Battle::RegisterVariant("last_guardian", 1)
		Battle::Start(BATTLE_NO_PRELUDE)
		if (Equal(Battle::Result(), BATTLERESULT_WIN))
			Flag::Set("LAST_GUARDIAN")
		else
			WarpPrevPos()
		halt
