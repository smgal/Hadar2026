####### 제2부 로어 대륙 (E2_Lore) — 100×100 필드 ########
# 근거: 2nd/03(결말) · 2nd/05 §5.2(결말) · §5.3 · 2nd/06 §6.2 · §6.3 · 2nd/10 §10 · §12 ·
#       공략집 Walkthrough/2nd/src/maps/Lore.md
# 무작위 조우 없음. 레굴루스의 오두막 (82,9)는 곶 끝의 숨은 칸이라 필드 그림에 오두막이 없다(부록 A D13).
# 단계 16(메피스토펠레스 처치 뒤)에는 모든 입구가 닫히고 로어성 앞에서 결말이 진행된다.
# 도착 자리: 로어성에서 (20,12) · 라스트디치에서 (77,57) · 메너스에서 (18,89) · 피라미드에서 (83,86) ·
#            오두막에서 (82,10) · 메피스토펠레스 처치 뒤 (24,48)

include("common/const.cm2")

####### 맵에 들어왔다 ########

if (Equal(ScriptMode(), FLAG_MAP))
	Music::Play("ground")
	Encounter::Clear()
	Encounter::Enable(0)

####### 입구 ########

if (Equal(ScriptMode(), FLAG_ENTER))

	# ---- 로어성 (20,11) — 단계 16 이면 결말 ----
	if (On(20, 11))
		if (Not(Equal(Variable::Get("LORD_STAGE"), 16)))
			Ask("LORE 성에 들어가기를 원합니까?")
			if (Equal(Select::Result(), 1))
				LoadScript("E2_CastleLore", 51, 94)
			halt
		Talk("당신이 서둘러 로어성에 다다랐지만 이미 로어성은 폐허가 되어 버렸다.")
		Talk("당신은 아찔한 감을 느끼며 알비레오의 예언에 굴복함을 느꼈다. 이제는 다시 돌이킬 수가 없는 일이 일어나 버렸다. 우리는 다크 메이지")
		Notice("실리안 카미너스에게 완패한 것이었다.")
		Talk("다크 메이지는 가공할 힘으로 전 대륙에 결계를 형성하기 시작했고 결계 속의 물체들은 서서히 형체를 잃어 가기 시작했다. 이제는 실리안 카미너스를 제어할 수 있는 메피스토펠레스마저 사라져 버려서 그녀는 의지의 중심을 잃고 한없이 그녀의 힘을 방출하기 시작했다.")
		Talk("이제는 누구도 그녀의 기하급수적인 힘의 폭주를 막을 수가 없었고 이미 당신의 의식도 흐려져 갔다.")
		Talk("하지만 이때, 실리안 카미너스의 마법 결계를 깨트리며 희미한 의지가 스며들어 왔다. 그것은 레드 안타레스의 마지막 의지였고 그는 그녀의 결계를 버티며 마지막 말을 한다.")
		Say("레드 안타레스", "다크 메이지의 힘은 영혼인 나조차도 소멸시킬 힘이 있다는 걸 알았네. 지금은 나의 마법력으로 나 혼자 정도를 보호할 수 있는 결계를 구성했지만 곧 나의 힘도 다하게 될 걸세. 나는 마지막으로 한 가지의 묘안을 생각해 내었네. 자네는 알비레오의 예언을 기억하겠지. 그중 마지막 예언을 외워 보게. 거기에는 대단한 모순이 있네. 지금은 그의 세 번째 예언인 '네크로만서에게 이긴 자는 아무도 없었다.'라는 구절이 실행되지 않은 예언이라고 생각되고 있지. 하지만 반대로 생각해 보게. 자네가 만약 지금이라도 네크로만서에게 패한다면 네 번째의 예언이 실현되지 않는 예언이 된다네. 그렇게만 된다면 다크 메이지는 처음부터 없었던 존재가 되어 버리고 로어 대륙은 원래의 모습대로 시간을 진행해 나가게 된다네. 나의 결계가 점점 약해져 가는군. 나의 소멸을 헛되게 하지는 말게. 그리고 자신보다 로어의 운명을 먼저 생각하도록 하게.... 그..그럼... 다..다음 세상에서......")
		Talk("그의 의지는 점점 희미해지더니 결국 암흑으로 사라지고 말았다.")
		Select::Init()
		Select::Add("당신은 어떻게 하겠는가?")
		Select::Add("레드 안타레스의 말대로 한다")
		Select::Add("다크 메이지와 싸우고 싶다")
		Select::Run()
		if (Equal(Select::Result(), 1))
			# ---- 엔딩 (2nd/10 §12) ----
			Music::Play("ending")
			Screen::FadeOut()
			ClearText()
			Talk("일행은 자신들이 가지고 있는 모든 힘을 다해서 당신을 네크로만서가 있는 공간으로 차원 이탈을 시켰다. 차원 이탈 중 당신의 갑옷은 파괴되고 체력은 떨어졌다. 그리고 당신의 의식이 돌아왔을 때 이미 네크로만서는 당신 앞에 서 있었다. 그는 말을 시작했다.")
			PressAnyKey()
			# 검은 화면 — 노란 글씨는 네크로만서의 말, 흰 글씨는 주문, 회색 글씨는 서술. 키를 누를 때까지 번개 (2nd/03 §3.3)
			Letter::Clear()
			Letter::Add("@E나는 그전부터 이런 운명이 당신에게 찾아올 거라는 것을 알고 있었네. 벌써 이와 같은 일을 나는 셀 수 없이 겪었다네. 자네는 이해하겠나? 자네가 자네의 차원에서 나를 이기기 전에, 내가 쫓겨난 그 전의 차원에서의 자네가 나에게 이런 식으로 다시 와서 나의 손에 죽었다네. 내가 자네의 차원에서 패해서 블랙홀을 통해서 여기의 차원으로 오면서도 패배감은 전혀 없었다네. 그건 자네가 다시 이런 모습으로 내 앞에 나타난다는 것을 알고 있었기 때문이지. 자네는 결국 알게 될 걸세. 나는 이 모든 차원을 통하여 단 1명이지만 자네는 자네와 같은 운명을 지니고 그 차원을 살아가는 셀 수 없이 많은 자네들 중에 한 명이라네. 내가 지금 여기서 당신을 죽이더라도 이 차원에 살고 있는 자네에 의해 다시 다른 차원으로 쫓겨날 것이네. 하지만 그도 곧 나에게 죽으러 올 것이라는 것을 알 수 있겠지.@@")
			Letter::Add("@E나 네크로만서는 어느 차원에서도 궁극적으로는 패배를 할 수가 없다네. 즉, 나를 이기는 자는 아무도 없지.@@")
			Letter::Add("@F인 산크트 그라브 .. 인 바스 프람 ..@@")
			Letter::Add("@7네크로만서는 에너지 장막으로 당신을 가둔 채 화염 폭풍으로 더 이상 저항하지 못하는 당신을 공격했다. 당신은 희미한 의식 속에서도 몸이 찢겨 나가는 것을 느꼈다. 이것으로서 로어의 세계는 실리안 카미너스가 애초에 존재하지 않았던 차원으로 바뀌었다.@@")
			Letter::Show(7, LETTER_LIGHTNING)
			SetHeader("로어성의 주민들")
			Talk("{주인공}님은 지하 세계로 간 뒤 소식이 없다지? 그나저나 알비레오의 예언은 틀렸다고들 하던데. 다크 메이지는 결국 나타나지 않았잖아. 그러면 세 번째, 네 번째, 다섯 번째 예언은 모두 틀렸군.")
			Talk("세 번째 예언은 네크로만서가 {주인공}님에게 패배했으니까 틀렸지.")
			Talk("네 번째 예언은 다크 메이지가 나타나지 않았기 때문에 틀렸지.")
			Talk("그리고 다섯 번째 예언은 틀린 예언이 한 가지가 아니라 세 가지라서 틀렸지.")
			Talk("어때? 내 말이 맞지?")
			PressAnyKey()
			SetHeader("")
			Talk("'Dark Mage Cyllian Cominus vol. #2' is made by Ahn Young-Kie.")
			Game::Ending("A")
		# 「다크 메이지와 싸우고 싶다」 — 끝없는 전투. 이겨도 그녀는 다시 나뉘어 덤빈다 (성 앞에 다시 서면 또 같은 물음)
		Talk("일행은 스스로의 능력을 믿기로 하고 실리안 카미너스를 공격하려 했다.")
		Say("실리안 카미너스", "크악~~ 네가 이곳의 마지막 생존자냐? 그렇다면 너도 죽여 주지.")
		Talk("실리안 카미너스는 다시 8조각으로 자신을 분해해서 자신을 8명으로 만들었다.")
		Say("실리안 카미너스", "크크크.. 너희들은 반드시 나의 손에 죽어 줘야겠다. 크크크..")
		Battle::Init()
		Battle::SetRepeatText("@B실리안 카미너스@@ : 크크크.. 어디로 도망가려고?")
		Battle::RegisterVariant("sirian_caminus_split", 8)
		Battle::Start(Add(BATTLE_ENEMY_FIRST, Add(BATTLE_NO_PRELUDE, BATTLE_REPEAT)))
		halt

	# ---- 라스트디치 (76,57) ----
	if (On(76, 57))
		if (Equal(Variable::Get("LORD_STAGE"), 16))
			Talk("라스트디치성은 용암의 대지로 변했다.")
			halt
		Ask("LASTDITCH에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E2_LastDitch", 38, 69)
		halt

	# ---- 메너스 (17,89) ----
	if (On(17, 89))
		if (Equal(Variable::Get("LORD_STAGE"), 16))
			Talk("메너스는 형체도 알아볼 수 없을 정도로 무너져 버렸다.")
			halt
		Ask("MENACE에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E2_Menace", 26, 44)
		halt

	# ---- 알 수 없는 피라미드 (84,86) ----
	if (On(84, 86))
		if (Equal(Variable::Get("LORD_STAGE"), 16))
			Talk("그러나 피라미드는 파괴되었다.")
			halt
		Ask("알 수 없는 피라미드에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E2_Pyramid", 99, 100)
		halt

####### 밟는 칸 — 레굴루스의 오두막 (82,9) ########

if (Equal(ScriptMode(), FLAG_EVENT))
	if (On(82, 9))
		if (Equal(Variable::Get("LORD_STAGE"), 16))
			Talk("레굴루스의 오두막은 이미 파괴된 후였다.")
			WarpPrevPos()
			halt
		Ask("오두막에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E2_Regulus", 25, 40)
		else
			WarpPrevPos()
