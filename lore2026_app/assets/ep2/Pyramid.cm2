	# ---- 운명 (186,95) — 손상되어 작동하지 않는다 (원작 그대로, 부록 A D3) ----
	if (On(186, 95))
		Say("석상", "나는 고대의 유적 중 당신이 겪어 나간 운명에 관한 이해를 담당하고 있소. 만약 나의 3가지 질문을 모두 통과하면 이 !@ QfhR%{`as& ^Z>;/~ ^^Q+! ?hs<e#냠")
		Say("석상", "< Error 43 : Illegal assignment >")
		Say("석상", "< Error 3 : Unknown identifier >")
		Say("석상", "< Error 122 : Invalid variable reference >")
		Say("석상", "Program is Terminated !! ($F34DC1:$01BA8)")
		Talk("하지만 석상은 심하게 손상되어 있었고 제대로 작동하지 않았다.")
		halt

	# ---- 수학 (186,108) — 정확성, 최대 20 ----
	if (On(186, 108))
		if (Flag::IsSet("STATUE_6"))
			Shop::StatTraining("accuracy", 20)
			halt
		Say("석상", "나는 고대의 유적 중 수학에 대한 지식을 담당하고 있소. 만약 나의 3가지 질문을 모두 통과하면 이 시험을 통과한 것으로 간주하겠소.")
		Select::Init()
		Select::Add("X = 7, Y = 9, Z * Z = X + Y라면 Z의 값은 어떻게 되겠소?")
		Select::Add("<< 3 >>")
		Select::Add("<< 4 >>")
		Select::Add("<< 5 >>")
		Select::Add("<< 6 >>")
		Select::Add("<< 7 >>")
		Select::Run()
		if (Not(Equal(Select::Result(), 2)))
			ok.assign(0)
		Select::Init()
		Select::Add("X + Y = 7, X - Y = 1에서 X와 Y를 알아내서 X * Y의 답을 말해 주시오.")
		Select::Add("<< 0 >>")
		Select::Add("<< 7 >>")
		Select::Add("<< 10 >>")
		Select::Add("<< 12 >>")
		Select::Add("<< 14 >>")
		Select::Run()
		if (Not(Equal(Select::Result(), 4)))
			ok.assign(0)
		Select::Init()
		Select::Add("당신은 아마 로어 헌터를 만났을 것이오. 그가 있었던 좌표의 (X - Y)는 어떻게 되오?")
		Select::Add("<< 153 >>")
		Select::Add("<< 168 >>")
		Select::Add("<< 171 >>")
		Select::Add("<< -57 >>")
		Select::Add("<< -25 >>")
		Select::Run()
		if (Not(Equal(Select::Result(), 1)))
			ok.assign(0)
		if (Equal(ok, 1))
			Say("석상", "당신은 수학 실력 또한 대단하군요. 당신은 이 시험을 통과했소.")
			Party::GiveExp(50000)
			Notice("경험치 + 50000")
