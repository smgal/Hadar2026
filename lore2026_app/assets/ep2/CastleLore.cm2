	# ---- 출구 줄 (49~53,95) ----
	if (OnArea(49, 95, 53, 95))
		Ask("여기서 나가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E2_Lore", 20, 12)
