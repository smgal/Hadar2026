		halt
	if (On(53, 11))
		Say("간수", "여기는 로드안의 체제에 대해서 깊은 반감을 가지고 있는 자들을 수용하고 있습니다.")
		Say("간수", "아마 그들은 죽기 전에는 이곳을 나올 수 없을 겁니다.")
		halt
	if (On(41, 10))
		Say("투옥된 기사", "나는 이곳의 기사로서 이 세계의 모든 대륙을 탐험하고 돌아왔었습니다. 내가 마지막 대륙을 돌았을 때 나는 새로운 존재를 발견했습니다. 그는 바로 예전까지도 Lord Ahn과 대립하던 Ancient Evil이라는 존재였습니다. 지금 우리의 성에서는 철저하게 배격하도록 어릴 때부터 가르침 받아 온 그 Ancient Evil이었습니다. 하지만 그곳에서 본 그는 우리가 알고 있는 그와는 전혀 다른 인간미를 가진, 말 그대로 신과 같은 존재였습니다. 내가 그의 신앙 아래 있는 어느 도시를 돌면서 내가 느낀 것은 정말 Lord Ahn에게서는 찾아볼 수가 없는 그런 자애와 따뜻한 정이었습니다. 그리고 여태껏 내가 알고 있는 그에 대한 지식이 정말 잘못되었다는 것과 이런 사실을 다른 사람에게도 알려 주고 싶다는 이유로 그의 사상을 퍼뜨리다 이렇게 잡히게 된 것입니다.")
		Say("투옥된 기사", "하지만 더욱 이상한 것은 Lord Ahn 자신도 그에 대한 사실을 인정하면서도 왜 우리에게는 그를 배격하도록만 교육시키는가를 알고 싶을 뿐입니다. Lord Ahn께서는 나를 이해한다고 하셨지만 사회 혼란을 방지하기 위해 나를 이렇게밖에 할 수 없다고 말씀하시더군요. 그리고 이것은 선을 대표하는 자기로서는 이 방법밖에는 없다고 하시더군요.")
		Say("투옥된 기사", "하지만 Lord Ahn의 마음은 사실 이렇지 않다는 걸 알 수 있었습니다. Ancient Evil의 말로는 사실 서로가 매우 절친한 관계임을 알 수가 있었기 때문입니다.")
		halt
	if (On(40, 15))
		Say("미친 조", "히히히... 위대한 용사님. 낄낄낄.. 내가 당신들의 일행에 끼면 안 될까요? 우히히히..")
		Select::Init()
		Select::Add("어떻게 하겠습니까?")
		Select::Add("그렇다면 당신을 받아들이지요")
		Select::Add("당신은 이곳에 그냥 있는 게 낫겠소")
		Select::Run()
		if (Equal(Select::Result(), 1))
			Party::SetAssistant("mad_joe")
			Flag::Set("JOINED_MADJOE")
			Map::ChangeTile(40, 15, 47)
			DisplayMap()
		halt
	if (On(63, 10))
		Say("머큐리", "내가 몇 년 전에 황금 방패를 숨겨 놓았던 메너스에 새로운 일들이 생겼다는 게 사실이오?")
		Say("머큐리", "내가 저번에는 용기가 없어서 당신과 함께 동행하자는 말을 못 했지만 이번에는 한번 부탁하겠소. 나는 비록 도둑질을 해서 여기에 들어왔지만 암살자로서의 임무도 잘 해낼 거요.")
		Select::Init()
		Select::Add("어떻게 하겠습니까?")
		Select::Add("승낙하겠소, 그럼 잘 부탁하오")
		Select::Add("죄수를 탈출시키면 나 역시 힘들게 되오")
		Select::Run()
		if (Equal(Select::Result(), 1))
			if (Not(Equal(Party::HasFreeSeat(), 1)))
				Say("머큐리", "벌써 사람이 모두 채워져 있군요. 다음 기회를 기다리지요.")
				halt
			Say("머큐리", "고맙소. 그리고 병사들에게 들키지 않게 여기를 나가야 된다는 것 정도는 알고 있겠지요.")
			Party::Join("mercury")
			Flag::Set("JOINED_MERCURY")
			Map::ChangeTile(63, 10, 47)
			DisplayMap()
		halt
	if (On(60, 15))
		Say("죄수", "당신들에게 경고해 두겠는데 건너편 방에 있는 조는 오랜 수감 생활 끝에 미쳐 버리고 말았소. 그의 말에 속아서 당신네 일행에 참가시키는 그런 실수는 하지 마시오.")
		halt

	# ---- 로어 은행 ----
	if (On(79, 47))
		Say("은행 직원", "우리 은행은 철저하게 보안되고 있습니다.")
		halt
	if (On(79, 49))
		Say("은행 직원", "손님께서는 예금 창구의 안쪽으로는 들어가시면 안 됩니다. 그때의 일은 책임질 수 없습니다.")
		halt
	if (On(85, 48))
		Say("은행 직원", "지금은 민심이 어수선해서 은행의 입출금을 금지하고 있습니다. 양해하여 주십시오.")
		halt
	# 은행 경비원 (90,47) — 말을 걸면 강도로 몰린다 (2nd/07 §7.2)
	if (On(90, 47))
		Say("은행 경비원", "누구냐! 앗 은행 강도다.")
		Say("은행 경비원", "경비병! 경비병!")
		Say("은행 경비원", "만약 당신이 우리와 싸운다면 당신은 범죄자로서 영영 로어성에 들어올 수 없다는 것을 알아야 한다. 항복하라!")
		Select::Init()
		Select::Add("어떻게 하겠습니까?")
		Select::Add("항복한다")
		Select::Add("그래도 싸운다")
		Select::Run()
		if (Equal(Select::Result(), 2))
			Say("로드안", "당신이 은행에 침입하다니 의외로군요. 하지만 우리의 믿음을 저버리고 악한 일을 한 대가를 받으시오. 자, 그럼.")
			Talk("로드안은 전체에게 '필멸 주문'을 사용했다.")
			Screen::Flash()
			Game::Over()
		# 항복 — 1~5번 대원의 장비를 모두 잃고 미친 조의 독방 (41,16)으로
		Party::StripEquipment()
		Screen::FadeOut()
		Party::Warp(41, 16)
		Screen::FadeIn()
		halt

	# ---- 주민 ----
	if (On(24, 50))
		if (Equal(Variable::Get("LORD_STAGE"), 0))
			Say("주민", "어서 로드안님에게 가 보도록 하게.")
		else
			Say("주민", "이번에도 큰일을 맞게 됐군, {주인공}.")
			Say("주민", "이번에도 분명 당신은 해낼 수 있으리라고 믿네. 과거의 영웅은 이제 잊혀 가지만 다시 일어서는 날이 바로 지금인 것 같네. 이번 일만 성공하면 다시 그때의 영광을 찾을 수 있을 걸세. 자네의 성공을 빌어 주겠네.")
		halt
	if (On(24, 54))
		Say("주민", "로드안님이 당신을 부르셨다면서요. 시대의 영웅이었던 당신처럼 되기 위해 저도 열심히 수련을 하고 있습니다.")
		halt
	if (On(19, 53))
		Say("주민", "이 세계의 창시자는 안영기님이시며, 그는 위대한 프로그래머입니다.")
		halt
	if (On(13, 55))
		Say("주민", "지금 어떤 예언서가 발견되어 주민들의 관심을 끌고 있더군요.")
		halt
	if (On(85, 55))
		Say("주민", "살려 주십시오, {주인공}님.")
		Say("주민", "아마 조금만 있으면 다크 메이지가 이곳을 폐허로 만들 겁니다.")
		halt
	if (On(72, 73))
		Say("주민", "나는 어릴 적에 할아버지로부터 지하 세계의 사람들에 대해 들은 적이 있는데 지금은 기억이 잘 나지 않는군요.")
		halt
	if (On(51, 14))
		Say("주민", "당신이 이 세계를 네크로만서로부터 구한 후에는 다른 대륙도 원래의 모습을 찾았습니다.")
		halt
	if (On(90, 59))
		Say("밭의 주민", "{주인공}님.")
		if (Flag::IsSet("FARM_FOOD"))
			halt
		Say("밭의 주민", "만나게 되어서 기쁩니다. 이번 모험을 하는 데 약간의 도움이 되었으면 합니다. 이 밭에 있는 채소를 조금 드릴 테니 식량으로 사용해 주십시오.")
		Party::PlusFood(20)
		Notice("당신은 그녀에게 약간의 식량을 받았다.")
		Flag::Set("FARM_FOOD")
		halt
	if (On(92, 80))
		Say("주민", "알비레오님의 예언서에 의하면 다크 메이지가 이 세계를 멸망시킨다고 하던데 정말 큰일이군요.")
		halt
	if (On(91, 81))
		Say("주민", "얼마 전에 옆집에 살던 분이 메너스 광산에서 일하던 중 의문의 살인을 당했어요. 시체를 본 사람에 의하면 날카로운 독화살에 맞아서 즉사했다고 하던데요.")
		halt
	if (On(58, 74))
		Say("주민", "이번에도 우리들은 당신만 믿고 있습니다.")
		halt
	if (On(63, 27))
		Say("주민", "당신과 함께 싸웠던 전투승 레굴루스는 로어성을 떠나 대륙의 북동쪽 섬의 오두막에 산다고 합니다.")
		halt
	if (On(51, 72))
		Say("주민", "당신과 함께 싸웠던 폴라리스는 라스트디치성 군주의 수석 호위관이 되어 있더군요.")
		halt
	if (On(50, 51))
		Say("주민", "타이탄님은 당신과의 모험이 끝난 후 로어 주점의 경비와 치안을 맡고 있더군요.")
		halt
	if (On(52, 51))
		Say("주민", "이번의 모험도 역시 성공하기를 빕니다.")
		halt

