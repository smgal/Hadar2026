####### 밟는 칸 ########

if (Equal(ScriptMode(), FLAG_EVENT))
	px.assign(Party::PosX())

	# ---- 집 문 줄 (19,48~51) — 새 게임에서 처음 나설 때 이웃이 찾아온다 ----
	if (OnArea(19, 48, 19, 51))
		if (Flag::IsSet("INTRO_DONE"))
			halt
		Flag::Set("INTRO_DONE")
		Say("이웃", "일어났군, {주인공}.")
		Say("이웃", "자네 빨리 로드안님께 가 보도록 하게. 급히 찾으시는 것 보니 아무래도 무슨 큰일이 벌어진 것 같네. 네크로만서 이후 몇 년간 세상이 조용하더니만...")
		Say("이웃", "그건 그렇고 빨리 서두르게.")
		Map::ChangeTileArea(19, 48, 19, 51, 44)
		DisplayMap()
		halt

	# ---- 무기고 입구 (41,79) — 한 번: 서쪽으로 세 걸음 들어가며 맨손인 대원이 단검을 든다 ----
	if (On(41, 79))
		if (Flag::IsSet("ARMORY_USED"))
			halt
		Flag::Set("ARMORY_USED")
		Party::Face(FACE_LEFT)
		Wait(340)
		Party::Move(-1, 0)
		Wait(340)
		Party::Move(-1, 0)
		Wait(340)
		Party::Move(-1, 0)
		Party::ArmBareHanded("weapon.short_sword", "fighter")		# 맨손인 전투사 계열만 (DARKSPEC.PAS:1197~1203)
		Talk("일행은 가장 기본적인 무기로 모두 무장을 하였다.")
		Map::ChangeTile(41, 79, 44)
		halt

	# ---- 감옥 문 (51,12)·(52,12) — 미친 조나 머큐리를 데리고 나가면 병사 ----
	if (OnArea(51, 12, 52, 12))
		if (Not(Or(Flag::IsSet("JOINED_MADJOE"), Flag::IsSet("JOINED_MERCURY"))))
			halt
		Battle::Init()
		if (Flag::IsSet("PRISON_GUARDS_FOUGHT"))
			Say("병사", "다시 돌아오다니, {주인공}. 이번에는 기어이 네놈들을 해치우고야 말겠다. 나의 친구들도 이번에 거들 것이다.")
			Battle::RegisterVariant("soldier", 7)
		else
			Say("병사", "아니! 당신이 우리들을 배신하고 죄수를 풀어 주다니... 그렇다면 우리들은 결투로서 당신들과 승부할 수밖에 없군요.")
			Battle::RegisterVariant("soldier", 2)
		Flag::Set("PRISON_GUARDS_FOUGHT")
		if (Party::Has("mad_joe"))
			Talk("우리들 뒤에 있던 미친 조가 전투가 일어나자마자 도망을 가 버렸다.")
			Party::RemoveAssistant()
		Battle::Start(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE))
		if (Equal(Battle::Result(), BATTLERESULT_WIN))
			Talk("당신들은 수감소 병사들을 물리쳤다.")
			Map::ChangeTileArea(51, 12, 52, 12, 44)
			Map::ChangeTile(50, 11, 44)
			Map::ChangeTile(53, 11, 44)
			DisplayMap()
		halt

	# ---- 은행의 열쇠 (86,48) → 문 (87,48) ----
	if (On(86, 48))
		if (Not(Flag::IsSet("BANK_KEY")))
			Flag::Set("BANK_KEY")
			Talk("당신은 열쇠를 발견했다.")
			Map::ChangeTile(87, 48, 47)
			DisplayMap()
		halt

	# ---- 은행 금고 ----
	if (On(90, 40))
		if (Not(Flag::IsSet("BANK_CHEST_1")))
			Flag::Set("BANK_CHEST_1")
			Party::PlusGold(2000)
			Talk("당신은 금화 2000개를 발견했다.")
		halt
	if (On(90, 41))
		if (Not(Flag::IsSet("BANK_CHEST_2")))
			Flag::Set("BANK_CHEST_2")
			Party::PlusFood(100)
			Talk("당신은 100개의 식량을 발견했다.")
		halt
	if (On(90, 42))
		if (Not(Flag::IsSet("BANK_CHEST_3")))
			Flag::Set("BANK_CHEST_3")
			Party::PlusGold(1000)
			Talk("당신은 금화 1000개를 발견했다.")
		halt
	if (On(90, 43))
		if (Not(Flag::IsSet("BANK_CHEST_4")))
			Flag::Set("BANK_CHEST_4")
			Party::PlusGold(2500)
			Talk("당신은 금화 2500개를 발견했다.")
		halt
	if (On(90, 44))
		if (Not(Flag::IsSet("BANK_CHEST_5")))
			Flag::Set("BANK_CHEST_5")
			Party::PlusGold(5000)
			Talk("당신은 금화 5000개를 발견했다.")
		halt
	if (On(82, 52))
		if (Not(Flag::IsSet("BANK_CHEST_6")))
			Flag::Set("BANK_CHEST_6")
			Party::PlusGold(5000)
			Talk("당신은 금화 5000개를 발견했다.")
		halt
	if (On(84, 52))
		if (Not(Flag::IsSet("BANK_CHEST_7")))
			Flag::Set("BANK_CHEST_7")
			Party::PlusGold(5000)
			Talk("당신은 금화 5000개를 발견했다.")
		halt
	if (On(89, 52))
		if (Not(Flag::IsSet("BANK_CHEST_8")))
			Flag::Set("BANK_CHEST_8")
			Party::PlusGold(5000)
			Talk("당신은 금화 5000개를 발견했다.")
		halt
	if (On(91, 52))
		if (Not(Flag::IsSet("BANK_CHEST_9")))
			Flag::Set("BANK_CHEST_9")
			Party::PlusGold(5000)
			Talk("당신은 금화 5000개를 발견했다.")
