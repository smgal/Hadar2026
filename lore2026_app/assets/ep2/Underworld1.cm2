####### 제2부 지하 세계 1 (E2_Underworld1) — 100×100 필드 ########
# 근거: 2nd/05 §5.2(월식과 지하 세계 원정) · 2nd/06 §6.2 · §6.10 · 2nd/07 §7.2 · 2nd/08 §8.2 · 2nd/09 §9.4 · 2nd/10 §8 ·
#       2nd/12 부록 B · 공략집 Walkthrough/2nd/src/maps/Underworld1.md · 원작 칸 번호(maps.json)
# 필드형 · 무작위 조우 없음. 밟는 칸(20): 귀환 지점 (51,51)·(14,24), 제작자 (69,38)·(16,10)·(72,7), 보물 셋, 길목 전투 넷.
# 숨은 칸(0): 순간 이동 (23,35)·(8,74). 입구 칸: 빛의 지붕 (66,78)·빛의 사원 (89,94)·필멸의 생존 (33,49)·베리알 (36,16)·몰록 (93,6).
# 1차의 땅과 2차의 땅은 이어지지 않는다(6.10).

include("common/const.cm2")
variable(stage)
variable(py)

####### 맵에 들어왔다 ########

if (Equal(ScriptMode(), FLAG_MAP))
	Music::Play("ground")
	Encounter::Clear()
	Encounter::Enable(0)
	stage.assign(Variable::Get("LORD_STAGE"))
	if (Or(Equal(stage, 9), Equal(stage, 12)))
		Flag::Set("TRIP_ARRIVED")
	# 필멸의 생존에서 두 번째로 나온 뒤부터 입구 앞에서 숨은 길로 걸어 나갈 수 있다 (부록 B.3)
	if (Flag::IsSet("MORTAL_LEFT_TWICE"))
		Map::ChangeTileArea(33, 51, 33, 67, 0)

####### 입구 ########

if (Equal(ScriptMode(), FLAG_ENTER))
	if (On(66, 78))
		Ask("빛의 지붕에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E2_Dome", 25, 93)
		halt
	if (On(89, 94))
		Ask("빛의 사원에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E2_LightTemple", 25, 7)
		halt
	if (On(33, 49))
		Ask("필멸의 생존에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E2_Mortal", 25, 44)
		halt
	# ---- 베리알의 동굴 (36,16) — 처치한 뒤에는 입구가 막혀 있다. 그 전에는 들어갈 때마다 「반짝이는 눈」 ----
	if (On(36, 16))
		if (Flag::IsSet("TRIP_BELIAL"))
			Talk("베리알의 동굴 입구는 무너져 막혀 있다.")
			halt
		Talk("일행이 동굴 입구에 다가서자 무언가 반짝이는 눈 같은 것이 보였다.")
		Battle::Init()
		Battle::RegisterEnemy(32, 8)
		Battle::Start(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE))
		if (Equal(Battle::Result(), BATTLERESULT_WIN))
			LoadScript("E2_Belial", 25, 44)
		halt
	if (On(93, 6))
		Ask("몰록의 동굴에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E2_Moloch", 10, 44)
		halt

####### 밟는 칸 ########

if (Equal(ScriptMode(), FLAG_EVENT))
	stage.assign(Variable::Get("LORD_STAGE"))
	py.assign(Party::PosY())

	# ---- 귀환 — 1차 (51,51) · 2차 (14,24) ----
	if (Or(On(51, 51), On(14, 24)))
		if (And(On(51, 51), And(Equal(stage, 9), And(Flag::IsSet("TRIP_PAPYRUS"), And(Flag::IsSet("TRIP_TEMPLE"), Flag::IsSet("TRIP_DIARY"))))))
			Talk("당신은 이곳에서 할 일을 모두 끝냈다.")
			Talk("일행은 마법의 힘을 합쳐 다시 지상으로 공간 이동을 시작했다.")
			Talk("@F렐 그라브 .. 바스 포르 ..@@")
			Talk("일행은 다시 메너스로 돌아왔고 지하 세계로의 입구는 다시 봉쇄되었다.")
			Flag::Reset("TRIP_ARRIVED")
			Flag::Reset("TRIP_PAPYRUS")
			Flag::Reset("TRIP_TEMPLE")
			Flag::Reset("TRIP_DIARY")
			Variable::Set("LORD_STAGE", 10)
			PressAnyKey()
			LoadScript("E2_Menace", 26, 10)
		if (And(On(14, 24), And(Equal(stage, 12), And(Flag::IsSet("TRIP_BELIAL"), Flag::IsSet("TRIP_MOLOCH")))))
			Talk("당신은 이곳에서 할 일을 모두 끝냈다.")
			Talk("일행은 마법의 힘을 합쳐 다시 지상으로 공간 이동을 시작했다.")
			Talk("@F렐 그라브 .. 바스 포르 ..@@")
			Talk("일행은 다시 메너스로 돌아왔고 지하 세계로의 입구는 다시 봉쇄되었다.")
			Flag::Reset("TRIP_ARRIVED")
			Flag::Reset("TRIP_BELIAL")
			Flag::Reset("TRIP_MOLOCH")
			Variable::Set("LORD_STAGE", 13)
			PressAnyKey()
			LoadScript("E2_Menace", 13, 10)
		halt

	# ---- 제작자의 귀환 서비스 (69,38)·(16,10)·(72,7) — 로어성 근처로 ----
	if (Or(On(69, 38), Or(On(16, 10), On(72, 7))))
		Say("안영기", "여어, 오래간만이군. 나는 이 게임의 제작자인 안영기라네. 저번에도 많이 만났었지. 혹시 당신이 이곳에서 더 이상 게임 진행이 안 된다면 지금 나에게 도움을 청하게. 어떤가?")
		Select::Init()
		Select::Add("어떻게 하겠습니까?")
		Select::Add("정말 그렇습니다")
		Select::Add("아니오. 내 힘으로도 가능합니다.")
		Select::Run()
		if (Equal(Select::Result(), 1))
			Talk("당신은 로어성 근처로 공간 이동되었다.")
			LoadScript("E2_Lore", 20, 12)
		if (Equal(Select::Result(), 2))
			Say("안영기", "자네 마음에 들었네. 그럼 잘해 보게나.")
		halt

	# ---- 보물 ----
	if (On(44, 45))
		if (Not(Flag::IsSet("UW1_ITEM_1")))
			Flag::Set("UW1_ITEM_1")
			Item::Give("item.awakening_herb", 4)
			Talk("일행은 여기서 의식의 약초를 발견하였다.")
			Notice("의식의 약초 + 4")
		halt
	if (On(54, 53))
		if (Not(Flag::IsSet("UW1_ITEM_2")))
			Flag::Set("UW1_ITEM_2")
			Item::Give("item.hp_potion", 5)
			Talk("일행은 여기서 체력 회복약을 발견하였다.")
			Notice("체력 회복약 + 5")
		halt
	if (On(51, 50))
		if (Not(Flag::IsSet("UW1_ITEM_3")))
			Flag::Set("UW1_ITEM_3")
			Item::Give("item.warp_orb", 2)
			Talk("일행은 여기서 이동 구슬을 발견하였다.")
			Notice("이동 구슬 + 2")
		halt

	# ---- 순간 이동 칸 — 이번 원정에서 베리알을 처치한 뒤 ----
	if (On(23, 35))
		if (Flag::IsSet("TRIP_BELIAL"))
			Talk("일행은 공간 이동되었다.")
			Party::Warp(16, 95)
		halt
	if (On(8, 74))
		if (Flag::IsSet("TRIP_BELIAL"))
			Talk("일행은 공간 이동되었다.")
			Party::Warp(71, 8)
		halt

	# ---- 도깨비불 (73,10) — 이길 때까지, 일행 선공 ----
	if (On(73, 10))
		if (Flag::IsSet("WISP"))
			halt
		Talk("일행은 무언가 희미한 불빛이 떠다니는 것을 보았고 그것이 도깨비불이라는 것을 알아차리고 선제공격을 시작했다.")
		Battle::Init()
		Battle::RegisterVariant("wisp_eighth", 8)
		Battle::Start(BATTLE_NO_PRELUDE)
		if (Equal(Battle::Result(), BATTLERESULT_WIN))
			Flag::Set("WISP")
		halt

	# ---- 바위 인간 (76,13) — 돈을 모두 주면 지나간다. 싸우면 세 전투가 이어진다 ----
	if (On(76, 13))
		if (Flag::IsSet("BANDITS"))
			halt
		Talk("일행이 길을 지나려 하자 갑자기 바위 인간들이 길을 가로막았다.")
		Say("바위 인간", "잠깐!! 이 길을 그냥 지나가려 하느냐. 목숨이 아깝다면 있는 돈 모두를 내어놓아라. 그러면 목숨만은 살려 주겠다.")
		Select::Init()
		Select::Add("어떻게 하겠습니까?")
		Select::Add("그들과 전투를 벌인다")
		Select::Add("그들에게 모든 돈을 준다")
		Select::Run()
		if (Not(Equal(Select::Result(), 1)))
			Party::PlusGold(Sub(0, Party::Gold()))
			halt
		# 앞의 두 전투는 도망쳐도 다음 전투로 이어진다. 첫 전투만 일행 선공
		Battle::Init()
		Battle::RegisterEnemy(24, 5)
		Battle::Start(BATTLE_NO_PRELUDE)
		Say("사이클롭스", "누가 우리 애들을 건드리느냐! 이 사이클롭스님의 곤봉 맛을 보아라!!")
		Battle::Init()
		Battle::RegisterEnemy(47, 6)
		Battle::Start(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE))
		Say("죽음의 기사", "나는 이곳의 대장인 죽음의 기사님이시다. 더 이상의 희생이 나기 전에 나의 손에서 끝을 맺어야겠군. 자 그럼 받아랏!!!!")
		Battle::Init()
		Battle::RegisterEnemy(47, 3)
		Battle::RegisterEnemy(59, 2)
		Battle::RegisterEnemy(63, 1)
		Battle::Start(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE))
		if (Not(Equal(Battle::Result(), BATTLERESULT_WIN)))
			Party::Warp(76, 12)
			halt
		Flag::Set("BANDITS")
		Talk("일행은 죽음의 기사를 물리쳤다. 하지만 죽음의 기사는 완전히 죽지 않고 우리에게 말을 걸었다.")
		Say("죽음의 기사", "으윽~~~ 나는 여태껏 여기서 산적 생활을 해 왔지만 당신들처럼 강한 상대는 보지 못했소. 혹시 내가 당신들 일행의 끄트머리에 따라다니며 한 수 배워도 되겠소?")
		Select::Init()
		Select::Add("어떻게 하겠습니까?")
		Select::Add("좋소, 당신이 원한다면")
		Select::Add("아니 되오, 산적을 일행으로 둘 수는 없소")
		Select::Run()
		if (Equal(Select::Result(), 1))
			Party::SetAssistant("death_knight")
		halt

	# ---- 사신 (87,9) — 이길 때까지, 일행 선공. 도망치면 북쪽으로 한 칸 ----
	if (On(87, 9))
		if (Flag::IsSet("DEATH_GODS"))
			halt
		Say("사신", "나는 몰록님의 특명을 받고 너희들을 제거하기 위해 나온 죽음의 신, 즉 사신이다. 나의 친구들을 부르도록 하지. 그럼.")
		Say("사신의 친구들", "우리들은 몰록님을 위해서만 싸운다. 당신들과는 사적인 감정은 없지만 이것도 몰록님의 명령이니 우리도 어쩔 수 없다. 그럼 지옥에서나 우리 보도록 하지.")
		Battle::Init()
		Battle::RegisterEnemy(58, 3)
		Battle::RegisterEnemy(60, 2)
		Battle::Start(BATTLE_NO_PRELUDE)
		if (Equal(Battle::Result(), BATTLERESULT_WIN))
			Flag::Set("DEATH_GODS")
		else
			Party::Warp(87, 8)
		halt

	# ---- 남십자성의 전사 (94,9) — 협상. 거절하면 일행 선공 (1회) ----
	if (On(94, 9))
		if (Flag::IsSet("SOUTHERN_CROSS"))
			halt
		Say("남십자성의 전사", "놀라운 돌파력이군, {주인공}.")
		Say("남십자성의 전사", "나는 과거에 네가 네크로만서를 물리쳤을 때부터 쭉 봐 왔었네. 사실 정말 존경했었는데 지금은 서로 적이 되었군. 아참! 나의 소개를 안 했군. 나는 남십자성의 전사라고 하네. 원래는 로어 특공대의 부대장이었는데 지금은 나의 야망을 위해 몰록의 부하로 있지. 지금은 몰록의 심복이 되어 그로부터 환상 마법을 배우고 있다네. 바른대로 말하면 몰록을 이용하여 나를 더 강하게 만들고 있네. 몇 달 전에 로어 특공대의 대장이었던 로어 헌터가 이곳으로 왔더군. 나는 그에게 들키지 않으려고 피해 다녀야 했네. 하지만 나는 느낄 수 있었지. 이제 그는 나의 상대가 안 된다는 것을 기를 통해 알 수가 있었다네. 그는 대장이라는 이유만으로 나의 야망을 짓누르려고 했네. 그는 충실한 로드안의 심복이었지만 나는 그런 사람이 아니었네. 나는 로드안이 지시하는 네크로만서 타도를 별로 달갑지 않게 받아들였네. 그래서 결국 로어 특공대 내에서 반기를 들게 되었고 나는 나를 따르는 소수의 사람들을 이끌고 신세계를 찾아 나의 야망을 펼치려 했지. 그리고 마지막으로 내가 다다른 곳은 바로 여기 지하 세계라네.")
		Say("남십자성의 전사", "당신의 일행에는 다행히도 로어 헌터가 없군. 즉, 내가 꼭 당신들과 싸워야 한다는 이유가 없는 셈이 되지. 내가 서로의 기를 측정해 보니 당신들이 약간 우세하군. 하지만 나도 역시 나의 일행들이 더 있으니 막상막하겠군. 여기서 우리 협상 하나 하도록 하지. 우리들 서로는 지상 세계의 사람이네. 나도 이렇게 동족끼리 싸우는 것은 원치 않네. 사실 나는 더 이상 몰록에게 배울 것이 없다네. 몰록과 정면으로 대결하면 나의 승리가 확실할 정도라네. 나는 몰록의 명령으로 여기 있지만 더 이상 그에게 명령을 받을 이유가 없다네.")
		Say("남십자성의 전사", "우리들은 서로의 길로 가는 것이 어떨까?")
		Say("남십자성의 전사", "그러면 서로가 편해지지. 나의 말에 무슨 계략이 있다든가 하는 것은 아니라네. 어떤가?")
		Select::Init()
		Select::Add("어떻게 하겠습니까?")
		Select::Add("그러면 그렇게 하지")
		Select::Add("당치 않은 소리, 분명 이건 계략이다")
		Select::Run()
		Flag::Set("SOUTHERN_CROSS")
		if (Equal(Select::Result(), 2))
			Battle::Init()
			Battle::RegisterEnemy(70, 1)
			Battle::RegisterEnemy(59, 7)
			Battle::Start(BATTLE_NO_PRELUDE)
		halt

# (원작 확인) 바위 인간에게 돈을 주면 기록을 남기지 않고 끝나서(party.gold := 0; exit) 다시 밟으면 또 요구한다 (DARKSPEC.PAS:835~854).
