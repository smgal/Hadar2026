####### 제2부 라스트디치성 (E2_LastDitch) — 75×75 마을 ########
# 근거: 2nd/05 §5.2(라스트디치 성주) · §5.3(동료 찾기) · 2nd/06 §6.5 · 2nd/07 §7.2(독심 합류) · 2nd/10 §5 · §11 ·
#       2nd/12 부록 B · 공략집 Walkthrough/2nd/src/maps/LastDitch.md · 원작 칸 번호(maps.json)
# 마을형 · 기본 바닥 45. 숨은 칸: 옛 피라미드 뜰의 (30,8~11)·(32,8~11), 그라운드 게이트 (50,9)·(50,10), 출구 줄 (37~40,70).
# 성주는 로드안 단계를 보지 않는다 — 게임 시작 직후라도 의뢰를 진행할 수 있다.
# 들어오면 (38,69), 나가면 로어 대륙 (77,57).

include("common/const.cm2")
variable(q)
variable(py)

####### 맵에 들어올 때 ########

if (Equal(ScriptMode(), FLAG_MAP))
	Music::Play("town")
	if (Flag::IsSet("JOINED_POLARIS"))
		Map::ChangeTile(41, 18, 45)
	# 지니어스 기 — 레굴루스를 만났고, 합류하지 않았고, 아직 이야기를 듣지 않았으면 (54,56)에 (부록 B.3)
	if (And(Flag::IsSet("REGULUS_MET"), And(Not(Flag::IsSet("JOINED_GENIUSKIE")), Not(Flag::IsSet("GENIUSKIE_TALKED")))))
		Map::ChangeTile(54, 56, 53)

####### 사람 ########

if (Equal(ScriptMode(), FLAG_TALK))

	# ---- 성주 (38,17) — 로어 헌터와 두 석판 ----
	if (On(38, 17))
		q.assign(Variable::Get("LASTDITCH_QUEST"))
		if (Equal(q, 0))
			Say("라스트디치 성주", "잘 왔소, {주인공}공.")
			Say("라스트디치 성주", "공만이 이 일을 해결할 수 있을 것 같아서 한 가지 부탁을 하겠소. 벌써 발견했는지는 모르겠지만 이 성의 남쪽에는 알 수 없는 피라미드가 땅속 깊은 곳으로부터 솟아올랐소. 그곳을 이미 로어 헌터가 지니어스 기란 용사와 같이 탐험을 했었소. 거기에서 로어 헌터는 지하 세계를 발견하고는 구사일생으로 살아서 돌아왔다오. 하지만 그는 지하 세계에 대한 더 자세한 정보를 얻기 위해 단신으로 다시 피라미드에 들어갔다오. 지금 그의 생사는 도저히 알 수가 없어서 공에게 그를 도와 달라고 부탁하는 것이오. 피라미드에는 괴물들이 많이 있으니 주의해야 할 것이오. 꼭 그를 찾아내시오.")
			Variable::Set("LASTDITCH_QUEST", 1)
			halt
		if (Equal(q, 1))
			Say("라스트디치 성주", "피라미드 속에서 소식이 끊어진 로어 헌터의 생사를 알아 주시오.")
			halt
		if (Equal(q, 2))
			Say("라스트디치 성주", "로어 헌터가 살아 있었다니 정말 다행이군요.")
			Say("라스트디치 성주", "공에게 이 일을 맡기기를 정말 잘 선택한 것 같소.")
			Party::GiveExp(50000)
			Party::PlusGold(10000)
			Notice("경험치 + 50000   황금 + 10000")
			Variable::Set("LASTDITCH_QUEST", 3)
			halt
		if (Equal(q, 3))
			if (Not(And(Flag::IsSet("TABLET_EVIDENCE"), Flag::IsSet("TABLET_CLUE"))))
				Say("라스트디치 성주", "이번에 공이 할 일은 피라미드 속의 두 동굴을 탐험하고 지하 세계에 대한 정보를 알아 오는 일이오.")
				Say("라스트디치 성주", "이번 일도 부탁하오.")
				halt
			Say("라스트디치 성주", "공이 피라미드 안의 두 동굴에서 발견한 것이 이 두 개의 석판이오? 유감스럽게도 나에게는 이 고대어를 해석할 만한 능력이 없소. 분명히 로드안이라면 해석할 수 있을 것이오.")
			Party::GiveExp(100000)
			Party::PlusGold(15000)
			Notice("경험치 + 100000   황금 + 15000")
			Variable::Set("LASTDITCH_QUEST", 5)
			if (Equal(Variable::Get("LORD_STAGE"), 5))
				Variable::Set("LORD_STAGE", 6)
			halt
		Say("라스트디치 성주", "이제 공이 이곳에서 할 일은 다 끝났소.")
		if (Equal(Variable::Get("LORD_STAGE"), 5))
			Variable::Set("LORD_STAGE", 6)
		halt

	# ---- 폴라리스 (41,18) ----
	if (On(41, 18))
		Say("폴라리스", "오래간만이군!! 이 폴라리스의 이름을 걸고 {주인공}, 자네를 환영하네.")
		Say("폴라리스", "이번에는 내가 참여할 만한 모험이 없나?")
		Say("폴라리스", "분명히 있는 것 같은데 안 그런가? 이번의 일에도 나를 참가시켜 주게.")
		Say("폴라리스", "꼭 부탁하네.")
		Select::Init()
		Select::Add("어떻게 하겠습니까?")
		Select::Add("원한다면 허락하지")
		Select::Add("자네는 이곳에서 더 할 일이 많다네")
		Select::Run()
		if (Equal(Select::Result(), 1))
			if (Not(Equal(Party::HasFreeSeat(), 1)))
				Say("폴라리스", "나도 당신의 일행에 참가하고 싶지만 벌써 사람이 모두 채워져 있군. 미안하게 됐네.")
				halt
			Party::Join("polaris")
			Flag::Set("JOINED_POLARIS")
			Map::ChangeTile(41, 18, 45)
			DisplayMap()
		halt

	# ---- 지니어스 기 (54,56) — 독심 상태로 말을 걸면 합류 제의 (2nd/07 §7.2) ----
	if (On(54, 56))
		if (Equal(Party::CheckIf(CHECKIF_MINDCONTROL), 1))
			Say("지니어스 기", "다시 생각해 보니 나도 자네의 일행에 참가해야 할 것 같네. 나는 얼마 전에 지하 세계에 다녀왔기 때문에 전투 감각이 아직 살아 있는 데다가 전사라는 계급 때문에 자네에게 많은 도움이 될 걸세.")
			Say("지니어스 기", "자네에게 한번 부탁하네.")
			Select::Init()
			Select::Add("어떻게 하겠습니까?")
			Select::Add("자네라면 큰 도움이 될 걸세")
			Select::Add("지금은 좀 곤란하군")
			Select::Run()
			if (Equal(Select::Result(), 1))
				if (Not(Equal(Party::HasFreeSeat(), 1)))
					Say("지니어스 기", "나도 당신의 일행에 참가하고 싶지만 벌써 사람이 모두 채워져 있군. 미안하게 됐네.")
					halt
				Party::Join("genius_kie")
				Flag::Set("JOINED_GENIUSKIE")
				Map::ChangeTile(54, 56, 44)
				DisplayMap()
			halt
		Say("지니어스 기", "용하게도 나를 찾아냈군. 내가 로어성에 남긴 메모 쪽지를 보았겠지. 그것에 관한 이야기인데 말이야... 나는 몇 개월 전에 로어 헌터와 이 성의 남쪽에 있는 피라미드에 들어갔었지. 우리가 그곳에서 본 것은 복잡한 미로와 함께 두 개의 동굴이었지. 그 두 개의 동굴은 모두 지하의 신세계와 이어져 있었고 그 지하 세계는 완전한 하나의 또 다른 세계를 이루고 있었지. 그곳은 빛의 지붕이라고 불리는 마을도 있었고 동굴도 몇 개가 있었다고 기억된다네. 하지만 우리가 갔을 때는 새로운 변화가 일어나고 있었네. 그곳은 네크로만서와는 다른 존재가 반란을 꾀하고 있었고 그와 그 일당들의 힘은 정말 대단하였지. 그의 힘에 의해 지하 세계의 피라미드가 튕겨져 나왔다는 사실을 알았을 때는 정말 놀랐다네. 도저히 우리들의 힘으로는 그들을 당할 수가 없어서 쫓겨 다니던 중 다시 피라미드를 통해 나오게 되었던 것이네.")
		Say("지니어스 기", "그 일당은 모두 4명의 보스로 구성되어 있었는데 모두 최강의 마법사들이었네. 우리가 흉성의 증거라는 동굴을 나올 때 그중의 우두머리인 메피스토펠레스가 공기 중의 수소를 이용한 핵융합 마법을 사용하여 동굴 입구를 폭파시켰다네. 정말 그 힘은 레드 안타레스의 마법을 능가하는 힘이었다네. 그 4명의 보스의 이름도 참고로 알아 두게나. 그 일당의 일인자가 방금 말한 메피스토펠레스라고 하고, 이인자가 아스모데우스이고, 그다음이 몰록이며, 마지막이 베리알이라고 하더군. 지금은 결국 그들을 모두 따돌렸지만 그들도 그들의 존재가 알려진 이상 가만히 있지 않을 걸세. 만약 자네가 지하 세계를 탐험하려 한다면 어서 빨리 가 보도록 하게. 분명 그들은 입구를 봉쇄하려 할 걸세. 아니면 벌써 입구를 막아 버렸는지도 모르겠지만. 지금 지하 세계에서 일어나는 변화는 분명히 알비레오의 예언과 관련이 있다네. 아마 자네가 해야 할 일도 거기와 관련된 것일 걸세.")
		Say("지니어스 기", "나는 이곳에서 너무 많이 머물렀다네.")
		Say("지니어스 기", "자네도 만났으니 나의 할 일은 다 끝났다네.")
		Say("지니어스 기", "조금만 있다가 나도 새로운 여행을 떠나야 하지. 그럼 다음에 보도록 하지.")
		# 이야기를 들은 뒤 라스트디치를 떠나면 다시 나타나지 않는다 — 이번 방문 동안은 남아 있다
		Flag::Set("GENIUSKIE_TALKED")
		halt

	# ---- 시설 ----
	if (Or(On(16, 24), Or(On(21, 21), On(24, 19))))
		Shop::Training()
		halt
	if (On(18, 19))
		Shop::ExpTraining()
		halt
	if (On(17, 56))
		Shop::Herb()
		halt
	if (Or(On(17, 58), On(17, 60)))
		Shop::Hospital()
		halt
	if (Or(On(59, 56), Or(On(59, 58), On(59, 60))))
		Shop::Weapon()
		halt
	if (Or(On(57, 17), On(54, 20)))
		Shop::Goods()
		halt
	if (Or(On(58, 22), On(59, 25)))
		Shop::Grocery()
		halt

	# ---- 기사들 ----
	if (On(37, 41))
		Say("기사", "제가 폴라리스님의 후임으로 이 성문을 지키고 있습니다.")
		halt
	if (On(40, 41))
		Say("기사", "아~~~ 당신이 바로 폴라리스님이 말씀하시던 바로 그 {주인공}님이시군요.")
		Say("기사", "폴라리스님께 말씀 많이 들었습니다.")
		halt
	if (On(36, 19))
		Say("기사", "이 성의 병원에는 희귀한 약초를 파는 곳이 있습니다. 체력이나 마법을 올려 주는 그런 약물이나 독을 해독하거나 심지어 죽은 사람마저도 살릴 수 있는 약초도 있더군요.")
		halt
	if (On(36, 21))
		Say("기사", "저는 직접 타임워커 알비레오님을 보았는데 같은 마법사로서 존경하지 않을 수 없더군요. 그분의 예언은 틀림없다고 확신할 수 있습니다.")
		halt
	if (On(41, 20))
		Say("기사", "내가 듣기로는 지하 세계를 발견하기 위해 알 수 없는 피라미드로 들어간 사람이 몇 명 있더군요.")
		halt
	if (On(41, 22))
		Say("기사", "저는 당신의 능력을 믿습니다. 꼭 이 세계를 구해 주십시오.")
		halt

	# ---- 주민 ----
	if (On(21, 61))
		Say("주민", "저는 이 성의 남쪽에 있는 피라미드에 들어갔다가 상처를 입어서 여기서 치료를 받고 있습니다. 그곳에는 몇 년 전에 없어진 줄로만 알고 있었던 괴물들이 득실거리더군요.")
		halt
	if (On(56, 59))
		Say("점성가", "저는 이곳의 점성가인데 근래 들어 달의 운행이 점점 이상해지고 있습니다. 분명 큰 재앙이 닥칠 증거 같습니다.")
		halt
	if (On(60, 42))
		Say("주민", "이 위의 상인들은 로어성의 상인과는 달리 마법 물품들을 판매하고 있더군요.")
		halt
	if (On(61, 46))
		Say("주민", "알비레오의 예언은 정말일까요? 지금 이 대륙에는 그의 예언서가 안 알려진 곳이 없습니다. 때문에 민심도 많이 동요되고 있습니다.")
		halt
	if (On(47, 36))
		Say("주민", "만약 당신이 돈은 많은데 경험치가 모자란다면 서쪽에 있는 군사 훈련소의 어떤 자에게 부탁하시오. 그는 금액만큼의 전투 방법을 가르쳐서 경험치를 올려 준다더군요.")
		halt

####### 푯말 ########

if (Equal(ScriptMode(), FLAG_SIGN))
	if (On(39, 68))
		Talk("여기는 라스트디치성입니다")
		Talk("여러분을 환영합니다")
		halt
	if (On(39, 8))
		Talk("옛 피라미드 입구")
		halt
	if (On(54, 9))
		Talk("그라운드 게이트 입구")
		halt

####### 입구 — 옛 피라미드 (37~40,6) — 폐쇄 ########

if (Equal(ScriptMode(), FLAG_ENTER))
	if (OnArea(37, 6, 40, 6))
		Talk("당신이 동굴 입구에 들어가려 할 때 어떤 글을 보았다.")
		Talk("여기는 한때 피라미드라고 불리는 악마의 동굴이었지만 지금은 폐쇄되어 아무도 들어갈 수가 없습니다.")

####### 밟는 칸 ########

if (Equal(ScriptMode(), FLAG_EVENT))
	# 옛 피라미드 뜰의 비밀 벽 — x=30·32 줄을 밟으면 같은 줄의 (31,y)가 바닥이 된다
	if (Or(OnArea(30, 8, 30, 11), OnArea(32, 8, 32, 11)))
		py.assign(Party::PosY())
		Map::ChangeTile(31, py, 45)
		DisplayMap()
		halt
	if (OnArea(50, 9, 50, 10))
		Talk("여기는 두 번째의 대륙으로 이동하는 게이트입니다. 하지만 당신은 그곳에서 하여야 할 임무가 없습니다. 다시 돌아가 주십시오.")
		WarpPrevPos()
		halt
	if (OnArea(37, 70, 40, 70))
		Ask("여기서 나가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E2_Lore", 77, 57)
		else
			WarpPrevPos()
