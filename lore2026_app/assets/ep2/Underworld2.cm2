####### 제2부 지하 세계 2 (E2_Underworld2) — 50×100 필드 (3차 원정) ########
# 근거: 2nd/05 §5.2(3차 원정) · 2nd/06 §6.2 · §6.11 · 2nd/07 §7.2(즉사 이벤트 · 마법 제한) · 2nd/08 §8.2 · 2nd/10 §9 ·
#       2nd/12 부록 B · 공략집 Walkthrough/2nd/src/maps/Underworld2.md · 원작 칸 번호(maps.json)
# 필드형 · 무작위 조우 없음 · 지형 변화·대지형 변화가 막힌다. 구역들은 게이트·순간 이동 칸·공간 이동·아스모데우스의 동굴로만 오간다.
# 밟는 칸(20): 게이트·순간 이동 칸·레버·용의 굴·비룡·기계 생명체·제작자. 입구 칸: 아스모데우스 남 (14,43)·북 (9,21), 요새 (27,9).
# 용의 굴·비룡 통로는 맵을 다시 불러오면 다시 막힌다(부록 B.3). 도착 (10,92).

include("common/const.cm2")
variable(m)
variable(who)
variable(n)

####### 맵에 들어왔다 ########

if (Equal(ScriptMode(), FLAG_MAP))
	Music::Play("ground")
	Encounter::Clear()
	Encounter::Enable(0)
	Map::SetHandicap(HANDICAP_TILECHANGING, 1)
	Map::SetHandicap(HANDICAP_BIGTILECHANGING, 1)
	if (Equal(Variable::Get("LORD_STAGE"), 15))
		Flag::Set("TRIP_ARRIVED")

####### 입구 ########

if (Equal(ScriptMode(), FLAG_ENTER))

	# ---- 아스모데우스의 동굴 남쪽 입구 (14,43) — 가디안 둘 + 어둠의 영혼 6, 이길 때까지 ----
	if (On(14, 43))
		if (Not(Flag::IsSet("ASMODEUS_GUARDIANS")))
			Say("가디안 라이트·레프트", "너희들이 이 동굴에 들어가겠다고?")
			Say("가디안 라이트·레프트", "우리들은 아스모데우스님의 경호를 맡고 있는 가디안 라이트와 가디안 레프트라고 한다. 소개는 이쯤에서 끝내도록 하고 바로 대결을 하도록 하지.")
			Battle::Init()
			Battle::RegisterEnemy(55, 3)
			Battle::RegisterEnemy(64, 1)
			Battle::RegisterEnemy(55, 3)
			Battle::RegisterEnemy(65, 1)
			Battle::Start(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE))
			if (Not(Equal(Battle::Result(), BATTLERESULT_WIN)))
				halt
			Flag::Set("ASMODEUS_GUARDIANS")
			# 가디안 레프트의 마법 독화살 — 살아 있는 대원 중 민첩성이 가장 낮은 한 명이 즉사 (부록 A #1·D11)
			Say("가디안 레프트", "우욱... 하지만 나는 죽더라도 한 사람은 지옥으로 보내 주겠다.")
			Talk("가디안 레프트는 죽기 직전에 일행의 뒤에서 거대한 마법 독화살을 쏘았다.")
			m.assign(999)
			who.assign(0)
			if (And(Equal(Player::CanAct(1), 1), Less(Player::GetAttribute(1, "agility"), m)))
				m.assign(Player::GetAttribute(1, "agility"))
				who.assign(1)
			if (And(Equal(Player::CanAct(2), 1), Less(Player::GetAttribute(2, "agility"), m)))
				m.assign(Player::GetAttribute(2, "agility"))
				who.assign(2)
			if (And(Equal(Player::CanAct(3), 1), Less(Player::GetAttribute(3, "agility"), m)))
				m.assign(Player::GetAttribute(3, "agility"))
				who.assign(3)
			if (And(Equal(Player::CanAct(4), 1), Less(Player::GetAttribute(4, "agility"), m)))
				m.assign(Player::GetAttribute(4, "agility"))
				who.assign(4)
			if (And(Equal(Player::CanAct(5), 1), Less(Player::GetAttribute(5, "agility"), m)))
				m.assign(Player::GetAttribute(5, "agility"))
				who.assign(5)
			if (And(Equal(Player::CanAct(6), 1), Less(Player::GetAttribute(6, "agility"), m)))
				m.assign(Player::GetAttribute(6, "agility"))
				who.assign(6)
			if (Greater(who, 0))
				Talk(JoinString("가디안 레프트의 마법 독화살은 일행 중 가장 민첩성이 낮은 ", JoinString(Player::GetName(who), "에게"), " 명중했다."))
				Talk(JoinString("그리고 ", Josa(Player::GetName(who), "은/는"), " 즉사했다."))
				Player::ChangeAttribute(who, "hp", 0)
				Player::ChangeAttribute(who, "dead", 1)
			PressAnyKey()
		LoadScript("E2_Asmodeus", 25, 44)
	if (On(9, 21))
		Ask("아스모데우스의 동굴에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E2_Asmodeus", 25, 7)
		halt
	if (On(27, 9))
		Ask("메피스토펠레스의 요새에 들어가기를 원합니까?")
		if (Equal(Select::Result(), 1))
			LoadScript("E2_Mephisto", 25, 44)
		halt

####### 밟는 칸 ########

if (Equal(ScriptMode(), FLAG_EVENT))

	# ---- 제작자 (13,94)·(13,29) ----
	if (Or(On(13, 94), On(13, 29)))
		Say("안영기", "다시 또 만났군, {주인공}.")
		Say("안영기", "당신도 알다시피 나는 이 게임의 제작자인 안영기라네. 혹시 난이도 조절이 잘못되어서 레벨을 더 키우고 싶다면 나에게 부탁하게. 다시 로어성으로 이동시켜 주겠네.")
		Select::Init()
		Select::Add("어떻게 하겠습니까?")
		Select::Add("정말 그렇습니다")
		Select::Add("아니오. 내 힘으로도 가능합니다.")
		Select::Run()
		if (Equal(Select::Result(), 1))
			Talk("당신은 로어성 근처로 공간 이동되었다.")
			LoadScript("E2_Lore", 20, 12)
		if (Equal(Select::Result(), 2))
			Say("안영기", "자네 마음에 들었네. 그럼 잘해 보게나.")
		halt

	# ---- 공간 이동 게이트 ----
	if (On(42, 76))
		Talk("일행은 다른 곳으로 이동되었다.")
		Party::Warp(13, 72)
		halt
	if (On(13, 71))
		Talk("일행은 다른 곳으로 이동되었다.")
		Party::Warp(42, 77)
		halt
	if (On(41, 54))
		Talk("일행은 다른 곳으로 이동되었다.")
		Party::Warp(13, 72)
		halt

	# ---- 순간 이동 칸 ----
	if (On(31, 90))
		Talk("일행은 공간 이동되었다.")
		Party::Warp(45, 92)
		halt
	if (On(30, 72))
		Talk("일행은 공간 이동되었다.")
		Party::Warp(44, 67)
		halt
	if (On(30, 74))
		Talk("일행은 공간 이동되었다.")
		Party::Warp(10, 62)
		halt
	if (On(31, 44))
		Talk("일행은 공간 이동되었다.")
		Party::Warp(15, 44)
		halt

	# ---- 레버 (41,56) — 맵 전체의 용암이 늪으로, (41,55)가 열린다 ----
	if (On(41, 56))
		Talk("일행이 앞에 있는 레버를 잡아당겼다.")
		Talk("순간 굉음이 대륙 전체를 진동하기 시작했고 당신 앞의 장애물이 지하로 가라앉아 버렸다.")
		Screen::Flash()
		Map::ReplaceTile(1, 1, 50, 100, 50, 49)
		Map::ChangeTile(41, 55, 41)
		DisplayMap()
		halt

	# ---- 용의 굴 (20,72) — 밟을 때마다 드래곤 8. 이기면 동쪽 통로 (21~29,72) ----
	if (On(20, 72))
		Talk("당신은 실수로 용의 굴을 보지 못하고 지나쳤다. 그 굴에는 성질이 사나운 용들이 있었고 곧 시비가 붙어 싸움이 시작되었다.")
		Battle::Init()
		Battle::RegisterEnemy(54, 8)
		Battle::Start(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE))
		if (Equal(Battle::Result(), BATTLERESULT_WIN))
			Talk("용의 동굴에는 동쪽으로 이어지는 통로가 있었다.")
			Map::ChangeTileArea(21, 72, 29, 72, 41)
			DisplayMap()
		else
			Party::Warp(19, 72)
		halt

	# ---- 비룡 (20,74) — 밟을 때마다 비룡 5. 이기면 (21~29,74) ----
	if (On(20, 74))
		Talk("일행이 막다른 곳으로 접어들자 하늘에서부터 비룡들이 공격해 오기 시작했다.")
		Battle::Init()
		Battle::RegisterEnemy(43, 5)
		Battle::Start(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE))
		if (Equal(Battle::Result(), BATTLERESULT_WIN))
			Talk("비룡들을 물리치자 조금 전에는 보지 못했던 통로가 있었다.")
			Map::ChangeTileArea(21, 74, 29, 74, 41)
			DisplayMap()
		else
			Party::Warp(19, 74)
		halt

	# ---- 기계 생명체 (36,46) — 메가 로보 6 + 기갑 독사, 이길 때까지. 이기면 (36,44)가 열린다 ----
	if (On(36, 46))
		if (Flag::IsSet("MACHINES"))
			Map::ChangeTile(36, 44, 41)
			DisplayMap()
			halt
		Say("기계 생명체", "슈잇~~ 슈잇~~ 전에도 우리 만난 적이 있지, {주인공}.")
		Say("기계 생명체", "그때는 네크로만서님을 위해 싸웠었는데 이제는 메피스토펠레스님을 따른다는 것이 조금 달라진 점이지. 너는 우리가 완전히 죽었다고 생각했겠지만 보시다시피 우리들은 기계 생명체라서 다시 조립을 하면 살릴 수가 있지. 또한 스스로를 더욱 강하게 개조할 수도 있지. 그러면 새로워진 나의 힘을 감상하시지.")
		Battle::Init()
		Battle::RegisterEnemy(66, 6)
		Battle::RegisterEnemy(71, 1)
		Battle::Start(Add(BATTLE_ENEMY_FIRST, BATTLE_NO_PRELUDE))
		if (Equal(Battle::Result(), BATTLERESULT_WIN))
			Flag::Set("MACHINES")
			Map::ChangeTile(36, 44, 41)
			DisplayMap()
		else
			Party::Warp(36, 47)
		halt
