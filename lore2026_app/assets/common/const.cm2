####### 스크립트 상수 (세 편 공통) ########
# 맵 스크립트는 맨 위에서 include("common/const.cm2") 로 읽는다.

# ScriptMode() — 스크립트가 불린 까닭
variable(FLAG_MAP)
variable(FLAG_TALK)
variable(FLAG_SIGN)
variable(FLAG_EVENT)
variable(FLAG_ENTER)
variable(FLAG_TIMER)
variable(FLAG_ITEM)
variable(FLAG_START)
variable(FLAG_PROPHECY)
variable(FLAG_OPENING)

FLAG_MAP.assign(0)
FLAG_TALK.assign(1)
FLAG_SIGN.assign(2)
FLAG_EVENT.assign(3)
FLAG_ENTER.assign(4)
FLAG_TIMER.assign(5)
FLAG_ITEM.assign(6)
FLAG_START.assign(7)
FLAG_PROPHECY.assign(8)
FLAG_OPENING.assign(9)

# Party::CheckIf() · Party::SetBuff()
variable(CHECKIF_MAGICTORCH)
variable(CHECKIF_LEVITATION)
variable(CHECKIF_WALKONWATER)
variable(CHECKIF_WALKONSWAMP)
variable(CHECKIF_MINDCONTROL)

CHECKIF_MAGICTORCH.assign(0)
CHECKIF_LEVITATION.assign(1)
CHECKIF_WALKONWATER.assign(2)
CHECKIF_WALKONSWAMP.assign(3)
CHECKIF_MINDCONTROL.assign(4)

# Battle::Result()
variable(BATTLERESULT_EVADE)
variable(BATTLERESULT_WIN)
variable(BATTLERESULT_LOSE)

BATTLERESULT_EVADE.assign(0)
BATTLERESULT_WIN.assign(1)
BATTLERESULT_LOSE.assign(2)

# Battle::Start() — 여럿이면 Add 로 더한다
variable(BATTLE_NORMAL)
variable(BATTLE_NO_ESCAPE)
variable(BATTLE_ENEMY_FIRST)
variable(BATTLE_NO_PRELUDE)
variable(BATTLE_LOSE_OK)
variable(BATTLE_REPEAT)
variable(BATTLE_RENEW)
variable(LETTER_STILL)
variable(LETTER_SCROLL)
variable(LETTER_LIGHTNING)
variable(LETTER_CREDITS)

BATTLE_NORMAL.assign(0)
BATTLE_NO_ESCAPE.assign(1)
BATTLE_ENEMY_FIRST.assign(2)
BATTLE_NO_PRELUDE.assign(4)
BATTLE_LOSE_OK.assign(8)
BATTLE_REPEAT.assign(16)
BATTLE_RENEW.assign(32)
# 편지 화면 (Letter::Show 의 둘째 값)
LETTER_STILL.assign(0)
LETTER_SCROLL.assign(1)
LETTER_LIGHTNING.assign(2)
LETTER_CREDITS.assign(3)

# Map::SetHandicap() — 이 맵에서 막히는 마법
variable(HANDICAP_TILECHANGING)
variable(HANDICAP_BIGTILECHANGING)
variable(HANDICAP_ETHEREAL)
variable(HANDICAP_TELEPORT)
variable(HANDICAP_EAGLEEYE)
variable(HANDICAP_SEETHROUGH)
variable(HANDICAP_CLAIRVOYANCE)

HANDICAP_TILECHANGING.assign(0)
HANDICAP_BIGTILECHANGING.assign(1)
HANDICAP_ETHEREAL.assign(2)
HANDICAP_TELEPORT.assign(3)
HANDICAP_EAGLEEYE.assign(4)
HANDICAP_SEETHROUGH.assign(5)
HANDICAP_CLAIRVOYANCE.assign(6)

# Party::Face() · Party::Faced()
variable(FACE_DOWN)
variable(FACE_UP)
variable(FACE_RIGHT)
variable(FACE_LEFT)

FACE_DOWN.assign(0)
FACE_UP.assign(1)
FACE_RIGHT.assign(2)
FACE_LEFT.assign(3)
