{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*",
  "folding": {
    "offSide": true,
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if\\s*\\(.*\\)|else)\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*else\\s*(#.*)?$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(if\\s*\\(.*\\)|else)\\s*(#.*)?$",
      "action": { "indent": "indent" }
    }
  ]
}
